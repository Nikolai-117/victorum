---
/**
 * Les Royaumes — un rayon du Codex.
 *
 * Chaque couronne occupe un écran entier : une scène dessinée à sa teinte, sa
 * bannière, sa devise et ses chiffres. On passe de l'une à l'autre à la
 * molette, comme on tourne les planches d'un armorial.
 *
 * Tout est vrai : les États, leurs capitales, leurs chiffres et leurs couleurs
 * viennent des données du monde ; la devise et le souverain de ce que Romain a
 * écrit dans la fiche de la nation. Rien n'est inventé — ce qui manque se dit
 * « à écrire » et renvoie à la fiche.
 */
import Base from '../../layouts/Base.astro';
import {
  monde, etats, provinces, burgs, provincesDeLEtat, villesDeLEtat,
  habitants, nombre, superficie, formeEtat, nomAffiche,
} from '../../lib/monde';
import { lirePolitique, cleEntite } from '../../lib/politique';

export const prerender = false;

const politique = await lirePolitique(Astro.locals);
const nations = politique.nations ?? {};

/** La scène d'un royaume : ce que ses terres donnent à voir. */
const SCENES: Record<string, string> = {
  levanzia: 'hills', varenhold: 'sea', ornebois: 'forest',
};

const couronnes = [...etats]
  .sort((a, b) => b.population - a.population)
  .map((e, i) => {
    const n = nations[cleEntite('etat', e.id)] ?? {};
    const capitale = burgs.find((b) => b.etatId === e.id && b.capitale);
    const souverain = [n.titreDirigeant, n.dirigeant].filter(Boolean).join(' ').trim();
    return {
      id: e.slug,
      nom: e.nom,
      url: `/etats/${e.slug}`,
      type: n.regime || formeEtat(e.forme),
      couleur: e.couleur,
      scene: SCENES[e.slug] ?? ['hills', 'sea', 'forest'][i % 3],
      flip: i % 2,
      devise: n.devise ?? '',
      capitale: capitale ? nomAffiche(capitale.nom) : '',
      souverain,
      pop: habitants(e.population),
      villes: e.nbBurgs,
      prov: provincesDeLEtat(e.id).length,
      aire: superficie(e.superficieKm2),
    };
  });

/**
 * Le second cercle : les provinces.
 *
 * La maquette y logeait des souverainetés mineures ; ce monde n'en compte
 * pas. Ce sont donc ses provinces qui prennent la place — le même cadre, mais
 * annoncé pour ce qu'il est : des divisions internes, non des États.
 */
const nomEtat = new Map(etats.map((e) => [e.id, e.nom]));
const teinteEtat = new Map(etats.map((e) => [e.id, e.couleur]));
const cercle = provinces
  .map((p) => ({
    nom: p.nom,
    url: `/provinces/${p.slug}`,
    etat: nomEtat.get(p.etatId) ?? '—',
    etatSlug: etats.find((e) => e.id === p.etatId)?.slug ?? '',
    couleur: teinteEtat.get(p.etatId) ?? '#8e8175',
    pop: habitants(p.population),
    aire: superficie(p.superficieKm2),
    villes: burgs.filter((b) => b.provinceId === p.id).length,
    part: Math.round((p.population / Math.max(1, etats.find((e) => e.id === p.etatId)?.population ?? 1)) * 100),
  }))
  .sort((a, b) => b.pop.localeCompare(a.pop, 'fr'));

const filtres = etats.map((e) => ({
  slug: e.slug,
  nom: e.nom,
  n: provinces.filter((p) => p.etatId === e.id).length,
}));

const total = etats.reduce((n, e) => n + e.population, 0);
const donnees = { couronnes, cercle, filtres };
---

<Base titre="Royaumes" description={`Les couronnes de ${monde.nom} : leurs terres, leurs chiffres, leurs devises.`}>
  <div class="royaumes">
    <div class="wrap">
      <header class="head">
        <div>
          <p class="crumb rise">
            <a href="/lore">Codex</a>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
            <b>Royaumes</b>
          </p>
          <h1 class="rise" style="animation-delay:.06s">Les couronnes de <em>{monde.nom}</em></h1>
          <p class="lede rise" style="animation-delay:.12s">
            {nombre(couronnes.length)} États souverains se partagent le continent,
            et {nombre(provinces.length)} provinces s'y découpent.
          </p>
        </div>
        <div class="figs rise" style="animation-delay:.16s">
          <span class="f"><span class="n">{nombre(couronnes.length)}</span><span class="l">couronnes</span></span>
          <span class="f"><span class="n">{nombre(provinces.length)}</span><span class="l">provinces</span></span>
          <span class="f"><span class="n">{nombre(burgs.length)}</span><span class="l">villes</span></span>
          <span class="f"><span class="n">{habitants(total)}</span><span class="l">âmes</span></span>
        </div>
      </header>

      <!-- ======================= LE SÉLECTEUR ======================= -->
      <div class="toolbar rise" style="animation-delay:.18s">
        <span class="tb-lbl">Parcourir les territoires</span>
        <div class="tb-acts">
          <button class="chip" id="allBtn" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/></svg>
            Voir tout
          </button>
          <a class="chip" href="#registre">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            Registre
          </a>
        </div>
      </div>

      <div class="selector rise" style="animation-delay:.2s">
        <div class="seldeck" id="seldeck"></div>
        <div class="selrail" id="selrail"></div>
        <div class="selhint" id="selhint"><span class="mouse"></span>Molette pour parcourir</div>
      </div>

      <!-- ======================= LE SECOND CERCLE ======================= -->
      <section id="registre">
        <div class="sec-head">
          <div><p class="kicker">Le second cercle</p><h2>Les provinces</h2></div>
        </div>
        <div class="mn-bar">
          <p class="mn-intro">
            Elles ne sont pas souveraines : chacune relève d'une couronne. Tout ce
            qui leur est propre — villes, maisons, coutumes — vit sur leur fiche.
          </p>
          <div class="segs" id="segs" role="group" aria-label="Filtrer par royaume"></div>
        </div>
        <div class="mns" id="mns"></div>
        <div class="mn-foot">
          <span id="mnCount"></span>
          <span>la part indique le poids de la province dans la population de sa couronne</span>
        </div>
      </section>
    </div>

    <div class="scrim" id="scrim"></div>
    <div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Tous les territoires">
      <div class="cap"></div>
      <div class="sh">
        <div>
          <p class="kick">Sélection rapide</p>
          <h3>Tous les territoires</h3>
          <p>Les couronnes du monde, d'un seul écran — clique pour y aller directement.</p>
        </div>
        <button class="xbtn" id="closeSheet" type="button" aria-label="Fermer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <div class="sbody"><div class="sgrid" id="sgrid"></div></div>
    </div>
  </div>

  <script type="application/json" id="donnees-royaumes" set:html={JSON.stringify(donnees)} />
</Base>

<style is:global>
  /* =====================================================================
     LES ROYAUMES — l'armorial des couronnes.
     ===================================================================== */
  .royaumes {
    --faint: #9a8b7b;
    --shadow: 0 10px 30px -20px rgba(38,32,28,.25);
    --shadow-lift: 0 20px 46px -26px rgba(38,32,28,.42);
    --glass: linear-gradient(152deg, rgba(255,253,247,.78), rgba(247,242,231,.44));
    --glass-strong: linear-gradient(152deg, rgba(255,254,250,.92), rgba(247,242,231,.70));
    --glass-hi: inset 0 1px 0 rgba(255,255,255,.85);
    --accent-soft: rgba(138,47,60,.10);
    --accent-line: linear-gradient(90deg, var(--accent), rgba(138,47,60,.32));
    --font-display: var(--display);
    --font-body: var(--texte-police);
    --font-mono: var(--chrome);
    --r-lg: 20px; --r-md: 14px; --r-sm: 10px;
    font-family: var(--font-body);
    line-height: 1.55;
  }
  .royaumes a { color: var(--accent); text-decoration: none; background-image: none; }
  .royaumes a:hover { text-decoration: underline; color: var(--accent); }
  .royaumes .wrap { position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 0 clamp(16px,3vw,36px); }

  /* ------------------------------------------------------------- en-tête */
  .royaumes .head { padding: clamp(22px,3vw,34px) 0 clamp(14px,2vw,20px); display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: end; }
  @media (max-width: 860px) { .royaumes .head { grid-template-columns: 1fr; } }
  .royaumes .crumb { display: flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }
  .royaumes .crumb a { color: var(--muted); }
  .royaumes .crumb a:hover { color: var(--accent); text-decoration: none; }
  .royaumes .crumb svg { width: 11px; height: 11px; opacity: .55; }
  .royaumes .crumb b { color: var(--accent); font-weight: 600; }
  .royaumes .head h1 { font-family: var(--font-display); font-weight: 600; font-size: clamp(2.1rem,4.6vw,3.1rem); line-height: 1; margin: 0; color: var(--ink); }
  .royaumes .head h1 em { font-style: italic; }
  .royaumes .head .lede { margin: 11px 0 0; color: var(--muted); max-width: 56ch; font-size: .96rem; }
  .royaumes .figs { display: flex; gap: 24px; flex-wrap: wrap; }
  .royaumes .figs .f { display: flex; flex-direction: column; }
  .royaumes .figs .n { font-family: var(--font-display); font-weight: 700; font-size: 1.7rem; line-height: 1; font-variant-numeric: tabular-nums; color: var(--ink); }
  .royaumes .figs .l { font-family: var(--font-mono); font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-top: 4px; }

  /* ----------------------------------------------------------- sélecteur */
  .royaumes .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin: 0 2px 12px; }
  .royaumes .tb-lbl { font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
  .royaumes .tb-acts { display: flex; gap: 8px; flex-wrap: wrap; }
  .royaumes .chip { display: inline-flex; align-items: center; gap: 7px; background-color: transparent; font-family: var(--font-body); font-size: .83rem; font-weight: 600; border: 1px solid var(--line); background-image: var(--glass); color: var(--muted); padding: 8px 14px; border-radius: 999px; cursor: pointer; box-shadow: var(--glass-hi); transition: color .2s, border-color .2s, transform .18s; }
  .royaumes .chip:hover { transform: translateY(-2px); color: var(--ink); text-decoration: none; }
  .royaumes .chip svg { width: 14px; height: 14px; }

  .royaumes .selector { position: relative; height: clamp(520px,72vh,700px); border-radius: var(--r-lg); overflow: hidden; border: 1px solid rgba(38,32,28,.22); box-shadow: 0 20px 40px -26px rgba(38,32,28,.5); background: #17110E; }
  .royaumes .seldeck { height: 100%; overflow-y: auto; scroll-snap-type: y mandatory; scroll-behavior: smooth; scrollbar-width: none; }
  .royaumes .seldeck::-webkit-scrollbar { display: none; }
  .royaumes .nat { position: relative; height: 100%; scroll-snap-align: start; scroll-snap-stop: always; overflow: hidden; display: flex; align-items: center; content-visibility: auto; }
  .royaumes .nat .scene { position: absolute; inset: 0; z-index: 0; transform: scale(1.06); transition: transform 1.1s cubic-bezier(.2,.7,.3,1); }
  .royaumes .nat.on .scene { transform: scale(1); }
  .royaumes .nat .scene svg { display: block; width: 100%; height: 100%; }
  .royaumes .nat .veil { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(100deg, rgba(18,14,12,.93) 0%, rgba(18,14,12,.64) 33%, rgba(18,14,12,.05) 62%, rgba(18,14,12,.22) 100%); }
  .royaumes .nat .grain { position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: .6; background-image: radial-gradient(rgba(255,246,232,.05) 1px, transparent 1px); background-size: 3px 3px; }
  .royaumes .nat .vign { position: absolute; inset: 0; z-index: 1; pointer-events: none; box-shadow: inset 0 -90px 110px -80px rgba(14,11,9,.85); }
  .royaumes .nat .body { position: relative; z-index: 2; width: 100%; padding: 0 clamp(26px,4.5vw,64px); color: var(--on-dark); }
  .royaumes .nat .in2 { max-width: 560px; opacity: 0; transform: translateY(22px); transition: opacity .65s cubic-bezier(.2,.7,.3,1), transform .65s cubic-bezier(.2,.7,.3,1); }
  .royaumes .nat.on .in2 { opacity: 1; transform: none; }
  .royaumes .nat .flagrow { display: flex; align-items: flex-end; gap: 18px; margin-bottom: 18px; }
  .royaumes .nat .flag { width: 156px; height: 104px; flex: none; border-radius: 3px; overflow: hidden; box-shadow: 0 16px 30px -12px rgba(0,0,0,.9), 0 0 0 1px rgba(255,255,255,.18); transform: rotate(-1.6deg); transition: transform .55s cubic-bezier(.34,1.4,.64,1); }
  .royaumes .nat.on .flag { transform: rotate(0); }
  .royaumes .nat .flag svg { display: block; width: 100%; height: 100%; }
  .royaumes .nat .tb2 { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: .61rem; font-weight: 600; letter-spacing: .15em; text-transform: uppercase; color: var(--kc); border: 1px solid color-mix(in srgb, var(--kc) 52%, transparent); background: color-mix(in srgb, var(--kc) 18%, transparent); padding: 5px 11px; border-radius: 999px; }
  .royaumes .nat .tb2 .d { width: 5px; height: 5px; border-radius: 50%; background: var(--kc); box-shadow: 0 0 7px var(--kc); }
  .royaumes .nat h3 { font-family: var(--font-display); font-weight: 600; font-size: clamp(2.6rem,5.8vw,4.6rem); line-height: .94; letter-spacing: -.02em; margin: 0; text-shadow: 0 6px 32px rgba(0,0,0,.65); color: var(--on-dark); }
  .royaumes .nat .motto { font-family: var(--font-display); font-style: italic; font-size: clamp(1rem,1.6vw,1.3rem); color: var(--on-dark-muted); margin: 11px 0 0; }
  .royaumes .nat .motto.aecrire { opacity: .62; }
  .royaumes .nat .st3 { display: flex; gap: clamp(18px,2.8vw,38px); flex-wrap: wrap; margin: 22px 0 0; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.18); }
  .royaumes .nat .st3 .n { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.3rem,2.1vw,1.8rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .royaumes .nat .st3 .l { font-family: var(--font-mono); font-size: .57rem; letter-spacing: .13em; text-transform: uppercase; color: var(--on-dark-muted); margin-top: 5px; display: block; }
  .royaumes .nat .acts2 { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  .royaumes .btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; background-color: transparent; font-family: var(--font-body); font-weight: 600; font-size: .9rem; padding: 12px 21px; border-radius: var(--r-sm); cursor: pointer; border: 1px solid transparent; transition: transform .2s, box-shadow .25s, border-color .2s, color .2s, background .2s; }
  .royaumes .btn:hover { text-decoration: none; }
  .royaumes .btn svg { width: 15px; height: 15px; }
  .royaumes .btn--onDark { background-color: rgba(26,20,17,.46); background-image: linear-gradient(152deg, rgba(255,255,255,.16), rgba(255,255,255,.05)); color: var(--on-dark); border-color: rgba(255,255,255,.34); box-shadow: inset 0 1px 0 rgba(255,255,255,.16); }
  .royaumes .btn--onDark:hover { transform: translateY(-2px); border-color: rgba(255,255,255,.66); color: var(--on-dark); }

  .royaumes .selrail { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); z-index: 6; display: flex; flex-direction: column; gap: 2px; align-items: flex-end; }
  .royaumes .selrail button { display: flex; align-items: center; gap: 9px; background: transparent; border: 0; cursor: pointer; padding: 4px 0; color: var(--on-dark-muted); font-family: var(--font-mono); font-size: .57rem; letter-spacing: .1em; text-transform: uppercase; }
  .royaumes .selrail .nm3 { opacity: 0; transform: translateX(6px); transition: opacity .25s, transform .25s; white-space: nowrap; text-shadow: 0 2px 8px rgba(0,0,0,.95); }
  .royaumes .selrail button:hover .nm3, .royaumes .selrail button[aria-current] .nm3 { opacity: 1; transform: none; color: var(--on-dark); }
  .royaumes .selrail .tk { width: 20px; height: 3px; border-radius: 3px; background: rgba(241,235,221,.32); transition: width .3s, background .3s; }
  .royaumes .selrail button:hover .tk { width: 30px; background: rgba(241,235,221,.68); }
  .royaumes .selrail button[aria-current] .tk { width: 38px; background: var(--rc); box-shadow: 0 0 10px var(--rc); }

  .royaumes .selhint { position: absolute; left: 50%; bottom: 15px; transform: translateX(-50%); z-index: 6; display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: .59rem; letter-spacing: .13em; text-transform: uppercase; color: var(--on-dark-muted); pointer-events: none; transition: opacity .3s; }
  .royaumes .selhint.gone { opacity: 0; }
  .royaumes .mouse { width: 13px; height: 21px; border-radius: 8px; border: 1.4px solid currentColor; position: relative; }
  .royaumes .mouse::after { content: ''; position: absolute; left: 50%; top: 4px; width: 2px; height: 4px; border-radius: 2px; background: currentColor; transform: translateX(-50%); animation: ry-wheel 1.6s ease-in-out infinite; }
  @keyframes ry-wheel { 0%,100% { transform: translate(-50%,0); opacity: 1; } 55% { transform: translate(-50%,6px); opacity: .25; } }

  /* -------------------------------------------------------- second cercle */
  .royaumes section { margin-top: clamp(40px,5.5vw,64px); }
  .royaumes .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .royaumes .sec-head .kicker { font-family: var(--font-mono); font-size: .7rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .royaumes .sec-head h2 { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.6rem,3vw,2.2rem); line-height: 1.05; margin: 0; color: var(--ink); }
  .royaumes .mn-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .royaumes .mn-intro { margin: 0; color: var(--muted); font-size: .92rem; max-width: 60ch; }
  .royaumes .segs { display: flex; padding: 4px; gap: 3px; border-radius: 999px; border: 1px solid var(--line); background-image: var(--glass); box-shadow: var(--glass-hi); flex-wrap: wrap; }
  .royaumes .segs button { border: 0; background: transparent; font-family: var(--font-body); font-size: .81rem; font-weight: 600; color: var(--muted); padding: 7px 14px; border-radius: 999px; cursor: pointer; transition: background .2s, color .2s; }
  .royaumes .segs button[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); }
  .royaumes .segs .c { font-family: var(--font-mono); font-size: .64rem; opacity: .7; margin-left: 5px; }

  .royaumes .mns { display: grid; grid-template-columns: repeat(4,1fr); gap: 13px; }
  @media (max-width: 1100px) { .royaumes .mns { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 620px) { .royaumes .mns { grid-template-columns: 1fr; } }
  .royaumes .mn { position: relative; display: flex; flex-direction: column; padding: 17px 18px 16px; border: 1px solid var(--line); border-radius: var(--r-md); background-image: var(--glass); background-color: var(--surface); box-shadow: var(--shadow), var(--glass-hi); cursor: pointer; overflow: hidden; color: inherit; content-visibility: auto; transition: transform .26s cubic-bezier(.34,1.4,.64,1), box-shadow .26s, border-color .22s; }
  .royaumes .mn:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift), var(--glass-hi); border-color: color-mix(in srgb, var(--kc) 46%, var(--line)); text-decoration: none; }
  .royaumes .mn::after { content: ''; position: absolute; right: -30%; top: -72%; width: 62%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--kc) 20%, transparent), transparent 70%); pointer-events: none; transition: transform .4s; }
  .royaumes .mn:hover::after { transform: scale(1.3); }
  .royaumes .mn .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .royaumes .mn .fl { width: 52px; height: 35px; flex: none; border-radius: 3px; overflow: hidden; box-shadow: 0 5px 12px -5px rgba(0,0,0,.55), 0 0 0 1px rgba(38,32,28,.16); }
  .royaumes .mn .fl svg { display: block; width: 100%; height: 100%; }
  .royaumes .mn .tp { font-family: var(--font-mono); font-size: .55rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--kc); border: 1px solid color-mix(in srgb, var(--kc) 30%, transparent); background: color-mix(in srgb, var(--kc) 11%, transparent); padding: 3px 8px; border-radius: 999px; white-space: nowrap; }
  .royaumes .mn h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.22rem; line-height: 1.12; margin: 13px 0 0; color: var(--ink); }
  .royaumes .mn .chif { display: flex; gap: 16px; margin-top: 11px; }
  .royaumes .mn .chif .n { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; line-height: 1; font-variant-numeric: tabular-nums; color: var(--ink); }
  .royaumes .mn .chif .l { font-family: var(--font-mono); font-size: .55rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-top: 4px; display: block; }
  .royaumes .mn .stat { display: flex; align-items: flex-start; gap: 8px; margin-top: auto; padding-top: 14px; font-size: .79rem; line-height: 1.4; color: var(--muted); }
  .royaumes .mn .stat .pt { width: 7px; height: 7px; border-radius: 50%; flex: none; margin-top: 5px; background: var(--kc); }
  .royaumes .mn .pgw { margin-top: 12px; display: flex; align-items: center; gap: 9px; }
  .royaumes .mn .pgw .pc { font-family: var(--font-mono); font-size: .62rem; color: var(--muted); width: 30px; text-align: right; }
  .royaumes .bar { height: 5px; border-radius: 5px; background: color-mix(in srgb, var(--muted) 20%, transparent); overflow: hidden; flex: 1; }
  .royaumes .bar i { display: block; height: 100%; border-radius: 5px; background-image: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 52%, white)); transition: width .6s cubic-bezier(.2,.7,.3,1); }
  .royaumes .mn-foot { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-top: 16px; font-family: var(--font-mono); font-size: .68rem; color: var(--muted); }
  .royaumes .mn-foot b { color: var(--accent); }

  /* ------------------------------------------------------------ surcouche */
  .royaumes .scrim { position: fixed; inset: 0; z-index: 60; background: rgba(24,18,15,.62); backdrop-filter: blur(10px); opacity: 0; pointer-events: none; transition: opacity .28s; }
  .royaumes .scrim.on { opacity: 1; pointer-events: auto; }
  .royaumes .sheet { position: fixed; z-index: 61; left: 50%; top: 50%; transform: translate(-50%,-50%) scale(.94); width: min(1120px,94vw); max-height: 88vh; display: flex; flex-direction: column; background-image: var(--glass-strong); background-color: var(--surface); backdrop-filter: blur(26px) saturate(150%); border: 1px solid rgba(255,255,255,.72); border-radius: 22px; box-shadow: 0 44px 90px -34px rgba(30,20,14,.75); opacity: 0; pointer-events: none; transition: opacity .28s, transform .34s cubic-bezier(.34,1.5,.64,1); overflow: hidden; }
  .royaumes .sheet.on { opacity: 1; transform: translate(-50%,-50%) scale(1); pointer-events: auto; }
  .royaumes .sheet .cap { height: 4px; background-image: var(--accent-line); }
  .royaumes .sheet .sh { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 20px 24px 14px; border-bottom: 1px solid var(--line); }
  .royaumes .sheet .sh .kick { font-family: var(--font-mono); font-size: .66rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); margin: 0 0 6px; }
  .royaumes .sheet .sh h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.75rem; line-height: 1; margin: 0; color: var(--ink); }
  .royaumes .sheet .sh p { margin: 6px 0 0; color: var(--muted); font-size: .85rem; }
  .royaumes .xbtn { flex: none; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); color: var(--muted); cursor: pointer; display: grid; place-items: center; transition: background .2s, color .2s, transform .25s; }
  .royaumes .xbtn:hover { background: var(--accent); color: #fff; transform: rotate(90deg); }
  .royaumes .xbtn svg { width: 14px; height: 14px; }
  .royaumes .sheet .sbody { padding: 18px 24px 24px; overflow-y: auto; }
  .royaumes .sgrid { display: grid; grid-template-columns: repeat(auto-fill,minmax(232px,1fr)); gap: 11px; }
  .royaumes .stile { position: relative; overflow: hidden; text-align: left; border: 1px solid var(--line); border-radius: 15px; background: var(--surface); box-shadow: var(--shadow); cursor: pointer; padding: 0; color: var(--ink); transition: transform .24s cubic-bezier(.34,1.4,.64,1), box-shadow .25s, border-color .2s; }
  .royaumes .stile:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); border-color: color-mix(in srgb, var(--kc) 50%, var(--line)); text-decoration: none; }
  .royaumes .stile .th { display: block; position: relative; height: 106px; overflow: hidden; border-bottom: 1px solid var(--line); }
  .royaumes .stile .th svg { display: block; width: 100%; height: 100%; }
  .royaumes .stile .fl { display: block; position: absolute; left: 11px; bottom: 9px; width: 42px; height: 28px; border-radius: 2px; overflow: hidden; box-shadow: 0 6px 14px -6px rgba(0,0,0,.75), 0 0 0 1px rgba(255,255,255,.4); }
  .royaumes .stile .tb3 { display: block; padding: 12px 14px 14px; }
  .royaumes .stile .nm4 { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.12rem; line-height: 1.1; }
  .royaumes .stile .tp4 { display: block; font-family: var(--font-mono); font-size: .56rem; letter-spacing: .11em; text-transform: uppercase; color: var(--kc); margin-top: 4px; }
  .royaumes .stile .pop4 { display: block; font-family: var(--font-mono); font-size: .66rem; color: var(--muted); margin-top: 7px; }
  .royaumes .stile.cur { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft), var(--shadow); }

  .royaumes .rise { opacity: 0; transform: translateY(14px); animation: ry-rise .6s cubic-bezier(.2,.7,.3,1) forwards; }
  @keyframes ry-rise { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .royaumes .rise { opacity: 1; transform: none; animation: none; }
    .royaumes .seldeck { scroll-behavior: auto; }
    .royaumes .mouse::after { animation: none; }
  }
</style>

<script>
  const D = JSON.parse(document.getElementById('donnees-royaumes').textContent);
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  /* ============ les scènes : des silhouettes en couches, à la teinte du royaume ============ */
  const SCENES = {
    hills: [
      'M0 470C210 408 330 452 500 428 660 406 790 458 950 434 1110 410 1290 456 1600 424L1600 900 0 900Z',
      'M0 588C190 532 320 578 480 556 650 532 800 592 970 566 1140 540 1340 592 1600 560L1600 900 0 900Z',
      'M0 712C250 664 430 710 630 688 830 666 1010 724 1210 698 1380 676 1500 708 1600 692L1600 900 0 900Z',
    ],
    sea: [
      'M0 452C160 452 240 372 320 372 400 372 470 452 560 452L1600 452 1600 900 0 900Z',
      'M0 560L1600 560 1600 900 0 900Z',
      'M0 690C200 668 380 700 560 686 740 672 900 706 1080 692 1260 678 1420 704 1600 690L1600 900 0 900Z',
    ],
    forest: [
      'M0 500L1600 500 1600 900 0 900Z',
      'M0 640L1600 640 1600 900 0 900Z',
      'M0 760L1600 760 1600 900 0 900Z',
    ],
  };

  const arbre = (x, y, h, w) =>
    '<path d="M' + x + ' ' + y + ' L' + (x - w) + ' ' + y + ' L' + x + ' ' + (y - h) + ' L' + (x + w) + ' ' + y + 'Z"/>' +
    '<path d="M' + x + ' ' + (y - h * 0.34) + ' L' + (x - w * 0.78) + ' ' + (y - h * 0.34) + ' L' + x + ' ' + (y - h * 1.18) + ' L' + (x + w * 0.78) + ' ' + (y - h * 0.34) + 'Z"/>' +
    '<rect x="' + (x - w * 0.09) + '" y="' + y + '" width="' + (w * 0.18) + '" height="' + (h * 0.16) + '"/>';

  const nef = (x, y, s) =>
    '<path d="M' + (x - 30 * s) + ' ' + y + 'C' + (x - 24 * s) + ' ' + (y + 15 * s) + ' ' + (x + 24 * s) + ' ' + (y + 15 * s) + ' ' + (x + 30 * s) + ' ' + y + 'Z"/>' +
    '<path d="M' + x + ' ' + y + 'L' + x + ' ' + (y - 62 * s) + '" stroke-width="' + (3.4 * s) + '"/>' +
    '<path d="M' + x + ' ' + (y - 56 * s) + 'C' + (x - 21 * s) + ' ' + (y - 44 * s) + ' ' + (x - 23 * s) + ' ' + (y - 26 * s) + ' ' + x + ' ' + (y - 18 * s) + 'Z"/>' +
    '<path d="M' + x + ' ' + (y - 46 * s) + 'C' + (x + 25 * s) + ' ' + (y - 34 * s) + ' ' + (x + 27 * s) + ' ' + (y - 14 * s) + ' ' + x + ' ' + (y - 6 * s) + 'Z"/>';

  function detail(genre, ton) {
    let g = '';
    if (genre === 'hills') {
      g += '<g fill="' + ton + '">';
      g += '<rect x="980" y="392" width="26" height="176"/><rect x="1042" y="336" width="34" height="232"/>';
      g += '<rect x="1114" y="410" width="24" height="158"/><rect x="1166" y="352" width="36" height="216"/>';
      g += '<rect x="1236" y="424" width="22" height="144"/>';
      g += '<path d="M1042 336l17-42 17 42zM1166 352l18-46 18 46zM980 392l13-32 13 32zM1114 410l12-30 12 30z"/>';
      g += '<path d="M940 568h340v22H940z"/></g>';
      g += '<g fill="none" stroke="' + ton + '" stroke-width="5" stroke-opacity=".75">';
      g += '<path d="M900 574q210-84 420 0"/><path d="M846 580q264-128 528 0"/></g>';
    } else if (genre === 'sea') {
      g += '<g fill="' + ton + '" stroke="' + ton + '" stroke-width="4" stroke-linecap="round">' +
        nef(880, 516, 1.9) + nef(1180, 528, 1.35) + nef(1400, 508, 1) + '</g>';
      g += '<g fill="' + ton + '"><path d="M1470 452l22-190h30l22 190z"/><rect x="1474" y="240" width="66" height="30" rx="6"/>' +
        '<path d="M1470 452h100v26h-100z"/></g>';
      g += '<g stroke="' + ton + '" stroke-width="5" stroke-opacity=".5"><path d="M1474 254l-150-46M1474 268l-156 22"/></g>';
      g += '<g stroke="' + ton + '" stroke-width="4" stroke-opacity=".5" stroke-linecap="round" fill="none">' +
        '<path d="M820 612q22-8 44 0t44 0"/><path d="M1120 648q22-8 44 0t44 0"/>' +
        '<path d="M1352 614q20-7 40 0t40 0"/><path d="M900 686q24-8 48 0t48 0"/>' +
        '<path d="M1240 700q24-8 48 0t48 0"/></g>';
    } else {
      g += '<g fill="' + ton + '" fill-opacity=".92">';
      for (let i = 0; i < 10; i++) g += arbre(120 + i * 168, 648, 150 + ((i * 47) % 78), 52);
      g += '</g><g fill="' + ton + '">';
      for (let j = 0; j < 8; j++) g += arbre(60 + j * 228, 790, 224 + ((j * 61) % 96), 74);
      g += '</g>';
      g += '<g stroke="' + ton + '" stroke-width="7" stroke-opacity=".3" stroke-linecap="round">' +
        '<path d="M120 700h360M560 722h300M920 698h380M1340 726h240"/></g>';
    }
    return g;
  }

  const hx = (h) => { h = h.replace('#',''); if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
    return [parseInt(h.substr(0,2),16), parseInt(h.substr(2,2),16), parseInt(h.substr(4,2),16)]; };
  const melange = (a, b, t) => { const A = hx(a), B = hx(b);
    return '#' + [0,1,2].map((i) => ('0' + Math.round(A[i] + (B[i]-A[i])*t).toString(16)).slice(-2)).join(''); };

  function sceneSVG(d) {
    const col = d.couleur, NUIT = '#17110E';
    const cielHaut = melange(col, NUIT, .42), cielMed = melange(col, NUIT, .70), cielBas = melange(col, NUIT, .86);
    const loin = melange(col, NUIT, .52), median = melange(col, NUIT, .72), det = melange(col, NUIT, .83), pres = melange(col, NUIT, .93);
    const sx = d.flip ? 1268 : 1112;
    let s = '<svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">';
    s += '<defs><linearGradient id="ciel-' + d.id + '" x1="0" y1="0" x2="0" y2="1">' +
      '<stop offset="0" stop-color="' + cielHaut + '"/><stop offset="55%" stop-color="' + cielMed + '"/>' +
      '<stop offset="100%" stop-color="' + cielBas + '"/></linearGradient>' +
      '<radialGradient id="halo-' + d.id + '" cx="50%" cy="50%" r="50%">' +
      '<stop offset="0" stop-color="#FFF3DF" stop-opacity=".40"/><stop offset="1" stop-color="#FFF3DF" stop-opacity="0"/></radialGradient>' +
      '<linearGradient id="brume-' + d.id + '" x1="0" y1="0" x2="0" y2="1">' +
      '<stop offset="0" stop-color="' + melange(col,'#FFFFFF',.35) + '" stop-opacity="0"/>' +
      '<stop offset="45%" stop-color="' + melange(col,'#FFFFFF',.35) + '" stop-opacity=".20"/>' +
      '<stop offset="100%" stop-color="' + melange(col,'#FFFFFF',.35) + '" stop-opacity="0"/></linearGradient></defs>';
    s += '<rect width="1600" height="900" fill="url(#ciel-' + d.id + ')"/>';
    s += '<circle cx="' + sx + '" cy="252" r="300" fill="url(#halo-' + d.id + ')"/>';
    s += '<circle cx="' + sx + '" cy="252" r="62" fill="#FFF6E6" fill-opacity=".55"/>';
    s += '<g' + (d.flip ? ' transform="translate(1600,0) scale(-1,1)"' : '') + '>';
    s += '<path d="' + SCENES[d.scene][0] + '" fill="' + loin + '"/>';
    s += '<rect y="330" width="1600" height="320" fill="url(#brume-' + d.id + ')"/>';
    s += '<path d="' + SCENES[d.scene][1] + '" fill="' + median + '"/>';
    s += detail(d.scene, det);
    s += '<path d="' + SCENES[d.scene][2] + '" fill="' + pres + '"/>';
    return s + '</g></svg>';
  }

  /* ============ les bannières ============ */
  function drapeauSVG(d) {
    const col = d.couleur, creme = '#F1EBDD', sombre = '#241F1B';
    let s = '<svg viewBox="0 0 120 80" aria-hidden="true"><rect width="120" height="80" fill="' + col + '"/>';
    if (d.scene === 'hills') {           // pal chargé d'une couronne
      s += '<rect x="46" y="0" width="28" height="80" fill="' + creme + '" fill-opacity=".9"/>';
      s += '<path d="M48 46l4-16 8 8 8-8 4 16z" fill="' + col + '"/>';
    } else if (d.scene === 'sea') {      // fasce ondée et nef
      s += '<path d="M0 50q30 -12 60 0t60 0v30H0z" fill="' + sombre + '" fill-opacity=".78"/>';
      s += '<path d="M44 40q16 9 32 0l-6 8H50z" fill="' + creme + '"/><path d="M60 38V18" stroke="' + creme + '" stroke-width="3"/><path d="M60 20q13 7 0 15z" fill="' + creme + '"/>';
    } else {                              // chevron et arbre
      s += '<path d="M0 80L60 24l60 56z" fill="' + sombre + '" fill-opacity=".72"/>';
      s += '<path d="M60 30l-13 22h26zM60 44l-16 26h32z" fill="' + creme + '"/><rect x="57" y="66" width="6" height="12" fill="' + creme + '"/>';
    }
    s += '<rect width="120" height="80" fill="none" stroke="rgba(255,255,255,.28)" stroke-width="2"/>';
    return s + '</svg>';
  }

  /* ============ le sélecteur ============ */
  const deck = $('seldeck'), rail = $('selrail'), hint = $('selhint');

  D.couronnes.forEach((d) => {
    const el = document.createElement('article');
    el.className = 'nat';
    el.style.setProperty('--kc', d.couleur);
    el.dataset.id = d.id;
    const devise = d.devise
      ? '<p class="motto">« ' + esc(d.devise) + ' »</p>'
      : '<p class="motto aecrire">Devise à écrire — elle vit sur la fiche du royaume.</p>';
    const cour = [d.capitale && ('Capitale : ' + d.capitale), d.souverain && ('Souverain : ' + d.souverain)]
      .filter(Boolean).join('  ·  ');
    el.innerHTML =
      '<div class="scene">' + sceneSVG(d) + '</div>' +
      '<div class="veil"></div><div class="grain"></div><div class="vign"></div>' +
      '<div class="body"><div class="in2">' +
        '<div class="flagrow"><span class="flag">' + drapeauSVG(d) + '</span>' +
          '<span class="tb2"><span class="d"></span>' + esc(d.type) + '</span></div>' +
        '<h3>' + esc(d.nom) + '</h3>' +
        devise +
        (cour ? '<p class="motto" style="font-style:normal;font-size:.92rem;margin-top:6px">' + esc(cour) + '</p>' : '') +
        '<div class="st3">' +
          '<span><span class="n">' + esc(d.pop) + '</span><span class="l">habitants</span></span>' +
          '<span><span class="n">' + esc(String(d.villes)) + '</span><span class="l">villes</span></span>' +
          '<span><span class="n">' + esc(String(d.prov)) + '</span><span class="l">provinces</span></span>' +
          '<span><span class="n">' + esc(d.aire) + '</span><span class="l">superficie</span></span>' +
        '</div>' +
        '<div class="acts2"><a class="btn btn--onDark" href="' + esc(d.url) + '">Ouvrir la fiche' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>' +
      '</div></div>';
    deck.appendChild(el);

    const b = document.createElement('button');
    b.type = 'button';
    b.style.setProperty('--rc', d.couleur);
    b.innerHTML = '<span class="nm3">' + esc(d.nom) + '</span><span class="tk"></span>';
    b.addEventListener('click', () => el.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    rail.appendChild(b);
  });

  const cartes = [...deck.querySelectorAll('.nat')];
  const puces = [...rail.querySelectorAll('button')];
  // On retient la planche la PLUS visible, pas la dernière annoncée : plusieurs
  // entrées arrivent dans le même lot au chargement, et la dernière gagnait.
  const observateur = new IntersectionObserver((entrees) => {
    let meilleure = -1, part = 0;
    for (const e of entrees) {
      if (e.intersectionRatio > part) { part = e.intersectionRatio; meilleure = cartes.indexOf(e.target); }
    }
    if (meilleure < 0 || part < 0.55) return;
    cartes.forEach((c, j) => c.classList.toggle('on', j === meilleure));
    puces.forEach((p, j) => (j === meilleure ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')));
  }, { root: deck, threshold: [0.25, 0.55, 0.9] });
  cartes.forEach((c) => observateur.observe(c));
  if (cartes[0]) { cartes[0].classList.add('on'); puces[0]?.setAttribute('aria-current', 'true'); }
  deck.addEventListener('scroll', () => hint.classList.add('gone'), { once: true, passive: true });

  /* ============ tous les territoires ============ */
  const scrim = $('scrim'), sheet = $('sheet');
  const fermer = () => { scrim.classList.remove('on'); sheet.classList.remove('on'); };
  scrim.addEventListener('click', fermer);
  $('closeSheet').addEventListener('click', fermer);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fermer(); });
  $('allBtn').addEventListener('click', () => {
    const g = $('sgrid');
    g.innerHTML = '';
    D.couronnes.forEach((d, i) => {
      const a = document.createElement('a');
      a.className = 'stile' + (cartes[i]?.classList.contains('on') ? ' cur' : '');
      a.href = d.url; a.style.setProperty('--kc', d.couleur);
      a.innerHTML = '<span class="th">' + sceneSVG(d) + '<span class="fl">' + drapeauSVG(d) + '</span></span>' +
        '<span class="tb3"><span class="nm4">' + esc(d.nom) + '</span>' +
        '<span class="tp4">' + esc(d.type) + '</span>' +
        '<span class="pop4">' + esc(d.pop) + ' habitants · ' + d.villes + ' villes</span></span>';
      g.appendChild(a);
    });
    scrim.classList.add('on'); sheet.classList.add('on');
  });

  /* ============ le second cercle ============ */
  const segs = $('segs'), mns = $('mns'), compte = $('mnCount');
  let filtre = 'tout';
  const bouton = (cle, nom, n) => {
    const b = document.createElement('button');
    b.type = 'button'; b.dataset.f = cle;
    b.setAttribute('aria-pressed', String(cle === filtre));
    b.innerHTML = esc(nom) + '<span class="c">' + n + '</span>';
    b.addEventListener('click', () => { filtre = cle; rendre(); });
    return b;
  };
  segs.appendChild(bouton('tout', 'Toutes', D.cercle.length));
  for (const f of D.filtres) segs.appendChild(bouton(f.slug, f.nom, f.n));

  function rendre() {
    for (const b of segs.children) b.setAttribute('aria-pressed', String(b.dataset.f === filtre));
    const liste = D.cercle.filter((p) => filtre === 'tout' || p.etatSlug === filtre);
    mns.innerHTML = '';
    for (const p of liste) {
      const a = document.createElement('a');
      a.className = 'mn'; a.href = p.url; a.style.setProperty('--kc', p.couleur);
      a.innerHTML =
        '<span class="top"><span class="fl">' + drapeauSVG({ couleur: p.couleur, scene: 'hills' }) + '</span>' +
        '<span class="tp">' + esc(p.etat) + '</span></span>' +
        '<h3>' + esc(p.nom) + '</h3>' +
        '<span class="chif"><span><span class="n">' + esc(p.pop) + '</span><span class="l">habitants</span></span>' +
        '<span><span class="n">' + p.villes + '</span><span class="l">villes</span></span></span>' +
        '<span class="stat"><span class="pt"></span>' + esc(p.aire) + '</span>' +
        '<span class="pgw"><span class="bar"><i style="width:' + Math.min(100, p.part) + '%"></i></span>' +
        '<span class="pc">' + p.part + '%</span></span>';
      mns.appendChild(a);
    }
    compte.textContent = liste.length + (liste.length > 1 ? ' provinces affichées' : ' province affichée') +
      ' sur ' + D.cercle.length;
  }
  rendre();
</script>
