---
import Base from '../../layouts/Base.astro';
import { etats, provincesDeLEtat, habitants, nombre, superficie, formeEtat, lien } from '../../lib/monde';

const royaumes = [...etats].sort((a, b) => b.population - a.population);
---

<Base titre="Royaumes" description="Les états du monde, leurs provinces et leurs villes.">
  <div class="contenant">
    <header class="cartouche">
      <p class="etiquette">{royaumes.length} états recensés</p>
      <h1>Royaumes</h1>
    </header>

    <div class="pile" style="margin-top:2rem">
      {
        royaumes.map((e) => {
          const provinces = provincesDeLEtat(e.id);
          return (
            <a class="royaume-ligne" href={lien('etat', e.slug)}>
              {e.blason && <img class="blason" src={e.blason} alt="" width="92" height="92" loading="lazy" />}
              <div class="royaume-ligne__corps">
                <span class="etiquette">{formeEtat(e.forme)}</span>
                <h2>
                  <i class="pastille" style={`background:${e.couleur}`} />
                  {e.nomComplet}
                </h2>
                <p class="discret">
                  {nombre(e.nbBurgs)} villes · {nombre(provinces.length)} provinces ·
                  {' '}{habitants(e.population)} habitants · {superficie(e.superficieKm2)}
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</Base>

<style>
  .royaume-ligne {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    padding: 1.35rem 1.5rem;
    background: var(--encre-2);
    border: 1px solid var(--trait);
    border-radius: var(--rayon);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .royaume-ligne:hover {
    border-color: var(--trait-vif);
    background: var(--velin);
  }
  .royaume-ligne h2 {
    font-size: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.25rem 0 0.4rem;
  }
  .royaume-ligne p {
    margin: 0;
    font-size: 0.9375rem;
  }
  .royaume-ligne__corps {
    min-width: 0;
  }
</style>
