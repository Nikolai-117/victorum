---
import Base from '../../layouts/Base.astro';
import Faits from '../../components/Faits.astro';
import Corps from '../../components/Corps.astro';
import {
  etats, provincesDeLEtat, villesDeLEtat, cultureParId, burgParId, etatParId,
  habitants, nombre, superficie, annee, formeEtat, relation, unite, lien, nomAffiche,
} from '../../lib/monde';

export function getStaticPaths() {
  return etats.map((etat) => ({ params: { slug: etat.slug }, props: { etat } }));
}

const { etat } = Astro.props;
const provinces = provincesDeLEtat(etat.id);
const villes = villesDeLEtat(etat.id);
const capitale = etat.capitaleId ? burgParId.get(etat.capitaleId) : undefined;
const culture = etat.cultureId ? cultureParId.get(etat.cultureId) : undefined;
const armee = etat.regiments.reduce((n, r) => n + r.effectif, 0);
const campagnes = [...etat.campagnes].sort((a, b) => a.debut - b.debut);
---

<Base titre={etat.nomComplet}>
  <div class="contenant">
    <header class="cartouche entete-fiche">
      {etat.blason && <img class="blason" src={etat.blason} alt={`Blason de ${etat.nom}`} width="92" height="92" />}
      <div>
        <div class="cartouche__sur">
          <i class="pastille" style={`background:${etat.couleur}`}></i>
          <span class="etiquette">{formeEtat(etat.forme)}{etat.titre ? ` · ${etat.titre}` : ''}</span>
        </div>
        <h1>{etat.nomComplet}</h1>
      </div>
    </header>

    <div class="pile" style="margin-top:2rem">
      <Faits
        faits={[
          { cle: 'Capitale', valeur: capitale?.nom, href: capitale && lien('burg', capitale.slug) },
          { cle: 'Habitants', valeur: habitants(etat.population) },
          { cle: 'Dont urbains', valeur: habitants(etat.populationUrbaine) },
          { cle: 'Superficie', valeur: superficie(etat.superficieKm2) },
          { cle: 'Villes', valeur: nombre(etat.nbBurgs) },
          { cle: 'Provinces', valeur: nombre(provinces.length) },
          { cle: 'Culture dominante', valeur: culture?.nom, href: culture && lien('culture', culture.slug) },
          { cle: 'Sous les armes', valeur: armee ? habitants(armee) : null },
        ]}
      />

      <Corps section="etats" slug={etat.slug} />

      {
        provinces.length > 0 && (
          <section>
            <h2 class="etiquette">Provinces</h2>
            <div class="grille" style="margin-top:0.75rem">
              {provinces.map((p) => (
                <a class="carte" href={lien('province', p.slug)}>
                  <span class="carte__titre">
                    <i class="pastille" style={`background:${p.couleur}`} />
                    {p.nom}
                  </span>
                  <span class="carte__meta">
                    {p.titre} · {habitants(p.population)} hab.
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        villes.length > 0 && (
          <section>
            <h2 class="etiquette">Villes principales</h2>
            <div class="defilable" style="margin-top:0.75rem">
              <table class="tableau">
                <thead>
                  <tr>
                    <th>Ville</th>
                    <th>Statut</th>
                    <th class="num">Habitants</th>
                  </tr>
                </thead>
                <tbody>
                  {villes.slice(0, 20).map((b) => (
                    <tr>
                      <td><a href={lien('burg', b.slug)}>{nomAffiche(b.nom)}</a></td>
                      <td class="discret">{b.capitale ? 'Capitale' : b.categorie}{b.port ? ' · port' : ''}</td>
                      <td class="num">{nombre(b.population)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {villes.length > 20 && (
              <p class="discret" style="margin-top:0.75rem">
                <a href={`/villes?royaume=${etat.slug}`}>Voir les {nombre(villes.length)} villes du royaume</a>
              </p>
            )}
          </section>
        )
      }

      {
        campagnes.length > 0 && (
          <section>
            <h2 class="etiquette">Campagnes militaires</h2>
            <div class="defilable" style="margin-top:0.75rem">
              <table class="tableau">
                <thead>
                  <tr><th>Campagne</th><th>Période</th><th>Adversaire</th><th>Rôle</th></tr>
                </thead>
                <tbody>
                  {campagnes.map((c) => {
                    const menee = c.attaquantId === etat.id;
                    const adversaire = menee ? c.defenseur : c.attaquant;
                    const disparu = menee ? c.defenseurDisparu : c.attaquantDisparu;
                    const autre = etatParId.get(menee ? c.defenseurId : c.attaquantId);
                    return (
                      <tr>
                        <td>{c.nom}</td>
                        <td class="chiffre">{annee(c.debut)} – {annee(c.fin)}</td>
                        <td>
                          {autre ? (
                            <a href={lien('etat', autre.slug)}>{autre.nom}</a>
                          ) : (
                            <>
                              {adversaire ?? 'Adversaire inconnu'}
                              {disparu && <span class="discret"> · royaume disparu</span>}
                            </>
                          )}
                        </td>
                        <td class="discret">{menee ? 'Assaillant' : 'Défenseur'}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      {
        etat.regiments.length > 0 && (
          <section>
            <h2 class="etiquette">Ordre de bataille</h2>
            <div class="defilable" style="margin-top:0.75rem">
              <table class="tableau">
                <thead>
                  <tr><th>Régiment</th><th class="num">Effectif</th><th>Composition</th></tr>
                </thead>
                <tbody>
                  {etat.regiments.map((r) => (
                    <tr>
                      <td>{r.icone} {r.nom}</td>
                      <td class="num">{nombre(r.effectif)}</td>
                      <td class="discret">
                        {Object.entries(r.unites)
                          .sort((a, b) => b[1] - a[1])
                          .map(([u, n]) => `${unite(u)} ${nombre(n)}`)
                          .join(' · ')}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      {
        etat.diplomatie.length > 0 && (
          <section>
            <h2 class="etiquette">Relations</h2>
            <div class="grille" style="margin-top:0.75rem">
              {etat.diplomatie.map((d) => {
                const autre = etatParId.get(d.etatId);
                return autre ? (
                  <a class="carte" href={lien('etat', autre.slug)}>
                    <span class="carte__titre">{autre.nom}</span>
                    <span class="carte__meta">{relation(d.relation)}</span>
                  </a>
                ) : null;
              })}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Base>

<style>
  .entete-fiche {
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }
</style>
