---
import Fiche from '../../components/Fiche.astro';
import { burgs } from '../../lib/monde';
import { contexteDe } from '../../lib/contexte';

export function getStaticPaths() {
  return burgs.map((ville) => ({ params: { slug: ville.slug }, props: { ville } }));
}

const { ville } = Astro.props;
---

<Fiche contexte={contexteDe.burg(ville)} />
