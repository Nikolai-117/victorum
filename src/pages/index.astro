---
/**
 * L'accueil : l'atelier.
 *
 * Ce n'est pas une vitrine, c'est un poste de travail. On y voit d'un coup
 * d'œil où l'on en est — ce qui vient d'être écrit, ce qui reste blanc — et
 * on repart écrire depuis n'importe lequel de ces points.
 *
 * Tout ce qui s'affiche ici est VRAI : les compteurs viennent des données du
 * monde et du stockage, les dernières fiches sont celles réellement modifiées,
 * les pages à peupler sont celles qui n'ont pas encore de texte. Rien n'est
 * inventé — les questions de la forge ne font que désigner un vide, elles ne
 * racontent jamais rien à la place de Romain.
 *
 * La page se rend à la demande : elle montre l'état vivant de l'atelier.
 */
import Base from '../layouts/Base.astro';
import {
  monde, etats, provinces, burgs, cultures, religions,
  chiffresDuMonde, nombre, nomAffiche, etatParId,
} from '../lib/monde';
import { listerPagesEcrites, listerLieux, stockage } from '../lib/stockage';
import { lireLore, categoriesDe } from '../lib/lore';
import { lireChroniques, chroniquesDe } from '../lib/chroniques';

export const prerender = false;

const c = chiffresDuMonde();
const relie = Boolean(stockage(Astro.locals));

const [pages, lieux, lore, chron] = await Promise.all([
  listerPagesEcrites(Astro.locals),
  listerLieux(Astro.locals),
  lireLore(Astro.locals),
  lireChroniques(Astro.locals),
]);

const ecrites = new Set(pages.map((p) => `${p.section}/${p.slug}`));
const teinte = (etatId: number | null | undefined) =>
  (etatId != null ? etatParId.get(etatId)?.couleur : null) ?? 'var(--muted)';

/* ------------------------------------------------------------------------
   Le catalogue des fiches du monde : tout ce qui peut recevoir du texte.
   ------------------------------------------------------------------------ */
type Fiche = { section: string; slug: string; nom: string; url: string; ton: string; genre: string };

const catalogue: Fiche[] = [
  ...etats.map((e) => ({ section: 'etats', slug: e.slug, nom: e.nom, url: `/etats/${e.slug}`, ton: e.couleur, genre: 'Royaume' })),
  ...provinces.map((p) => ({ section: 'provinces', slug: p.slug, nom: p.nom, url: `/provinces/${p.slug}`, ton: teinte(p.etatId), genre: 'Province' })),
  ...burgs.map((b) => ({ section: 'villes', slug: b.slug, nom: nomAffiche(b.nom), url: `/villes/${b.slug}`, ton: teinte(b.etatId), genre: 'Ville' })),
  ...cultures.map((k) => ({ section: 'cultures', slug: k.slug, nom: k.nom, url: `/cultures/${k.slug}`, ton: 'var(--muted)', genre: 'Culture' })),
  ...religions.map((r) => ({ section: 'religions', slug: r.slug, nom: r.nom, url: `/religions/${r.slug}`, ton: 'var(--muted)', genre: 'Religion' })),
  ...lieux.map((l) => ({ section: 'lieux', slug: l.slug, nom: l.nom, url: `/lieux/${l.slug}`, ton: l.couleur, genre: 'Lieu' })),
];

const aPeupler = catalogue.filter((f) => !ecrites.has(`${f.section}/${f.slug}`));

/* ------------------------------------------------------------------------
   Résoudre une fiche enregistrée en quelque chose de nommable.
   ------------------------------------------------------------------------ */
const parCle = new Map(catalogue.map((f) => [`${f.section}/${f.slug}`, f]));
const articles = lore.articles ?? [];
const catsLore = new Map(categoriesDe(lore).map((k) => [k.slug, k.nom]));
const chroniques = new Map(chroniquesDe(chron).map((k) => [k.slug, k.titre]));

function resoudre(p: { section: string; slug: string }): Fiche | null {
  const direct = parCle.get(`${p.section}/${p.slug}`);
  if (direct) return direct;
  // Le codex : la mise en page d'un article vit sous son identifiant.
  if (p.section === 'lore') {
    if (p.slug.startsWith('c-')) {
      const s = p.slug.slice(2);
      const nom = catsLore.get(s);
      return nom ? { section: 'lore', slug: p.slug, nom, url: `/lore/${s}`, ton: 'var(--accent)', genre: 'Codex' } : null;
    }
    const a = articles.find((x) => x.id === p.slug);
    return a
      ? { section: 'lore', slug: p.slug, nom: a.titre, url: `/lore/${a.categorie}/${a.slug}`, ton: a.couleur || 'var(--accent)', genre: `Codex · ${catsLore.get(a.categorie) ?? ''}`.trim() }
      : null;
  }
  // Les chroniques : idem, sous l'identifiant de l'événement.
  if (p.section === 'chronique') {
    const e = chron.evenements.find((x) => x.id === p.slug);
    if (e) return { section: 'chronique', slug: p.slug, nom: e.titre, url: `/chronologie/${e.chronique}/${e.slug}`, ton: e.couleur, genre: `Chronologie · ${chroniques.get(e.chronique) ?? ''}`.trim() };
    if (p.slug.startsWith('c-')) {
      const s = p.slug.slice(2);
      const t = chroniques.get(s);
      return t ? { section: 'chronique', slug: p.slug, nom: t, url: `/chronologie/${s}`, ton: 'var(--accent)', genre: 'Chronologie' } : null;
    }
  }
  return null;
}

const recentes = pages
  .filter((p) => p.modifieLe)
  .sort((a, b) => (b.modifieLe ?? '').localeCompare(a.modifieLe ?? ''))
  .map((p) => ({ page: p, fiche: resoudre(p) }))
  .filter((x): x is { page: typeof pages[0]; fiche: Fiche } => x.fiche !== null)
  .slice(0, 4);

/** « il y a 2 h », « hier », « il y a 5 j ». */
function depuis(iso?: string): string {
  if (!iso) return '';
  const ms = Date.now() - new Date(iso).getTime();
  const h = Math.floor(ms / 3600000);
  if (h < 1) return "à l'instant";
  if (h < 24) return `il y a ${h} h`;
  const j = Math.floor(h / 24);
  if (j === 1) return 'hier';
  if (j < 31) return `il y a ${j} j`;
  const m = Math.floor(j / 30);
  return `il y a ${m} mois`;
}

const reprendre = recentes[0]?.fiche.url ?? '/chronologie/monde';

/* ------------------------------------------------------------------------
   Le fil de mémoire : ce que Romain a déjà écrit, à relire.
   ------------------------------------------------------------------------ */
const fil = [
  ...articles.map((a) => ({
    cat: `Codex · ${catsLore.get(a.categorie) ?? 'Article'}`,
    ton: a.couleur || 'var(--muted)',
    titre: a.titre,
    texte: a.resume || '',
    url: `/lore/${a.categorie}/${a.slug}`,
    action: 'Relire l’entrée',
  })),
  ...chron.evenements.map((e) => ({
    cat: `Chronologie · an ${nombre(e.an)}`,
    ton: e.couleur,
    titre: e.titre,
    texte: e.resume || '',
    url: `/chronologie/${e.chronique}/${e.slug}`,
    action: 'Relire l’entrée',
  })),
  ...lieux.map((l) => ({
    cat: `Lieu · ${l.categorie || 'Repère'}`,
    ton: l.couleur,
    titre: l.nom,
    texte: '',
    url: `/lieux/${l.slug}`,
    action: 'Ouvrir le lieu',
  })),
].slice(0, 12);

/* ------------------------------------------------------------------------
   La forge : des questions qui désignent un vide, sans jamais le remplir.
   ------------------------------------------------------------------------ */
const TOURNURES: Record<string, string[]> = {
  Ville: ['Qui vit à {n}, et de quoi ?', 'Que voit-on en arrivant à {n} ?', 'Qui commande à {n} — et depuis quand ?'],
  Province: ['Où passent les routes de {n} ?', 'Qu’est-ce qui fait la richesse de {n} ?', 'Où s’arrête vraiment {n} ?'],
  Royaume: ['Sur quoi repose la couronne de {n} ?', 'Qui, dans {n}, ne reconnaît pas le trône ?'],
  Religion: ['Que promet {n} à ses fidèles ?', 'Qui parle au nom de {n} ?', 'Que refuse {n} ?'],
  Culture: ['Quelle langue parle-t-on chez {n} ?', 'Qu’est-ce qui se transmet chez {n} ?'],
  Lieu: ['Que trouve-t-on à {n} ?', 'Pourquoi évite-t-on {n} ?'],
};
const questions = aPeupler.slice(0, 60).map((f, i) => {
  const jeu = TOURNURES[f.genre] ?? ['Que sait-on de {n} ?'];
  return {
    q: `« ${jeu[i % jeu.length].replace('{n}', f.nom)} »`,
    s: `${f.genre.toLowerCase()} sans page · ${f.nom}`,
    url: f.url,
  };
});
const premiere = questions[0] ?? {
  q: '« Tout est écrit — que veux-tu ajouter au monde ? »',
  s: 'aucune fiche vide',
  url: '/chronologie/monde',
};

/* Les épingles de la carte : capitales d'abord, puis les plus grandes villes. */
const epingles = [
  ...burgs.filter((b) => b.capitale),
  ...burgs.filter((b) => !b.capitale && b.nom && b.nom !== '???').sort((a, b) => b.population - a.population).slice(0, 3),
].map((b) => ({
  nom: nomAffiche(b.nom),
  slug: b.slug,
  etat: etatParId.get(b.etatId ?? -1)?.nom ?? '',
  ton: teinte(b.etatId),
  gauche: (b.x / 1920) * 100,
  haut: (b.y / 919) * 100,
  sous: b.capitale ? 'capitale' : `${nombre(b.population * 1000)} habitants`,
}));

const pluriel = (n: number, un: string, plusieurs: string) => (n > 1 ? plusieurs : un);
const stats = [
  { n: nombre(pages.length), l: pluriel(pages.length, 'page écrite', 'pages écrites') },
  { n: nombre(aPeupler.length), l: 'à peupler' },
  { n: nombre(articles.length), l: pluriel(articles.length, 'article du codex', 'articles du codex') },
  { n: nombre(chron.evenements.length), l: pluriel(chron.evenements.length, 'événement daté', 'événements datés') },
];
---

<Base titre={monde.nom} description={`L'atelier de ${monde.nom} : reprendre une page, creuser une question, ouvrir l'atlas.`}>
  {/* Les deux voix de l'atelier. Un <link> dans le corps est valide et
      n'empêche pas le rendu : le reste du site garde ses polices. */}
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
  />

  <div class="atelier">
    <div class="aura" aria-hidden="true"><i class="a1"></i><i class="a2"></i><i class="a3"></i><i class="a4"></i></div>

    <div class="wrap">
      <!-- ============================ HERO ============================ -->
      <header class="hero">
        <div>
          <p class="eyebrow rise">An {monde.annee} — {monde.ere}</p>
          <h1 class="rise" style="animation-delay:.08s">Le monde n'attend<br />que ta <em>plume</em>.</h1>
          <p class="lede rise" style="animation-delay:.16s">
            {nombre(c.villes)} villes, {nombre(c.provinces)} provinces, {nombre(c.religions)} religions —
            et {nombre(aPeupler.length)} pages encore blanches. Reprends une fiche, creuse une
            question, ou pars te perdre dans l'atlas.
          </p>
          <div class="cta-row rise" style="animation-delay:.24s">
            <a class="btn primary" href={reprendre}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              Reprendre la plume
            </a>
            <a class="btn ghost" href="/atlas">
              Ouvrir l'atlas
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
          <div class="hero-stats rise" style="animation-delay:.32s">
            {stats.map((s) => (
              <span class="hstat"><span class="n">{s.n}</span><span class="l">{s.l}</span></span>
            ))}
          </div>
        </div>

        <!-- ===================== REPRENDRE ===================== -->
        <aside class="resume rise" style="animation-delay:.2s">
          <div class="head">
            <span class="t">Dernières fiches</span>
            {recentes.length > 0 && <a href="/chronologie">Tout voir</a>}
          </div>
          {
            recentes.length === 0 ? (
              <p class="resume__vide">
                {relie
                  ? 'Rien n’a encore été écrit. La première page que tu enregistreras apparaîtra ici.'
                  : 'Le stockage n’est pas relié : les fiches enregistrées apparaîtront ici.'}
              </p>
            ) : (
              recentes.map(({ page, fiche }) => (
                <a class="doc" href={fiche.url} style={`--kk:${fiche.ton}`}>
                  <span class="dot" />
                  <span class="info">
                    <span class="name">{fiche.nom}</span>
                    <span class="path">{fiche.genre}</span>
                  </span>
                  <span class="when">{depuis(page.modifieLe)}</span>
                </a>
              ))
            )
          }
          <div class="foot">
            <a class="btn ghost small" href="/lore" style="justify-content:center">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
              Nouvelle page
            </a>
          </div>
        </aside>
      </header>

      <!-- ============================ CARTE ============================ -->
      <section>
        <div class="sec-head">
          <div>
            <p class="kicker">Atlas</p>
            <h2>Les terres connues</h2>
          </div>
          <a class="more" href="/atlas">
            Ouvrir l'atlas complet
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <div class="mapcard">
          <div class="map">
            <img src="/carte/apercu.svg" alt={`Carte de ${monde.nom}`} width="1920" height="919" loading="lazy" />
            {epingles.map((p) => (
              <a class="pin" href={`/villes/${p.slug}`} style={`left:${p.gauche}%;top:${p.haut}%;--pk:${p.ton}`}>
                <span class="tip">{p.nom}<small>{[p.sous, p.etat].filter(Boolean).join(' · ')}</small></span>
              </a>
            ))}
          </div>
          <div class="map-foot">
            <div class="legend">
              {etats.map((e) => (
                <span><i style={`background:${e.couleur}`} />{e.nom}</span>
              ))}
            </div>
            <span class="hint">survole une épingle · clic = ouvrir la fiche</span>
          </div>
        </div>
      </section>

      <!-- ======================= FIL DE MÉMOIRE ======================= -->
      <section>
        <div class="sec-head">
          <div>
            <p class="kicker">Mémoire du monde</p>
            <h2>Relire, pour mieux écrire</h2>
          </div>
          <a class="more" href="/lore">
            Ouvrir le Codex
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        {
          fil.length === 0 ? (
            <p class="fil-vide">
              Rien à relire pour l'instant. Ce fil se remplira de tes articles du
              codex, de tes événements datés et des lieux que tu poses sur la carte.
            </p>
          ) : (
            <div class="stream"><div class="row" id="streamRow" /></div>
          )
        }
      </section>

      <!-- ======================== LA FORGE ======================== -->
      <section>
        <div class="sec-head">
          <div>
            <p class="kicker">La forge</p>
            <h2>De quoi écrire ce soir</h2>
          </div>
        </div>
        <div class="forge">
          <div class="prompt">
            <p class="k">Une question pour creuser</p>
            <blockquote id="promptText">{premiere.q}</blockquote>
            <p class="src" id="promptSrc">suggérée d'après : {premiere.s}</p>
            <div class="row">
              <a class="btn primary small" id="promptLien" href={premiere.url}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                Écrire cette page
              </a>
              {questions.length > 1 && (
                <button class="btn ghost small" id="shuffle" type="button">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15.5-6.3L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.3L3 16M3 21v-5h5"/></svg>
                  Autre question
                </button>
              )}
            </div>
          </div>

          <aside class="stubs">
            <div class="head">
              <span class="t">À peupler</span>
              <span class="n">{nombre(aPeupler.length)} {pluriel(aPeupler.length, 'page vide', 'pages vides')}</span>
            </div>
            {
              aPeupler.slice(0, 5).map((f) => (
                <a class="stub" href={f.url} style={`--kk:${f.ton}`}>
                  <span class="dot" />
                  <span class="nm">{f.nom}</span>
                  <span class="st empty">{f.genre.toLowerCase()}</span>
                </a>
              ))
            }
            {aPeupler.length === 0 && <p class="resume__vide">Toutes les fiches ont leur page. Beau travail.</p>}
            <div class="foot">
              <a href="/etats">
                Parcourir les royaumes
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </aside>
        </div>
      </section>
    </div>
  </div>

  <script type="application/json" id="donnees-atelier" set:html={JSON.stringify({ fil, questions })} />
</Base>

<style is:global>
  /* =====================================================================
     L'ATELIER — la page d'accueil.
     Le thème Parchemin & Bordeaux reste la source de vérité ; cette page
     lui ajoute ses deux voix typographiques et ses plaques de verre.
     ===================================================================== */
  .atelier {
    --font-display: 'Cormorant Garamond', Georgia, serif;
    --font-body: 'Hanken Grotesk', -apple-system, system-ui, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
    --k-levanzia: #6d3a7a;
    --k-varenhold: #c8912f;
    --k-ornebois: #5b86b0;
    --shadow: 0 10px 30px -20px rgba(38, 32, 28, .25);
    --shadow-lift: 0 20px 46px -26px rgba(38, 32, 28, .42);
    --glass: linear-gradient(152deg, rgba(255,253,247,.78), rgba(247,242,231,.44));
    --glass-strong: linear-gradient(152deg, rgba(255,254,250,.92), rgba(247,242,231,.70));
    --glass-line: rgba(255,255,255,.72);
    --glass-hi: inset 0 1px 0 rgba(255,255,255,.85);
    --blur: blur(16px) saturate(140%);
    --dark-glass: linear-gradient(160deg, rgba(38,33,29,.93), rgba(28,24,21,.90));

    position: relative;
    font-family: var(--font-body);
    line-height: 1.55;
  }

  /* Halos ambiants : très basse opacité, ils donnent de la matière au flou. */
  .atelier .aura { position: fixed; inset: -20%; z-index: 0; pointer-events: none; filter: blur(76px); opacity: .85; }
  .atelier .aura i { position: absolute; border-radius: 50%; display: block; }
  .atelier .aura .a1 { width: 52vw; height: 52vw; left: -10%; top: -14%; background: radial-gradient(circle, rgba(138,47,60,.20), transparent 66%); animation: derive1 34s ease-in-out infinite; }
  .atelier .aura .a2 { width: 46vw; height: 46vw; right: -8%; top: 2%; background: radial-gradient(circle, rgba(200,145,47,.22), transparent 66%); animation: derive2 42s ease-in-out infinite; }
  .atelier .aura .a3 { width: 56vw; height: 56vw; left: 24%; bottom: -30%; background: radial-gradient(circle, rgba(109,58,122,.16), transparent 64%); animation: derive3 38s ease-in-out infinite; }
  .atelier .aura .a4 { width: 40vw; height: 40vw; right: 14%; bottom: -6%; background: radial-gradient(circle, rgba(91,134,176,.16), transparent 66%); animation: derive2 46s ease-in-out infinite reverse; }
  @keyframes derive1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(5%,7%) scale(1.12); } }
  @keyframes derive2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-6%,5%) scale(1.1); } }
  @keyframes derive3 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(4%,-5%) scale(1.14); } }

  .atelier .wrap { position: relative; z-index: 1; max-width: 1160px; margin: 0 auto; padding: 0 clamp(18px, 4vw, 44px); }
  .atelier a { color: var(--accent); text-decoration: none; background-image: none; }
  .atelier a:hover { text-decoration: underline; color: var(--accent); }

  /* ------------------------------------------------------------- hero */
  .atelier .hero {
    padding: clamp(28px, 5vw, 56px) 0 clamp(28px, 4vw, 44px);
    display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(28px, 5vw, 64px); align-items: start;
  }
  @media (max-width: 920px) { .atelier .hero { grid-template-columns: 1fr; } }
  .atelier .eyebrow { font-family: var(--font-mono); font-size: .74rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--accent); margin: 0 0 18px; }
  .atelier .hero h1 { font-family: var(--font-display); font-weight: 600; font-size: clamp(2.6rem, 6.4vw, 4.4rem); line-height: 1.02; letter-spacing: -.01em; margin: 0; text-wrap: balance; color: var(--ink); }
  .atelier .hero h1 em { font-style: italic; }
  .atelier .hero .lede { margin: 20px 0 0; color: var(--muted); max-width: 52ch; font-size: 1.04rem; }
  .atelier .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .atelier .btn { display: inline-flex; align-items: center; gap: 9px; font-family: var(--font-body); font-weight: 600; font-size: .93rem; padding: 13px 22px; border-radius: 10px; cursor: pointer; transition: background .2s, border-color .2s, color .2s; text-decoration: none; border: 1px solid transparent; }
  .atelier .btn:hover { text-decoration: none; }
  .atelier .btn svg { width: 15px; height: 15px; flex: none; }
  .atelier .btn.primary { background-image: linear-gradient(160deg, color-mix(in srgb, var(--accent) 88%, white), var(--accent) 60%, var(--accent-strong)); color: var(--on-accent); border-color: var(--accent-strong); box-shadow: 0 12px 26px -16px rgba(138,47,60,.85), inset 0 1px 0 rgba(255,255,255,.22); }
