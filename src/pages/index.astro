  @keyframes defile { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .atelier .fil-vide { margin: 0; padding: 26px; text-align: center; color: var(--muted); font-size: .92rem; border: 1px dashed var(--line); border-radius: 16px; background: var(--surface); }
  .atelier .lore { position: relative; width: 300px; flex: none; background: var(--surface); background-image: var(--glass); backdrop-filter: var(--blur); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow), var(--glass-hi); padding: 18px 19px; display: flex; flex-direction: column; gap: 9px; overflow: hidden; transition: transform .3s cubic-bezier(.34,1.4,.64,1), box-shadow .3s, border-color .3s; }
  .atelier .lore::after { content: ''; position: absolute; top: -30%; right: -25%; width: 64%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--kk) 16%, transparent), transparent 70%); pointer-events: none; transition: transform .45s; }
  .atelier .lore:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift), var(--glass-hi); border-color: color-mix(in srgb, var(--kk) 35%, var(--line)); }
  .atelier .lore:hover::after { transform: scale(1.25); }
  .atelier .lore .k { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-family: var(--font-mono); font-size: .64rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .atelier .lore .k i { width: 8px; height: 8px; border-radius: 50%; background: var(--kk, var(--muted)); flex: none; }
  .atelier .lore h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.28rem; line-height: 1.1; margin: 0; color: var(--ink); }
  .atelier .lore p { margin: 0; font-size: .85rem; color: var(--muted); line-height: 1.5; }
