  /* ---------------------------------------------------------- la forge */
  .atelier .forge { display: grid; grid-template-columns: 1.15fr .85fr; gap: 14px; align-items: stretch; }
  @media (max-width: 920px) { .atelier .forge { grid-template-columns: 1fr; } }
  .atelier .prompt { position: relative; overflow: hidden; background: var(--surface); background-image: var(--glass-strong); backdrop-filter: var(--blur); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow), var(--glass-hi); padding: clamp(24px, 4vw, 40px); display: flex; flex-direction: column; }
  .atelier .prompt::after { content: ''; position: absolute; top: -40%; left: -15%; width: 55%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(138,47,60,.10), transparent 68%); pointer-events: none; }
