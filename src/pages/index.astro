</style>

<script>
  const source = document.getElementById('donnees-atelier');
  const { fil, questions } = JSON.parse(source.textContent);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  /* Le fil de mémoire : on duplique les tuiles pour que la boucle soit sans couture. */
  const row = document.getElementById('streamRow');
  if (row && fil.length) {
    const tuile = (l) => {
      const d = document.createElement('article');
      d.className = 'lore';
      d.style.setProperty('--kk', l.ton);
      d.innerHTML =
        '<span class="k"><span>' + esc(l.cat) + '</span><i></i></span>' +
        '<h3>' + esc(l.titre) + '</h3>' +
        (l.texte ? '<p>' + esc(l.texte) + '</p>' : '') +
        '<a class="go" href="' + esc(l.url) + '">' + esc(l.action) + ' →</a>';
      return d;
    };
    for (const l of fil) row.appendChild(tuile(l));
    for (const l of fil) row.appendChild(tuile(l));
    // Peu de tuiles : on ralentit pour que le défilement reste lisible.
    row.style.animationDuration = Math.max(24, fil.length * 7) + 's';
  }

  /* La forge : une autre question, prise dans les fiches encore vides. */
  const shuffle = document.getElementById('shuffle');
  if (shuffle && questions.length > 1) {
    let i = 0;
    const txt = document.getElementById('promptText');
    const src = document.getElementById('promptSrc');
    const lien = document.getElementById('promptLien');
    shuffle.addEventListener('click', () => {
      i = (i + 1) % questions.length;
      txt.style.transition = src.style.transition = 'opacity .3s';
      txt.style.opacity = src.style.opacity = 0;
      setTimeout(() => {
        txt.textContent = questions[i].q;
        src.textContent = "suggérée d'après : " + questions[i].s;
        lien.href = questions[i].url;
        txt.style.opacity = src.style.opacity = 1;
      }, 180);
    });
  }
</script>
