---
import Base from '../layouts/Base.astro';
import {
  cultures, religions, villesDeLaCulture, habitants, nombre,
  natureCulture, natureReligion, formeReligion, lien,
} from '../lib/monde';

const listeCultures = [...cultures].sort((a, b) => b.superficieKm2 - a.superficieKm2);
const parNature = new Map<string, typeof religions>();
for (const r of religions) {
  const cle = natureReligion(r.nature);
  const groupe = parNature.get(cle);
  if (groupe) groupe.push(r);
  else parNature.set(cle, [r]);
}
const groupesReligions = [...parNature.entries()].sort((a, b) => b[1].length - a[1].length);
---

<Base titre="Peuples" description="Cultures et religions du monde.">
  <div class="contenant">
    <header class="cartouche">
      <p class="etiquette">{cultures.length} cultures · {religions.length} religions</p>
      <h1>Peuples</h1>
    </header>

    <div class="pile" style="margin-top:2.5rem">
      <section>
        <h2 class="etiquette">Cultures</h2>
        <div class="grille" style="margin-top:0.75rem">
          {
            listeCultures.map((c) => (
              <a class="carte" href={lien('culture', c.slug)}>
                <span class="carte__titre">
                  <i class="pastille" style={`background:${c.couleur}`} />
                  {c.nom}
                </span>
                <span class="carte__meta">
                  {natureCulture(c.nature)} · {nombre(villesDeLaCulture(c.id).length)} villes ·
                  {' '}{habitants(c.populationUrbaine + c.populationRurale)} hab.
                </span>
              </a>
            ))
          }
        </div>
      </section>

      {
        groupesReligions.map(([nature, liste]) => (
          <section>
            <h2 class="etiquette">
              Religions · {nature} <span class="discret">· {liste.length}</span>
            </h2>
            <div class="grille" style="margin-top:0.75rem">
              {liste
                .sort((a, b) => b.fideles - a.fideles)
                .map((r) => (
                  <a class="carte" href={lien('religion', r.slug)}>
                    <span class="carte__titre">
                      <i class="pastille" style={`background:${r.couleur}`} />
                      {r.nom}
                    </span>
                    <span class="carte__meta">
                      {formeReligion(r.forme)}
                      {r.fideles ? ` · ${habitants(r.fideles)} fidèles` : ''}
                    </span>
                  </a>
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>
