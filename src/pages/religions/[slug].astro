---
import Fiche from '../../components/Fiche.astro';
import { religions } from '../../lib/monde';
import { contexteDe } from '../../lib/contexte';

export function getStaticPaths() {
  return religions.map((religion) => ({ params: { slug: religion.slug }, props: { religion } }));
}

const { religion } = Astro.props;
---

<Fiche contexte={contexteDe.religion(religion)} />
