  .entite__groupe:first-child {
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .atelier-courants__grille {
      grid-template-columns: 1fr;
    }
    .colonne {
      max-height: 40svh;
    }
  }
</style>

<script>
  /**
   * L'atelier des courants.
   *
   * Il travaille sur une copie locale de la politique du monde et n'écrit
   * qu'à la demande, comme l'atelier des fiches. Après un enregistrement, la
   * page est rechargée : la vue publique est rendue par le serveur, et la
   * recharger évite d'en tenir une seconde version ici.
   */
  const donnees = JSON.parse(document.getElementById('donnees-politique').textContent);
  let politique = donnees.politique;

  const CLE_MDP = 'victorum:mot-de-passe';
  const CLE_ETAT = 'victorum:atelier-courants';

  const $ = (id) => document.getElementById(id);
  const atelier = $('atelier');
  const etat = $('etat-atelier');

  let axeChoisi = null;
  let courantChoisi = null;
  let adhesionsLocales = new Map(); // entite → part | null

  /* ------------------------------------------------------------ ouverture */

  function ouvrir(rouvrir) {
    atelier.hidden = false;
    if (rouvrir) {
      axeChoisi = rouvrir.axeChoisi ?? null;
      courantChoisi = rouvrir.courantChoisi ?? null;
    }
    rendre();
  }

  $('ouvrir-atelier').addEventListener('click', () => ouvrir());
  $('fermer-atelier').addEventListener('click', () => {
    atelier.hidden = true;
    sessionStorage.removeItem(CLE_ETAT);
  });

  // On rouvre l'atelier là où il était après un rechargement.
  const memoire = sessionStorage.getItem(CLE_ETAT);
  if (memoire) ouvrir(JSON.parse(memoire));

  /* --------------------------------------------------------------- rendu */

  const axes = () => [...politique.axes].sort((a, b) => a.ordre - b.ordre);
  const courants = (axeId) =>
    politique.courants.filter((c) => c.axeId === axeId).sort((a, b) => a.ordre - b.ordre);
  const axeDe = (id) => politique.axes.find((a) => a.id === id) || null;
  const courantDe = (id) => politique.courants.find((c) => c.id === id) || null;

  function rendre() {
    rendreAxes();
    rendreCourants();
    rendreEntites();
    majEtat();
  }

  function bouton(texte, actif, surClic, compte) {
    const li = document.createElement('li');
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = texte;
    if (actif) b.setAttribute('aria-current', 'true');
    if (compte !== undefined) {
      const petit = document.createElement('small');
      petit.textContent = compte;
      b.appendChild(petit);
    }
    b.addEventListener('click', surClic);
    li.appendChild(b);
    return li;
  }

  function rendreAxes() {
    const liste = $('liste-axes');
    liste.innerHTML = '';
    for (const axe of axes()) {
      liste.appendChild(
        bouton(axe.nom, axe.id === axeChoisi, () => {
          axeChoisi = axe.id;
          courantChoisi = null;
          remplirFormeAxe(axe);
          rendre();
        }, `${courants(axe.id).length}`)
      );
    }
    $('nouveau-courant').disabled = !axeChoisi;
    if (!axeChoisi) $('forme-axe').hidden = true;
  }

  function rendreCourants() {
    const liste = $('liste-courants');
    liste.innerHTML = '';
    if (!axeChoisi) {
      $('forme-courant').hidden = true;
      return;
    }
    for (const courant of courants(axeChoisi)) {
      const compte = politique.adhesions.filter((a) => a.courantId === courant.id).length;
      liste.appendChild(
        bouton(`${courant.symbole} ${courant.nom}`, courant.id === courantChoisi, () => {
          courantChoisi = courant.id;
          remplirFormeCourant(courant);
          chargerAdhesions(courant.id);
          rendre();
        }, `${compte}`)
      );
    }
  }

  /* ----------------------------------------------------------------- axes */

  function remplirFormeAxe(axe) {
    const forme = $('forme-axe');
    forme.hidden = false;
    forme.dataset.id = axe?.id || '';
    $('axe-nom').value = axe?.nom || '';
    $('axe-multiple').checked = Boolean(axe?.multiple);
    $('supprimer-axe').hidden = !axe;

    const cases = $('axe-cibles');
    cases.innerHTML = '';
    for (const cible of donnees.cibles) {
      const label = document.createElement('label');
      label.className = 'controle';
      const entree = document.createElement('input');
      entree.type = 'checkbox';
      entree.value = cible.cle;
      entree.checked = axe ? axe.cibles.includes(cible.cle) : cible.cle === 'etat';
      const texte = document.createElement('span');
      texte.textContent = cible.libelle;
      label.append(entree, texte);
      cases.appendChild(label);
    }
  }

  $('nouvel-axe').addEventListener('click', () => {
    axeChoisi = null;
    courantChoisi = null;
    remplirFormeAxe(null);
    rendre();
    $('axe-nom').focus();
  });

  $('forme-axe').addEventListener('submit', (ev) => {
    ev.preventDefault();
    const cibles = [...$('axe-cibles').querySelectorAll('input:checked')].map((i) => i.value);
    envoyer({
      action: 'axe',
      id: $('forme-axe').dataset.id || undefined,
      nom: $('axe-nom').value,
      cibles,
      multiple: $('axe-multiple').checked,
    });
  });

  $('supprimer-axe').addEventListener('click', () => {
    const id = $('forme-axe').dataset.id;
    if (!id) return;
    const axe = axeDe(id);
    if (!confirm(`Supprimer l'axe « ${axe?.nom} », ses courants et leurs adhésions ?`)) return;
    envoyer({ action: 'supprimer-axe', id });
  });

  /* ------------------------------------------------------------- courants */

  function remplirFormeCourant(courant) {
    const forme = $('forme-courant');
    forme.hidden = false;
    forme.dataset.id = courant?.id || '';
    $('courant-nom').value = courant?.nom || '';
    $('courant-symbole').value = courant?.symbole || '◆';
    $('courant-couleur').value = courant?.couleur || '#c9a227';
    $('courant-resume').value = courant?.resume || '';
    $('supprimer-courant').hidden = !courant;
  }

  $('nouveau-courant').addEventListener('click', () => {
    courantChoisi = null;
    remplirFormeCourant(null);
    adhesionsLocales = new Map();
    rendre();
    $('courant-nom').focus();
  });

  $('forme-courant').addEventListener('submit', (ev) => {
    ev.preventDefault();
    envoyer({
      action: 'courant',
      id: $('forme-courant').dataset.id || undefined,
      axeId: axeChoisi,
      nom: $('courant-nom').value,
      symbole: $('courant-symbole').value,
      couleur: $('courant-couleur').value,
      resume: $('courant-resume').value,
    });
  });

  $('supprimer-courant').addEventListener('click', () => {
    const id = $('forme-courant').dataset.id;
    if (!id) return;
    if (!confirm(`Supprimer ce courant et ses adhésions ?`)) return;
    envoyer({ action: 'supprimer-courant', id });
  });

  /* ------------------------------------------------------------ adhésions */

  function chargerAdhesions(courantId) {
    adhesionsLocales = new Map(
      politique.adhesions
        .filter((a) => a.courantId === courantId)
        .map((a) => [a.entite, a.part ?? null])
    );
  }

  function rendreEntites() {
    const hote = $('liste-entites');
    hote.innerHTML = '';
    const courant = courantDe(courantChoisi);
    const axe = courant ? axeDe(courant.axeId) : null;
    $('enregistrer-adhesions').disabled = !courant;

    if (!courant || !axe) {
      const aide = document.createElement('p');
      aide.className = 'aide';
      aide.textContent = 'Choisis d’abord un courant.';
      hote.appendChild(aide);
      return;
    }

    const filtre = $('filtre-entites').value.trim().toLowerCase();
    for (const cible of axe.cibles) {
      const liste = (donnees.entites[cible] || []).filter(
        (e) => !filtre || e.nom.toLowerCase().includes(filtre)
      );
      if (!liste.length) continue;

      const titre = document.createElement('p');
      titre.className = 'entite__groupe';
      titre.textContent = donnees.cibles.find((c) => c.cle === cible)?.libelle || cible;
      hote.appendChild(titre);

      for (const entree of liste) {
        const cle = `${cible}:${entree.id}`;
        const label = document.createElement('label');
        label.className = 'entite';

        const case_ = document.createElement('input');
        case_.type = 'checkbox';
        case_.checked = adhesionsLocales.has(cle);

        const nom = document.createElement('span');
        nom.textContent = entree.nom;
        label.append(case_, nom);

        let part = null;
        if (axe.multiple) {
          part = document.createElement('input');
          part.type = 'number';
          part.min = '0';
          part.max = '100';
          part.step = '0.5';
          part.placeholder = '%';
          part.value = adhesionsLocales.get(cle) ?? '';
          part.disabled = !case_.checked;
          part.addEventListener('input', () => {
            adhesionsLocales.set(cle, part.value === '' ? null : Number(part.value));
          });
          label.appendChild(part);
        }

        case_.addEventListener('change', () => {
          if (case_.checked) adhesionsLocales.set(cle, part && part.value !== '' ? Number(part.value) : null);
          else adhesionsLocales.delete(cle);
          if (part) part.disabled = !case_.checked;
        });

        hote.appendChild(label);
      }
    }
  }

  $('filtre-entites').addEventListener('input', rendreEntites);

  $('enregistrer-adhesions').addEventListener('click', () => {
    if (!courantChoisi) return;
    envoyer({
      action: 'adhesions',
      id: courantChoisi,
      adhesions: [...adhesionsLocales].map(([entite, part]) => ({ entite, part })),
    });
  });

  /* ----------------------------------------------------------- écriture */

  function motDePasse(redemander) {
    let mdp = sessionStorage.getItem(CLE_MDP);
    if (!mdp || redemander) {
      mdp = prompt(
        donnees.motDePasseDefini
          ? "Mot de passe de l'atelier :"
          : "Choisis le mot de passe de ton atelier. Il te sera demandé pour toute modification, et personne d'autre ne pourra écrire sur ton site."
      );
      if (mdp) sessionStorage.setItem(CLE_MDP, mdp);
    }
    return mdp;
  }

  async function envoyer(corps, redemander = false) {
    if (!donnees.stockageActif) {
      majEtat("Le stockage n'est pas relié : impossible d'enregistrer.");
      return;
    }
    const mdp = motDePasse(redemander);
    if (!mdp) return majEtat('Mot de passe non saisi.');

    majEtat('Enregistrement…');
    try {
      const reponse = await fetch('/api/politique', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-mot-de-passe': mdp },
        body: JSON.stringify(corps),
      });
      const resultat = await reponse.json().catch(() => ({}));

      if (reponse.status === 401) {
        sessionStorage.removeItem(CLE_MDP);
        return majEtat(resultat.erreur || 'Mot de passe refusé.');
      }
      if (!reponse.ok) return majEtat(resultat.erreur || 'Échec de l’enregistrement.');

      politique = resultat.politique;
      donnees.motDePasseDefini = true;
      // La vue publique est rendue par le serveur : on la laisse se refaire.
      sessionStorage.setItem(CLE_ETAT, JSON.stringify({ axeChoisi, courantChoisi }));
      location.reload();
    } catch {
      majEtat('Réseau indisponible.');
    }
  }

  function majEtat(message) {
    if (message) {
      etat.textContent = message;
      return;
    }
    const nb = politique.courants.length;
    etat.textContent = donnees.stockageActif
      ? `${politique.axes.length} axe${politique.axes.length > 1 ? 's' : ''} · ${nb} courant${nb > 1 ? 's' : ''}`
      : 'Stockage non relié';
  }

  rendre();
</script>
