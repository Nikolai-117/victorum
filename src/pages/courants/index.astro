---
/**
 * Les courants du monde : idéologies, doctrines, allégeances.
 *
 * La page publique montre ce que Romain a défini ; l'atelier, protégé par le
 * mot de passe, permet de tout créer. Rien n'est jamais proposé d'avance :
 * les axes, les noms, les couleurs et les textes sont les siens.
 */
import Base from '../../layouts/Base.astro';
import { lirePolitique, libelleCible, CIBLES } from '../../lib/politique';
import { motDePasseDefini, stockage, listerLieux } from '../../lib/stockage';
import {
  etats, provinces, burgs, cultures, religions, nomAffiche, nombre,
} from '../../lib/monde';

export const prerender = false;

const politique = await lirePolitique(Astro.locals);
const lieux = await listerLieux(Astro.locals);

/** Le catalogue de tout ce à quoi un courant peut s'attacher. */
const entites = {
  etat: etats.map((e) => ({ id: e.id, nom: e.nomComplet })),
  province: provinces.map((p) => ({ id: p.id, nom: p.nomComplet })),
  burg: [...burgs]
    .sort((a, b) => b.population - a.population)
    .map((b) => ({ id: b.id, nom: nomAffiche(b.nom) })),
  culture: cultures.map((c) => ({ id: c.id, nom: c.nom })),
  religion: religions.map((r) => ({ id: r.id, nom: r.nom })),
  lieu: lieux.map((l) => ({ id: l.id, nom: l.nom })),
};

const nomEntite = (cle: string): string | null => {
  const [type, id] = cle.split(':');
  const liste = (entites as Record<string, { id: number | string; nom: string }[]>)[type];
  return liste?.find((e) => String(e.id) === id)?.nom ?? null;
};

const axes = [...politique.axes].sort((a, b) => a.ordre - b.ordre);
const courantsDeLAxe = (axeId: string) =>
  politique.courants.filter((c) => c.axeId === axeId).sort((a, b) => a.ordre - b.ordre);

/** Combien d'entités suivent ce courant, et lesquelles en premier. */
const adherents = (courantId: string) => {
  const liste = politique.adhesions
    .filter((a) => a.courantId === courantId)
    .sort((a, b) => (b.part ?? 0) - (a.part ?? 0));
  return {
    total: liste.length,
    apercu: liste.map((a) => nomEntite(a.entite)).filter(Boolean).slice(0, 3) as string[],
  };
};

const donnees = {
  politique,
  entites,
  stockageActif: Boolean(stockage(Astro.locals)),
  motDePasseDefini: await motDePasseDefini(Astro.locals),
  cibles: CIBLES.map((c) => ({ cle: c, libelle: libelleCible(c) })),
};
---

<Base titre="Courants" description="Les idéologies et doctrines du monde de Victorum.">
  <div class="contenant">
    <header class="cartouche">
      <p class="etiquette">Idéologies · doctrines · allégeances</p>
      <h1>Courants</h1>
    </header>

    <div class="tete-courants">
      <p class="discret tete-courants__intro">
        Un <b>axe</b> est une grille de lecture : idéologies, doctrines militaires,
        obédiences… Chaque axe contient des <b>courants</b>, et chaque courant est
        professé par des royaumes, des provinces, des cultures — avec, si tu le
        veux, une part de soutien.
      </p>
      <button id="ouvrir-atelier" class="bouton bouton--or" type="button">Composer</button>
    </div>

    {
      axes.length === 0 && (
        <div class="a-ecrire">
          <p class="etiquette">Rien de défini</p>
          <p>
            Aucun axe n'existe encore. Ouvre l'atelier : tu y crées tes propres grilles
            de lecture, leurs courants, et tu désignes qui les professe.
          </p>
          <p class="discret">
            Rien ne sera inventé à ta place — ni les noms, ni les couleurs, ni les textes.
          </p>
        </div>
      )
    }

    {
      axes.map((axe) => {
        const siens = courantsDeLAxe(axe.id);
        return (
          <section class="pile axe-bloc">
            <h2 class="etiquette etiquette--filet">{axe.nom}</h2>
            <p class="axe-bloc__meta">
              {axe.cibles.map((c) => libelleCible(c)).join(' · ')}
              {axe.multiple ? ' · plusieurs courants par entité, avec parts' : ' · un seul courant par entité'}
            </p>
            {siens.length === 0 ? (
              <p class="discret">Cet axe n'a pas encore de courant.</p>
            ) : (
              <div class="grille">
                {siens.map((courant) => {
                  const qui = adherents(courant.id);
                  return (
                    <a class="carte carte--courant" href={`/courants/${courant.slug}`}>
                      <span class="carte__titre">
                        <i class="courant__marque" style={`--teinte:${courant.couleur}`}>
                          {courant.symbole}
                        </i>
                        {courant.nom}
                      </span>
                      <span class="carte__meta">
                        {qui.total ? `${nombre(qui.total)} adhérent${qui.total > 1 ? 's' : ''}` : 'Personne ne le professe encore'}
                        {qui.apercu.length ? ` · ${qui.apercu.join(', ')}` : ''}
                      </span>
                    </a>
                  );
                })}
              </div>
            )}
          </section>
        );
      })
    }
  </div>

  <!-- L'atelier : tout ce qui écrit passe par le mot de passe du site. -->
  <aside class="atelier-courants" id="atelier" hidden>
    <header class="atelier-courants__tete">
      <p class="etiquette">Atelier des courants</p>
      <span class="atelier-etat" id="etat-atelier"></span>
      <button class="fermer" id="fermer-atelier" type="button" aria-label="Fermer">×</button>
    </header>

    <div class="atelier-courants__grille">
      <section class="colonne">
        <p class="etiquette">Axes</p>
        <ul class="colonne__liste" id="liste-axes"></ul>
        <button class="bouton" id="nouvel-axe" type="button">+ Nouvel axe</button>

        <form class="colonne__forme" id="forme-axe" hidden>
          <label class="champ"><span>Nom de l'axe</span>
            <input id="axe-nom" type="text" maxlength="80" placeholder="Idéologies" required />
          </label>
          <p class="etiquette">S'applique à</p>
          <div class="cases" id="axe-cibles"></div>
          <label class="controle">
            <input type="checkbox" id="axe-multiple" />
            <span>Plusieurs courants par entité, avec des parts</span>
          </label>
          <div class="colonne__actions">
            <button class="bouton bouton--or" type="submit">Enregistrer</button>
            <button class="bouton" type="button" id="supprimer-axe">Supprimer</button>
          </div>
        </form>
      </section>

      <section class="colonne">
        <p class="etiquette">Courants</p>
        <ul class="colonne__liste" id="liste-courants"></ul>
        <button class="bouton" id="nouveau-courant" type="button" disabled>+ Nouveau courant</button>

        <form class="colonne__forme" id="forme-courant" hidden>
          <label class="champ"><span>Nom</span>
            <input id="courant-nom" type="text" maxlength="80" required />
          </label>
          <div class="duo">
            <label class="champ"><span>Symbole</span>
              <input id="courant-symbole" type="text" maxlength="4" />
            </label>
            <label class="champ"><span>Couleur</span>
              <input id="courant-couleur" type="color" value="#c9a227" />
            </label>
          </div>
          <label class="champ"><span>Ce que c'est</span>
            <textarea id="courant-resume" rows="5" maxlength="2000"></textarea>
          </label>
          <div class="colonne__actions">
            <button class="bouton bouton--or" type="submit">Enregistrer</button>
            <button class="bouton" type="button" id="supprimer-courant">Supprimer</button>
          </div>
        </form>
      </section>

      <section class="colonne">
        <p class="etiquette">Qui le professe</p>
        <input id="filtre-entites" type="search" placeholder="Filtrer…" autocomplete="off" />
        <div class="colonne__entites" id="liste-entites">
          <p class="aide">Choisis d'abord un courant.</p>
        </div>
        <button class="bouton bouton--or" id="enregistrer-adhesions" type="button" disabled>
          Enregistrer les adhésions
        </button>
      </section>
    </div>
  </aside>

  <script type="application/json" id="donnees-politique" set:html={JSON.stringify(donnees)} />
</Base>

<style is:global>
  .tete-courants {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin: 2rem 0 2.5rem;
    flex-wrap: wrap;
  }
  .tete-courants__intro {
    flex: 1;
    min-width: 20rem;
    max-width: var(--mesure);
    margin: 0;
  }
  .tete-courants b {
    font-weight: 600;
    color: var(--parchemin);
  }

  .axe-bloc {
    margin-top: 3rem;
  }
  .axe-bloc__meta {
    margin: 0;
    font-family: var(--chrome);
    font-size: 0.6875rem;
    color: var(--parchemin-faible);
  }
  .carte--courant .carte__titre {
    gap: 0.6rem;
  }

  /* ------------------------------------------------------------- atelier */

  .atelier-courants {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 70;
    max-height: min(82svh, 780px);
    display: flex;
    flex-direction: column;
    background: var(--verre);
    backdrop-filter: var(--flou);
    border-top: 1px solid var(--or-sourd);
    border-radius: var(--rayon) var(--rayon) 0 0;
    box-shadow: var(--ombre);
  }
  .atelier-courants[hidden] {
    display: none;
  }
  .atelier-courants__tete {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--trait);
  }
  .atelier-courants__tete .etiquette {
    color: var(--or);
  }
  .atelier-courants__tete .fermer {
    position: static;
    margin-left: auto;
  }
  .atelier-etat {
    font-family: var(--chrome);
    font-size: 0.6875rem;
    color: var(--parchemin-faible);
  }

  .atelier-courants__grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--trait);
    overflow: hidden;
  }
  .colonne {
    background: var(--encre-2);
    padding: 1rem 1.15rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-height: 0;
    max-height: min(70svh, 660px);
    overflow-y: auto;
  }
  .colonne > .etiquette {
    color: var(--or);
  }
  .colonne__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .colonne__liste button {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
