---
/**
 * La fiche d'un courant : ce qu'il est, et qui le professe.
 *
 * Le texte est celui que Romain a saisi dans l'atelier — jamais un résumé
 * écrit ici. Sans texte, la page l'annonce plutôt que de meubler.
 */
import Base from '../../layouts/Base.astro';
import { lirePolitique, libelleCible, adherentsDe } from '../../lib/politique';
import { listerLieux } from '../../lib/stockage';
import { markdownCourt } from '../../lib/blocs.js';
import {
  etats, provinces, burgs, cultures, religions, nomAffiche, lien, nombre,
} from '../../lib/monde';

export const prerender = false;

const politique = await lirePolitique(Astro.locals);
const courant = politique.courants.find((c) => c.slug === Astro.params.slug);
if (!courant) return Astro.rewrite('/404');

const axe = politique.axes.find((a) => a.id === courant.axeId);
const freres = politique.courants
  .filter((c) => c.axeId === courant.axeId && c.id !== courant.id)
  .sort((a, b) => a.ordre - b.ordre);

const lieux = await listerLieux(Astro.locals);

/** De la clé `etat:3` au nom et à l'adresse de la fiche. */
function resoudre(cle: string): { nom: string; href: string } | null {
  const [type, id] = cle.split(':');
  if (type === 'etat') {
    const e = etats.find((x) => String(x.id) === id);
    return e ? { nom: e.nomComplet, href: lien('etat', e.slug) } : null;
  }
  if (type === 'province') {
    const p = provinces.find((x) => String(x.id) === id);
    return p ? { nom: p.nomComplet, href: lien('province', p.slug) } : null;
  }
  if (type === 'burg') {
    const b = burgs.find((x) => String(x.id) === id);
    return b ? { nom: nomAffiche(b.nom), href: lien('burg', b.slug) } : null;
  }
  if (type === 'culture') {
    const c = cultures.find((x) => String(x.id) === id);
    return c ? { nom: c.nom, href: lien('culture', c.slug) } : null;
  }
  if (type === 'religion') {
    const r = religions.find((x) => String(x.id) === id);
    return r ? { nom: r.nom, href: lien('religion', r.slug) } : null;
  }
  if (type === 'lieu') {
    const l = lieux.find((x) => x.id === id);
    return l ? { nom: l.nom, href: lien('lieu', l.slug) } : null;
  }
  return null;
}

/** Les adhérents, groupés par type d'entité. */
const groupes = new Map<string, { nom: string; href: string; part?: number }[]>();
for (const adhesion of adherentsDe(politique, courant.id)) {
  const resolu = resoudre(adhesion.entite);
  if (!resolu) continue;
  const type = adhesion.entite.split(':')[0];
  if (!groupes.has(type)) groupes.set(type, []);
  groupes.get(type)!.push({ ...resolu, part: adhesion.part });
}

const total = [...groupes.values()].reduce((n, l) => n + l.length, 0);
---

<Base titre={courant.nom} description={`${courant.nom} — ${axe?.nom ?? 'courant'} du monde de Victorum.`}>
  <div class="contenant">
    <header class="cartouche courant-tete">
      <i class="courant__marque courant__marque--grand" style={`--teinte:${courant.couleur}`}>
        {courant.symbole}
      </i>
      <div>
        <p class="etiquette">
          <a href="/courants">{axe?.nom ?? 'Courant'}</a>
        </p>
        <h1>{courant.nom}</h1>
      </div>
    </header>

    <div class="courant-corps">
      <div class="pile">
        {
          courant.resume ? (
            <div class="prose" set:html={markdownCourt(courant.resume)} />
          ) : (
            <div class="a-ecrire">
              <p class="etiquette">Sans texte</p>
              <p>
                Ce courant n'a pas encore de description. Ouvre l'atelier depuis la page
                des courants pour l'écrire.
              </p>
            </div>
          )
        }

        {
          total === 0 ? (
            <p class="discret">Personne ne le professe encore.</p>
          ) : (
            [...groupes].map(([type, liste]) => (
              <section class="pile">
                <h2 class="etiquette etiquette--filet">{libelleCible(type)}</h2>
                <div class="grille">
                  {liste.map((e) => (
                    <a class="carte" href={e.href}>
                      <span class="carte__titre">{e.nom}</span>
                      {e.part !== undefined && (
                        <span class="carte__meta">{e.part} % de soutien</span>
                      )}
                    </a>
                  ))}
                </div>
              </section>
            ))
          )
        }
      </div>

      <aside class="pile">
        <div class="identite">
          <p class="etiquette">Fiche d'identité</p>
          <dl>
            <div class="identite__ligne"><dt>Axe</dt><dd>{axe?.nom ?? '—'}</dd></div>
            <div class="identite__ligne"><dt>Adhérents</dt><dd>{nombre(total)}</dd></div>
            {
              axe && (
                <div class="identite__ligne">
                  <dt>Portée</dt>
                  <dd>{axe.cibles.map((c) => libelleCible(c)).join(', ')}</dd>
                </div>
              )
            }
          </dl>
        </div>

        {
          freres.length > 0 && (
            <div class="identite">
              <p class="etiquette">Les autres courants de cet axe</p>
              <ul class="courants__liste" style="margin-top:.8rem">
                {freres.map((f) => (
                  <li class="courant">
                    <span class="courant__marque" style={`--teinte:${f.couleur}`}>{f.symbole}</span>
                    <a class="courant__nom" href={`/courants/${f.slug}`}>{f.nom}</a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</Base>

<style is:global>
  .courant-tete {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .courant__marque--grand {
    width: 74px;
    height: 74px;
    font-size: 2rem;
    flex: none;
  }
  .courant-corps {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 2rem;
    margin-top: 2.5rem;
  }
  @media (max-width: 860px) {
    .courant-corps {
      grid-template-columns: 1fr;
    }
  }
</style>
