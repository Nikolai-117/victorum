---
import Base from '../layouts/Base.astro';
import { monde } from '../lib/monde';
---

<Base titre="Atlas" description={`Carte interactive de ${monde.nom}`} pleinEcran>
  <div class="scene">
    <svg
      id="carte"
      viewBox={`0 0 ${monde.largeur} ${monde.hauteur}`}
      preserveAspectRatio="xMidYMid meet"
      role="application"
      aria-label={`Carte de ${monde.nom}`}
    >
      <defs id="defs-carte"></defs>
      <g id="zoom">
        <g id="couches"></g>
        <g id="surbrillance"></g>
        <g id="reperes"></g>
      </g>
    </svg>

    <div id="progression" class="progression"><i></i></div>

    <button id="bascule-rail" class="bascule-rail" aria-label="Afficher les réglages">☰</button>

    <aside class="rail" id="rail">
      <div class="rail__bloc">
        <label class="etiquette" for="recherche">Rechercher</label>
        <input
          id="recherche"
          type="search"
          autocomplete="off"
          placeholder="Ville, royaume, lieu…"
          aria-describedby="aide-recherche"
        />
        <p id="aide-recherche" class="aide">Touche <kbd>/</kbd> pour chercher, <kbd>Échap</kbd> pour fermer.</p>
        <ul id="resultats" class="resultats" role="listbox" aria-label="Résultats"></ul>
      </div>

      <div class="rail__bloc" id="bloc-mode" hidden>
        <p class="etiquette">Mode de carte</p>
        <select id="mode-carte" class="select" aria-label="Colorer la carte par">
          <option value="">Royaumes</option>
        </select>
        <ul class="legende" id="legende-mode"></ul>
      </div>

      <div class="rail__bloc">
        <p class="etiquette">Couches</p>
        <div id="couches-controles" class="controles"></div>
      </div>

      <div class="rail__bloc">
        <p class="etiquette">Lieux</p>
        <p class="aide" id="lieux-compte">Aucun lieu posé pour l'instant.</p>
        <select id="filtre-categorie" class="select" aria-label="Filtrer par nature" hidden>
          <option value="">Toutes les natures</option>
        </select>
        <label class="controle" id="bascule-lieux" hidden>
          <input type="checkbox" id="afficher-reperes" checked />
          <span>Afficher les lieux</span>
        </label>
        <button id="placer-lieu" class="bouton" type="button">Placer un lieu</button>
      </div>

      <div class="rail__bloc">
        <button id="reinit" class="bouton" type="button">Recadrer la vue</button>
      </div>
    </aside>

    <!-- Fiche de pose d'un lieu : nom, nature, icône, couleur. -->
    <aside class="lieu-editeur" id="lieu-editeur" hidden>
      <div class="lieu-editeur__tete">
        <p class="etiquette" id="lieu-editeur-titre">Nouveau lieu</p>
        <button class="fermer" type="button" data-lieu="annuler" aria-label="Fermer">×</button>
      </div>

      <label class="champ">
        <span>Nom</span>
        <input id="lieu-nom" type="text" maxlength="120" placeholder="Le Gouffre de Selenor" />
      </label>

      <label class="champ">
        <span>Nature</span>
        <input id="lieu-categorie" type="text" maxlength="60" list="natures-lieu" placeholder="Donjon" />
      </label>
      <datalist id="natures-lieu">
        <option value="Donjon"></option>
        <option value="Ruines"></option>
        <option value="Sanctuaire"></option>
        <option value="Champ de bataille"></option>
        <option value="Repaire"></option>
        <option value="Passage"></option>
        <option value="Cité perdue"></option>
        <option value="Curiosité"></option>
        <option value="Relais"></option>
        <option value="Mine"></option>
      </datalist>

      <p class="etiquette">Icône</p>
      <div class="palette" id="lieu-icones" role="radiogroup" aria-label="Icône du lieu"></div>

      <p class="etiquette">Couleur</p>
      <div class="palette-couleurs" id="lieu-couleurs" role="radiogroup" aria-label="Couleur du lieu">
        <input type="color" id="lieu-couleur-libre" value="#c9a227" aria-label="Couleur libre" />
      </div>

      <p class="aide" id="lieu-message"></p>

      <div class="lieu-editeur__actions">
        <button class="bouton bouton--or" type="button" data-lieu="enregistrer">Enregistrer</button>
        <button class="bouton" type="button" data-lieu="supprimer" hidden>Supprimer</button>
      </div>
    </aside>

    <!-- Le panneau d'un clic : ce qu'on sait de l'entité sans quitter la carte. -->
    <aside class="panneau" id="panneau" hidden>
      <span class="panneau__accent"></span>
      <button id="fermer-panneau" class="fermer" aria-label="Fermer">×</button>

      <header class="panneau__tete">
        <div class="panneau__ecusson" id="panneau-ecusson" aria-hidden="true"></div>
        <div class="panneau__intitule">
          <p class="etiquette" id="panneau-categorie"></p>
          <h2 id="panneau-titre"></h2>
          <p class="panneau__rattachement" id="panneau-rattachement"></p>
        </div>
      </header>

      <ul class="panneau__traits" id="panneau-traits"></ul>

      <div class="panneau__nation" id="panneau-nation"></div>

      <ul class="panneau__courants" id="panneau-courants"></ul>

      <div class="panneau__grille" id="panneau-grille"></div>

      <div class="panneau__barres" id="panneau-barres"></div>

      <div class="panneau__pied">
        <a id="panneau-lien" class="bouton bouton--plein" href="#">Ouvrir la fiche</a>
        <button id="panneau-centrer" class="bouton" type="button">Centrer sur la carte</button>
      </div>
    </aside>

    <!-- Le mode d'emploi, toujours sous les yeux, jamais dans le chemin. -->
    <p class="commandes">
      <span><b>Clic</b> renseigne</span>
      <span><b>Double-clic</b> ouvre la fiche</span>
      <span><b>Glisser</b> déplace</span>
      <span><b>Molette</b> agrandit</span>
      <span><b>Échap</b> ferme</span>
    </p>

    <div class="jauge">
      <div class="jauge__barre"><span id="jauge-trait"></span></div>
      <span class="chiffre" id="jauge-texte">—</span>
      <span class="jauge__zoom chiffre" id="jauge-zoom">×1</span>
    </div>
  </div>
</Base>

<style is:global>
  .scene {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: var(--encre);
  }

  /* Vignettage : concentre l'œil au centre sans toucher au SVG. */
  .scene::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 58%, rgba(90, 60, 50, 0.16) 100%);
  }

  #carte {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
    /* Sans cela, glisser la carte surligne les noms de villes et de royaumes
       comme du texte ordinaire : le navigateur croit à une sélection. */
    user-select: none;
    -webkit-user-select: none;
  }
  #carte.saisi {
    cursor: grabbing;
  }
  /* Pendant l'interaction, on privilégie la fluidité à la finesse du tracé. */
  #carte.saisi #zoom {
    shape-rendering: optimizeSpeed;
    text-rendering: optimizeSpeed;
  }
  #zoom {
    will-change: transform;
  }

  #reperes text {
    cursor: pointer;
    text-anchor: middle;
    dominant-baseline: central;
    paint-order: stroke;
    stroke: rgba(0, 0, 0, 0.6);
    stroke-width: 0.25px;
  }

  /* La cible choisie : un cercle net, doublé d'une onde qui s'éteint. */
  #surbrillance {
    pointer-events: none;
  }
  #surbrillance .marque--onde {
    transform-box: fill-box;
    transform-origin: center;
    animation: onde 1.9s ease-out infinite;
  }
  @keyframes onde {
    from {
      opacity: 0.65;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3.4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #surbrillance .marque--onde {
      display: none;
    }
  }

  /* ------------------------------------------------------------ progression */

  .progression {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 70;
    pointer-events: none;
  }
  .progression i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--or);
    transition: width 0.3s ease-out, opacity 0.4s;
  }

  /* ---------------------------------------------------- panneaux d'instrument */

  /**
   * Des plaques de verre posées sur la carte, jamais collées aux bords. Les
   * mires d'angle d'avant faisaient viseur de vaisseau spatial ; l'atlas n'en
   * demandait pas tant.
   */
  .rail,
  .panneau,
  .jauge,
  .lieu-editeur,
  .commandes {
    background: var(--verre);
    backdrop-filter: var(--flou);
    border: 1px solid var(--trait);
    border-radius: var(--rayon);
    box-shadow: var(--ombre), var(--lueur);
  }

  /* -------------------------------------------------------------------- rail */

  .rail {
    position: absolute;
    top: 4.7rem;
    left: 1.1rem;
    width: 296px;
    max-height: calc(100% - 5.8rem);
    overflow-y: auto;
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .rail__bloc {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .rail__bloc > .etiquette {
    color: var(--or);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--trait);
  }

  #recherche {
    width: 100%;
    padding: 0.5rem 0.75rem;
    background: var(--saisie);
    border: 1px solid var(--trait);
    border-radius: var(--pilule);
    color: var(--parchemin);
    font-family: var(--chrome);
    font-size: 0.8125rem;
  }
  #recherche::placeholder {
    color: var(--parchemin-faible);
  }
  #recherche:focus {
    outline: none;
    border-color: var(--or-sourd);
    background: var(--saisie);
  }

  .aide {
    margin: 0;
    font-family: var(--chrome);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--parchemin-faible);
  }
  kbd {
    font-family: var(--chrome);
    font-size: 0.6875rem;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-xs);
    background: var(--saisie);
    padding: 0.1em 0.35em;
  }

  .resultats {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 250px;
    overflow-y: auto;
  }
  .resultats li button {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.6rem;
    background: none;
    border: 0;
    border-radius: var(--rayon-s);
    color: var(--parchemin);
    font-family: var(--texte-police);
    font-size: 1.0625rem;
    text-align: left;
    cursor: pointer;
  }
  .resultats li button:hover,
  .resultats li button:focus-visible {
    background: var(--velin-haut);
    color: var(--or-clair);
    outline: none;
  }
  .resultats small {
    color: var(--parchemin-faible);
    font-family: var(--chrome);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .controles {
    display: flex;
    flex-direction: column;
  }

  .controle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--chrome);
    font-size: 0.75rem;
    padding: 0.26rem 0.4rem;
    border-radius: var(--rayon-xs);
    cursor: pointer;
    color: var(--parchemin-doux);
  }
  .controle:hover {
    color: var(--parchemin);
    background: rgba(70, 62, 58, 0.05);
  }
  .controle input {
    accent-color: var(--or);
    flex: none;
  }
  .controle .poids {
    margin-left: auto;
    font-family: var(--chrome);
    font-size: 0.5625rem;
    color: var(--parchemin-faible);
  }

  .select {
    width: 100%;
    padding: 0.42rem 0.6rem;
    background: var(--saisie);
    color: var(--parchemin);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-s);
    font-family: var(--chrome);
    font-size: 0.75rem;
  }

  .bascule-rail {
    display: none;
    position: absolute;
    top: 4.7rem;
    left: 1.1rem;
    z-index: 5;
    width: 42px;
    height: 42px;
    border: 1px solid var(--trait);
    border-radius: var(--pilule);
    background: var(--verre);
    backdrop-filter: var(--flou);
    box-shadow: var(--ombre-basse);
    color: var(--parchemin);
    font-size: 1.05rem;
    cursor: pointer;
  }

  /* ---------------------------------------------------------------- panneau */

  .panneau {
    position: absolute;
    top: 4.7rem;
    right: 1.1rem;
    width: 348px;
    max-height: calc(100% - 5.8rem);
    overflow-y: auto;
    padding: 1.35rem 1.3rem 1.2rem;
    /* La teinte de l'entité choisie irrigue le panneau : filet, écusson, jauges.
       Éclaircie pour l'affichage : le pourpre d'un royaume, posé tel quel sur
       ce noir, ne se verrait pas. */
    --teinte: var(--or);
    --teinte-vive: color-mix(in srgb, var(--teinte) 60%, #2a2420);
    animation: panneau-entree 0.22s ease-out;
  }
  .panneau[hidden] {
    display: none;
  }
  @keyframes panneau-entree {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panneau {
      animation: none;
    }
  }

  /* Un filet de couleur en tête : celle du royaume, ou celle du lieu posé. */
  .panneau__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--teinte-vive);
    box-shadow: 0 0 16px color-mix(in srgb, var(--teinte-vive) 45%, transparent);
  }

  .panneau__tete {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding-right: 1.6rem;
    margin-bottom: 0.85rem;
  }
  .panneau__ecusson {
    flex: none;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-s);
    background:
      radial-gradient(circle at 50% 26%, color-mix(in srgb, var(--teinte-vive) 26%, transparent), transparent 72%),
      var(--encre-2);
    color: var(--teinte-vive);
    font-size: 1.6rem;
    line-height: 1;
  }
  .panneau__ecusson img {
    display: block;
    width: 48px;
    height: 48px;
  }
  .panneau__intitule {
    min-width: 0;
  }
  .panneau__intitule .etiquette {
    color: var(--teinte-vive);
    font-size: 0.625rem;
    letter-spacing: 0.15em;
  }
  .panneau h2 {
    font-size: 1.5rem;
    margin: 0.2rem 0 0;
    line-height: 1.05;
  }
  /* Où l'on se trouve, dit en une ligne, et cliquable de bout en bout. */
  .panneau__rattachement {
    margin: 0.32rem 0 0;
    font-size: 1rem;
    color: var(--parchemin-doux);
    line-height: 1.35;
  }
  .panneau__rattachement:empty {
    display: none;
  }
  .panneau__rattachement .sep {
    color: var(--trait-vif);
    margin: 0 0.35rem;
  }

  /* La légende du mode de carte : une pastille, un nom, un compte. */
  .legende {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .legende:empty {
    display: none;
  }
  .legende li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--chrome);
    font-size: 0.6875rem;
    color: var(--parchemin-doux);
  }
  .legende i {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6) inset;
  }
  .legende small {
    margin-left: auto;
    color: var(--parchemin-faible);
  }

  /* Le régime de la nation, et les doctrines qu'elle tient. */
  .panneau__nation {
    margin-bottom: 0.95rem;
  }
  .panneau__nation:empty {
    display: none;
  }
  .panneau__regime {
    margin: 0 0 0.5rem;
    font-family: var(--display);
    font-size: 1.15rem;
    color: var(--parchemin);
  }
  .panneau__nation .doctrines {
    margin-top: 0;
  }
  .panneau__devise {
    margin: 0.6rem 0 0;
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--parchemin-doux);
  }
  .panneau__cour {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.28rem 0.9rem;
    margin: 0.7rem 0 0;
  }
  .panneau__cour dt {
    font-family: var(--chrome);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--parchemin-faible);
    align-self: center;
  }
  .panneau__cour dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--parchemin-doux);
  }

  /* Ce que l'entité professe, sous son nom. */
  .panneau__courants {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0 0 0.95rem;
    padding: 0;
  }
  .panneau__courants:empty {
    display: none;
  }
  .panneau__courants li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: var(--parchemin-doux);
  }
  .panneau__courants .marque-courant {
    width: 22px;
    height: 22px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 0.75rem;
    line-height: 1;
    color: color-mix(in srgb, var(--teinte-courant) 65%, #2a2420);
    background: color-mix(in srgb, var(--teinte-courant) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--teinte-courant) 45%, transparent);
  }
  .panneau__courants .part {
    margin-left: auto;
    font-family: var(--chrome);
    font-size: 0.6875rem;
    color: var(--parchemin-faible);
  }
  .panneau__courants .axe {
    font-family: var(--chrome);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--parchemin-faible);
  }

  /* Ce qu'une ville a de remarquable, un mot par jeton. */
  .panneau__traits {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0 0 0.95rem;
    padding: 0;
  }
  .panneau__traits:empty {
    display: none;
  }
  .panneau__traits li {
    font-family: var(--chrome);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--parchemin-doux);
    background: rgba(70, 62, 58, 0.05);
    border: 1px solid var(--trait);
    border-radius: var(--pilule);
    padding: 0.16rem 0.6rem;
  }

  /* Les chiffres en casiers : un instrument, pas un paragraphe. */
  /**
    * Les chiffres se lisent en colonnes, séparés par de l'air plutôt que par
    * des cases : une grille de cellules bordées faisait tableau de bord.
    */
  .panneau__grille {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1.1rem;
    row-gap: 0.9rem;
    margin: 0 0 1.1rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--trait);
  }
  .panneau__grille:empty {
    display: none;
  }
  .panneau__casier {
    min-width: 0;
  }
  /* Un casier seul sur sa ligne occupe toute la largeur. */
  .panneau__casier--large {
    grid-column: 1 / -1;
  }
  .panneau__casier dt {
    font-family: var(--chrome);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--parchemin-faible);
  }
  .panneau__casier dd {
    margin: 0.1rem 0 0;
    font-size: 1.125rem;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  /* Le classement passe à la ligne : accolé, il faisait respirer la grille
     à contretemps, chaque casier changeant de hauteur selon sa longueur. */
  .panneau__casier dd small {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.6875rem;
    line-height: 1.3;
    color: var(--parchemin-faible);
  }
  /* Un nom qui mène ailleurs : bouton nu, souligné comme un lien du site. */
  .panneau__casier button,
  .panneau__rattachement button {
    border: 0;
    padding: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    background-image: linear-gradient(var(--or-sourd), var(--or-sourd));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
  }
  .panneau__casier button:hover,
  .panneau__casier button:focus-visible,
  .panneau__rattachement button:hover,
  .panneau__rattachement button:focus-visible {
    color: var(--or-clair);
    outline: none;
    background-image: linear-gradient(var(--or), var(--or));
  }

  /* Les proportions : ce que les chiffres seuls ne montrent pas. */
  .panneau__barres {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.1rem;
  }
  .panneau__barres:empty {
    display: none;
  }
  .panneau__barre-tete {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--chrome);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--parchemin-faible);
    margin-bottom: 0.3rem;
  }
  .panneau__barre-tete b {
    font-family: var(--chrome);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--parchemin-doux);
  }
  .panneau__barre-fond {
    height: 3px;
    background: rgba(70, 62, 58, 0.09);
    border-radius: var(--pilule);
    overflow: hidden;
  }
  .panneau__barre-fond i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--pilule);
    background: linear-gradient(90deg, var(--teinte-vive), var(--or-clair));
    transition: width 0.45s ease-out;
  }

  .panneau__pied {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--trait);
  }
  .panneau__pied .bouton {
    justify-content: center;
    padding: 0.52rem 0.9rem;
    font-size: 0.75rem;
  }
  /* Le geste principal se voit du premier coup d'œil. */
  .bouton--plein {
    background: var(--or);
    border-color: var(--or);
    color: #ffffff;
  }
  .bouton--plein:hover {
    background: var(--or-clair);
    border-color: var(--or-clair);
    color: #ffffff;
  }

  /* ------------------------------------------------------------- commandes */

  .commandes {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
