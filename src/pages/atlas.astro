  }
  .commandes b {
    font-weight: 500;
    color: var(--parchemin-doux);
    margin-right: 0.3rem;
  }
  /* Sous cette largeur, l'échelle et les plaques se disputent la place :
     le rappel des commandes s'efface plutôt que de chevaucher. */
  @media (max-width: 1400px) {
    .commandes {
      display: none;
