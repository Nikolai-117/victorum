</style>

<script>
  import { AXES, AXE_PAR_ID, regimeDeduit, doctrinesRetenues } from '../lib/doctrines';

  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.getElementById('carte');
  const gZoom = document.getElementById('zoom');
  const gCouches = document.getElementById('couches');
  const gReperes = document.getElementById('reperes');
  const gSurbrillance = document.getElementById('surbrillance');
  const defs = document.getElementById('defs-carte');
  const progression = document.querySelector('#progression i');

  const serrer = (v, min, max) => Math.min(max, Math.max(min, v));
  let dimensions = { largeur: 1920, hauteur: 919 };
  let kmParPixel = 3;

  /* ------------------------------------------------------------ vue et zoom */

  const vue = { k: 1, x: 0, y: 0 };
  const ZOOM_MIN = 0.85;
  const ZOOM_MAX = 90;

  /** Échelle appliquée par le navigateur entre le viewBox et les pixels écran. */
  const echelleEcran = () => svg.getScreenCTM()?.a || 1;

  function appliquer() {
    const { largeur, hauteur } = dimensions;
    // On empêche la carte de sortir complètement du champ.
    const gardeX = Math.min(240, largeur * vue.k * 0.5);
    const gardeY = Math.min(240, hauteur * vue.k * 0.5);
    vue.x = serrer(vue.x, gardeX - largeur * vue.k, largeur - gardeX);
    vue.y = serrer(vue.y, gardeY - hauteur * vue.k, hauteur - gardeY);

    gZoom.setAttribute('transform', `translate(${vue.x} ${vue.y}) scale(${vue.k})`);
    majTailleLieux();
    gSurbrillance.style.strokeWidth = `${2 / vue.k}px`;
    majJauge();
  }

  function zoomerVers(px, py, facteur) {
    const k = serrer(vue.k * facteur, ZOOM_MIN, ZOOM_MAX);
    vue.x = px - ((px - vue.x) / vue.k) * k;
    vue.y = py - ((py - vue.y) / vue.k) * k;
    vue.k = k;
    appliquer();
  }

  /** Coordonnées du pointeur dans le repère du viewBox (avant transformation). */
  function pointeur(ev) {
    const ctm = svg.getScreenCTM();
    if (!ctm) return { x: 0, y: 0 };
    const p = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(ctm.inverse());
    return { x: p.x, y: p.y };
  }

  let minuteurInteraction;
  function marquerInteraction() {
    svg.classList.add('saisi');
    clearTimeout(minuteurInteraction);
    minuteurInteraction = setTimeout(() => svg.classList.remove('saisi'), 220);
  }

  svg.addEventListener(
    'wheel',
    (ev) => {
      ev.preventDefault();
      const p = pointeur(ev);
      marquerInteraction();
      zoomerVers(p.x, p.y, Math.exp(-ev.deltaY * 0.0016));
    },
    { passive: false }
  );

  // Déplacement et pincement : un seul jeu de pointeurs pour souris et tactile.
  const pointeurs = new Map();
  let glisse = null;
  let pincement = null;

  svg.addEventListener('pointerdown', (ev) => {
    if (ev.pointerType === 'mouse' && ev.button !== 0) return;
    // La capture échoue si le pointeur n'est plus actif : sans garde, le
    // déplacement de la carte serait perdu au lieu d'être simplement moins fluide.
    try {
      svg.setPointerCapture(ev.pointerId);
    } catch {}
    pointeurs.set(ev.pointerId, { x: ev.clientX, y: ev.clientY });

    if (pointeurs.size === 1) {
      glisse = { sx: ev.clientX, sy: ev.clientY, vx: vue.x, vy: vue.y, bouge: false };
      svg.classList.add('saisi');
    } else if (pointeurs.size === 2) {
      glisse = null;
      const [a, b] = [...pointeurs.values()];
      pincement = {
        distance: Math.hypot(a.x - b.x, a.y - b.y),
        milieu: pointeur({ clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 }),
        k: vue.k,
      };
    }
  });

  svg.addEventListener('pointermove', (ev) => {
    if (!pointeurs.has(ev.pointerId)) return;
    pointeurs.set(ev.pointerId, { x: ev.clientX, y: ev.clientY });

    if (pincement && pointeurs.size === 2) {
      const [a, b] = [...pointeurs.values()];
      const distance = Math.hypot(a.x - b.x, a.y - b.y);
      if (pincement.distance > 0) {
        const k = serrer((pincement.k * distance) / pincement.distance, ZOOM_MIN, ZOOM_MAX);
        const m = pincement.milieu;
        vue.x = m.x - ((m.x - vue.x) / vue.k) * k;
        vue.y = m.y - ((m.y - vue.y) / vue.k) * k;
        vue.k = k;
        marquerInteraction();
        appliquer();
      }
      return;
    }

    if (!glisse) return;
    const s = echelleEcran();
    const dx = ev.clientX - glisse.sx;
    const dy = ev.clientY - glisse.sy;
    if (Math.abs(dx) + Math.abs(dy) > 3) glisse.bouge = true;
    vue.x = glisse.vx + dx / s;
    vue.y = glisse.vy + dy / s;
    appliquer();
  });

  function relacher(ev) {
    pointeurs.delete(ev.pointerId);
    if (pointeurs.size < 2) pincement = null;
    if (pointeurs.size === 0) {
      svg.classList.remove('saisi');
      if (glisse && !glisse.bouge) traiterClic(ev);
      glisse = null;
    }
  }
  svg.addEventListener('pointerup', relacher);
  svg.addEventListener('pointercancel', relacher);

  // Le double-clic est traité plus bas, avec la sélection : selon ce qu'il
  // vise, il agrandit la vue ou entre dans la fiche.

  /* ------------------------------------------------------------- chargement */

  let manifeste = null;
  let index = [];

  async function fragment(url) {
    const reponse = await fetch(url);
    if (!reponse.ok) throw new Error(`${url} : ${reponse.status}`);
    const texte = await reponse.text();
    const doc = new DOMParser().parseFromString(texte, 'image/svg+xml');
    if (doc.querySelector('parsererror')) throw new Error(`${url} : SVG illisible`);
    return doc.documentElement.firstElementChild;
  }

  let chargees = 0;
  let aCharger = 1;
  function avancer() {
    chargees++;
    const pct = Math.min(100, Math.round((chargees / aCharger) * 100));
    progression.style.width = `${pct}%`;
    if (pct >= 100) setTimeout(() => (progression.style.opacity = '0'), 400);
  }

  async function chargerCouche(id) {
    const hote = gCouches.querySelector(`[data-couche="${id}"]`);
    if (!hote || hote.dataset.charge === 'oui') return;
    hote.dataset.charge = 'encours';
    try {
      const noeud = await fragment(`/carte/couches/${id}.svg`);
      if (noeud) hote.appendChild(document.importNode(noeud, true));
      hote.dataset.charge = 'oui';
    } catch (err) {
      hote.dataset.charge = 'non';
      console.error(err);
    }
  }

  async function demarrer() {
    manifeste = await (await fetch('/carte/manifeste.json')).json();
    dimensions = { largeur: manifeste.largeur, hauteur: manifeste.hauteur };

    const parDefaut = manifeste.couches.filter((c) => c.parDefaut);
    aCharger = parDefaut.length + 1;

    // Les définitions (tracés de côtes, symboles, filtres) conditionnent le
    // rendu de presque toutes les couches : elles passent en premier.
    const noeudDefs = await fragment('/carte/couches/_defs.svg');
    if (noeudDefs) defs.appendChild(document.importNode(noeudDefs, true));
    avancer();

    // Emplacements créés dans l'ordre du manifeste pour figer la superposition,
    // quel que soit l'ordre d'arrivée des téléchargements.
    for (const c of manifeste.couches) {
      const g = document.createElementNS(NS, 'g');
      g.dataset.couche = c.id;
      if (!c.parDefaut) g.style.display = 'none';
      gCouches.appendChild(g);
    }

    construireControles();
    await Promise.all(parDefaut.map((c) => chargerCouche(c.id).then(avancer)));

    index = await (await fetch('/carte/index.json')).json();
    await Promise.all([chargerLieux(), chargerPolitique()]);
    appliquer();
    ouvrirLaDemande();
  }

  /* --------------------------------------------------------------- couches */

  function construireControles() {
    const hote = document.getElementById('couches-controles');
    hote.innerHTML = '';
    for (const c of manifeste.couches) {
      const label = document.createElement('label');
      label.className = 'controle';
      const poids = c.octets > 102400 ? `${Math.round(c.octets / 1024)} Ko` : '';
      label.innerHTML =
        `<input type="checkbox" data-couche="${c.id}"${c.parDefaut ? ' checked' : ''}>` +
        `<span></span><span class="poids">${poids}</span>`;
      label.querySelector('span').textContent = c.libelle;
      label.querySelector('input').addEventListener('change', async (ev) => {
        const actif = ev.target.checked;
        const g = gCouches.querySelector(`[data-couche="${c.id}"]`);
        if (actif) {
          g.style.display = '';
          await chargerCouche(c.id);
        } else {
          g.style.display = 'none';
        }
        if (c.id === 'provinces') gCouches.classList.toggle('provinces-visibles', actif);
        // Une couche fraîchement chargée n'a pas les teintes du mode en cours.
        if (actif && modeCourant) appliquerMode(modeCourant);
      });
      hote.appendChild(label);
    }
  }

  /* -------------------------------------------------------------- lieux */

  /**
   * Les lieux ne viennent plus de la carte d'Azgaar, qui en produisait des
   * centaines d'identiques. Ce sont ceux que Romain pose lui-même : nom,
   * nature, icône et couleur, enregistrés sur le site.
   */
  let lieux = [];
  let stockageActif = false;
  let modePose = false;
  let lieuEnCours = null; // le lieu que la fiche de pose est en train d'éditer

  const ICONES = [
    '🏰','🏛️','🗼','⛪','🏚️','🛖','⚓','🌉','⛲','🚪',
    '⛰️','🌋','🌲','🌳','🏝️','🏜️','💧','❄️','🕳️','🪨',
    '⚔️','🛡️','🏹','🪓','🔥','💀','⚰️','🩸','🏴','⛓️',
    '🔮','✨','🌙','⭐','👁️','🕯️','📜','🗝️','⚗️','🔱',
    '🐉','🐺','🦅','🐍','🕷️','🐗','🦌','🐎','🦉','🐟',
    '💰','⚒️','🍺','🧭','📖','🎭','🎣','🌾','⚖️','📍',
  ];

  const COULEURS = [
    '#c9a227','#9a4034','#55786a','#5b9cd6','#651179',
    '#b06a2c','#7c8aa0','#3f7d3f','#a8477f','#e9dfcb',
  ];

  /** Toutes les entités cherchables : celles de la carte et les lieux posés. */
  const repertoire = () => [...index, ...lieux.map(entreeLieu)];

  async function chargerLieux() {
    try {
      const reponse = await fetch('/api/lieux');
      const donnees = await reponse.json();
      lieux = Array.isArray(donnees.lieux) ? donnees.lieux : [];
      stockageActif = Boolean(donnees.stockageActif);
    } catch {
      lieux = [];
    }
    dessinerLieux();
    majRailLieux();
  }

  function dessinerLieux() {
    gReperes.innerHTML = '';
    const choix = document.getElementById('filtre-categorie').value;
    const morceaux = document.createDocumentFragment();

    for (const l of lieux) {
      if (choix && l.categorie !== choix) continue;
      const groupe = document.createElementNS(NS, 'g');
      groupe.setAttribute('class', 'lieu');
      groupe.dataset.lieu = l.id;
      groupe.dataset.x = l.x;
      groupe.dataset.y = l.y;

      const fond = document.createElementNS(NS, 'circle');
      fond.setAttribute('class', 'lieu__fond');
      fond.setAttribute('r', '7');
      fond.setAttribute('fill', l.couleur);

      const icone = document.createElementNS(NS, 'text');
      icone.setAttribute('class', 'lieu__icone');
      icone.textContent = l.icone;

      groupe.append(fond, icone);
      morceaux.appendChild(groupe);
    }
    gReperes.appendChild(morceaux);
    majTailleLieux();
  }

  /** Les lieux gardent leur taille à l'écran, quel que soit l'agrandissement. */
  function majTailleLieux() {
    const echelle = 1 / vue.k;
    for (const groupe of gReperes.children) {
      groupe.setAttribute(
        'transform',
        `translate(${groupe.dataset.x} ${groupe.dataset.y}) scale(${echelle})`
      );
    }
  }

  function majRailLieux() {
    const compte = document.getElementById('lieux-compte');
    const select = document.getElementById('filtre-categorie');
    const bascule = document.getElementById('bascule-lieux');

    compte.textContent = lieux.length
      ? `${lieux.length} lieu${lieux.length > 1 ? 'x' : ''} posé${lieux.length > 1 ? 's' : ''}.`
      : "Aucun lieu posé pour l'instant. Clique « Placer un lieu », puis sur la carte.";

    const natures = [...new Set(lieux.map((l) => l.categorie))].sort((a, b) => a.localeCompare(b, 'fr'));
    const retenu = select.value;
    select.innerHTML = '<option value="">Toutes les natures</option>';
    for (const n of natures) {
      const option = document.createElement('option');
      option.value = n;
      option.textContent = n;
      if (n === retenu) option.selected = true;
      select.appendChild(option);
    }
    select.hidden = natures.length < 2;
    bascule.hidden = lieux.length === 0;
  }

  document.getElementById('filtre-categorie').addEventListener('change', dessinerLieux);
  document.getElementById('afficher-reperes').addEventListener('change', (ev) => {
    gReperes.style.display = ev.target.checked ? '' : 'none';
  });

  /* --------------------------------------------------------- fiche de pose */

  const editeur = document.getElementById('lieu-editeur');
  const champNom = document.getElementById('lieu-nom');
  const champCategorie = document.getElementById('lieu-categorie');
  const champCouleurLibre = document.getElementById('lieu-couleur-libre');
  const message = document.getElementById('lieu-message');
  let iconeChoisie = ICONES[0];
  let couleurChoisie = COULEURS[0];

  (function construirePalettes() {
    const palette = document.getElementById('lieu-icones');
    for (const emoji of ICONES) {
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.setAttribute('role', 'radio');
      bouton.textContent = emoji;
      bouton.setAttribute('aria-checked', 'false');
      bouton.addEventListener('click', () => choisirIcone(emoji));
      palette.appendChild(bouton);
    }

    const couleurs = document.getElementById('lieu-couleurs');
    for (const teinte of COULEURS) {
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.setAttribute('role', 'radio');
      bouton.style.background = teinte;
      bouton.title = teinte;
      bouton.setAttribute('aria-checked', 'false');
      bouton.addEventListener('click', () => choisirCouleur(teinte));
      couleurs.insertBefore(bouton, champCouleurLibre);
    }
    champCouleurLibre.addEventListener('input', () => choisirCouleur(champCouleurLibre.value));
  })();

  function choisirIcone(emoji) {
    iconeChoisie = emoji;
    for (const b of document.querySelectorAll('#lieu-icones button')) {
      b.setAttribute('aria-checked', String(b.textContent === emoji));
    }
  }

  function choisirCouleur(teinte) {
    couleurChoisie = teinte;
    champCouleurLibre.value = teinte;
    for (const b of document.querySelectorAll('#lieu-couleurs button')) {
      b.setAttribute('aria-checked', String(b.title === teinte));
    }
  }

  function ouvrirEditeur(lieu) {
    lieuEnCours = lieu;
    document.getElementById('lieu-editeur-titre').textContent = lieu.id ? 'Modifier le lieu' : 'Nouveau lieu';
    champNom.value = lieu.nom || '';
    champCategorie.value = lieu.categorie || '';
    choisirIcone(lieu.icone || ICONES[0]);
    choisirCouleur(lieu.couleur || COULEURS[0]);
    document.querySelector('[data-lieu="supprimer"]').hidden = !lieu.id;
    message.textContent = stockageActif ? '' : "Le stockage n'est pas disponible : impossible d'enregistrer.";
    editeur.hidden = false;
    fermerPanneau();
    champNom.focus();
  }

  function fermerEditeur() {
    editeur.hidden = true;
    lieuEnCours = null;
    gReperes.querySelectorAll('.lieu--choisi').forEach((g) => g.classList.remove('lieu--choisi'));
  }

  function basculerPose(actif) {
    modePose = actif;
    svg.classList.toggle('pose', actif);
    const bouton = document.getElementById('placer-lieu');
    bouton.textContent = actif ? 'Annuler la pose' : 'Placer un lieu';
    bouton.classList.toggle('bouton--or', actif);
    if (!actif) fermerEditeur();
  }

  document.getElementById('placer-lieu').addEventListener('click', () => basculerPose(!modePose));

  editeur.addEventListener('click', async (ev) => {
    const action = ev.target.closest('[data-lieu]')?.dataset.lieu;
    if (action === 'annuler') fermerEditeur();
    else if (action === 'enregistrer') await enregistrerLieu();
    else if (action === 'supprimer') await effacerLieu();
  });

  champNom.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter') enregistrerLieu();
  });

  async function envoyerAuSite(corps) {
    const CLE_MDP = 'victorum:mot-de-passe';
    let mdp = sessionStorage.getItem(CLE_MDP);
    if (!mdp) {
      mdp = prompt(
        "Mot de passe de l'atelier. S'il n'en existe pas encore, celui que tu choisis ici devient celui du site."
      );
      if (!mdp) return null;
      sessionStorage.setItem(CLE_MDP, mdp);
    }
    const reponse = await fetch('/api/lieux', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-mot-de-passe': mdp },
      body: JSON.stringify(corps),
    });
    const donnees = await reponse.json().catch(() => ({}));
    if (reponse.status === 401) sessionStorage.removeItem(CLE_MDP);
    if (!reponse.ok) {
      message.textContent = donnees.erreur || 'Enregistrement impossible.';
      return null;
    }
    return donnees;
  }

  async function enregistrerLieu() {
    if (!lieuEnCours) return;
    const nom = champNom.value.trim();
    if (!nom) {
      message.textContent = 'Il lui faut au moins un nom.';
      champNom.focus();
      return;
    }
    message.textContent = 'Enregistrement…';
    const donnees = await envoyerAuSite({
      action: 'enregistrer',
      lieu: {
        id: lieuEnCours.id,
        nom,
        categorie: champCategorie.value.trim(),
        icone: iconeChoisie,
        couleur: couleurChoisie,
        x: lieuEnCours.x,
        y: lieuEnCours.y,
      },
    });
    if (!donnees) return;
    lieux = donnees.lieux;
    dessinerLieux();
    majRailLieux();
    fermerEditeur();
    basculerPose(false);
  }

  async function effacerLieu() {
    if (!lieuEnCours?.id) return;
    if (!confirm(`Effacer « ${lieuEnCours.nom} » ? Le texte de sa fiche part avec.`)) return;
    const donnees = await envoyerAuSite({ action: 'supprimer', id: lieuEnCours.id });
    if (!donnees) return;
    lieux = donnees.lieux;
    dessinerLieux();
    majRailLieux();
    fermerEditeur();
  }

  /* ------------------------------------------------------------- politique */

  /**
   * Ce que Romain a défini : le régime et les doctrines de chaque nation, et
   * les courants libres qu'il a créés par ailleurs.
   *
   * Cela sert à deux choses : dire dans le panneau ce qu'une nation professe,
   * et recolorer le monde selon la grille choisie — la carte politique d'un
   * jeu de stratégie, sauf que la grille est la sienne.
   */
  let politique = { axes: [], courants: [], adhesions: [], nations: {} };
  let modeCourant = '';
  const teintesOrigine = new Map();

  const NEUTRE = '#4a443c';

  async function chargerPolitique() {
    try {
      const donnees = await (await fetch('/api/politique')).json();
      if (donnees && donnees.politique) politique = { nations: {}, ...donnees.politique };
    } catch {
      // La carte se lit très bien sans : on n'insiste pas.
    }
    construireModes();
  }

  /** Ce qu'une entité professe, du plus soutenu au moins soutenu. */
  function courantsDe(type, identifiant) {
    const cle = `${type}:${identifiant}`;
    const parId = new Map(politique.courants.map((c) => [c.id, c]));
    const nomsAxes = new Map(politique.axes.map((a) => [a.id, a.nom]));
    return politique.adhesions
      .filter((a) => a.entite === cle)
      .map((a) => {
        const courant = parId.get(a.courantId);
        return courant ? { ...courant, part: a.part, axe: nomsAxes.get(courant.axeId) || '' } : null;
      })
      .filter(Boolean)
      .sort((a, b) => (b.part ?? 0) - (a.part ?? 0) || a.nom.localeCompare(b.nom, 'fr'));
  }

  const nationDe = (id) => politique.nations?.[`etat:${id}`] || {};

  /** La forme d'État que la carte d'Azgaar donne, pour la déduction du régime. */
  const formeAzgaarDe = (id) => (index.find((e) => e.t === 'etat' && e.i === id) || {}).forme ?? null;

  function regimeDe(id) {
    const nation = nationDe(id);
    if (nation.regime) return { nom: nation.regime, choisi: true, raison: 'choisi' };
    const deduit = regimeDeduit(nation.doctrines, formeAzgaarDe(id));
    return { nom: deduit.nom, choisi: false, raison: deduit.raison };
  }

  /* -------------------------------------------------------- modes de carte */

  function construireModes() {
    const bloc = document.getElementById('bloc-mode');
    const choix = document.getElementById('mode-carte');
    const libres = politique.axes.filter(
      (a) => a.cibles.includes('etat') || a.cibles.includes('province')
    );
    const nations = Object.keys(politique.nations || {}).length;

    if (!libres.length && !nations) {
      bloc.hidden = true;
      return;
    }
    bloc.hidden = false;
    choix.innerHTML = '<option value="">Royaumes</option>';

    if (nations) {
      const famille = document.createElement('optgroup');
      famille.label = 'Nations';
      const option = document.createElement('option');
      option.value = 'regime';
      option.textContent = 'Régime';
      famille.appendChild(option);
      choix.appendChild(famille);

      const doctrines = document.createElement('optgroup');
      doctrines.label = 'Doctrines';
      for (const axe of AXES) {
        const o = document.createElement('option');
        o.value = `doctrine:${axe.id}`;
        o.textContent = `${axe.gauche} · ${axe.droite}`;
        doctrines.appendChild(o);
      }
      choix.appendChild(doctrines);
    }

    if (libres.length) {
      const famille = document.createElement('optgroup');
      famille.label = 'Courants';
      for (const axe of libres) {
        const o = document.createElement('option');
        o.value = `axe:${axe.id}`;
        o.textContent = axe.nom;
        famille.appendChild(o);
      }
      choix.appendChild(famille);
    }
    choix.value = modeCourant;
  }

  /** Les surfaces dessinées, avec l'entité qu'elles représentent. */
  function surfacesDe(type) {
    if (type === 'etat') {
      return [...gCouches.querySelectorAll('[data-couche="regions"] path[id^="state"]:not([id*="-"])')]
        .map((element) => ({ element, id: Number(element.id.slice(5)) }))
        .filter((s) => Number.isFinite(s.id));
    }
    if (type === 'province') {
      return [...gCouches.querySelectorAll('[data-couche="provinces"] .province')]
        .map((groupe) => ({ element: groupe.querySelector('path'), id: Number(groupe.id.slice(8)) }))
        .filter((s) => s.element && Number.isFinite(s.id));
    }
    return [];
  }

  /** Le royaume dont relève une province, pour lui prêter les doctrines. */
  function etatDeLaProvince(id) {
    const province = index.find((e) => e.t === 'province' && e.i === id);
    if (!province) return null;
    const etat = index.find((e) => e.t === 'etat' && e.s === province.f.etatSlug);
    return etat ? etat.i : null;
  }

  /** Mélange deux teintes, pour les positions marquées sans être fanatiques. */
  function melanger(a, b, part) {
    const lire = (c) => [1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
    const [ra, ga, ba] = lire(a);
    const [rb, gb, bb] = lire(b);
    const composante = (x, y) => Math.round(x * part + y * (1 - part));
    return (
      '#' +
      [composante(ra, rb), composante(ga, gb), composante(ba, bb)]
        .map((v) => v.toString(16).padStart(2, '0'))
        .join('')
    );
  }

  /** La teinte d'une position de doctrine : pleine si fanatique, atténuée sinon. */
  function teinteDoctrine(axe, valeur) {
    if (!valeur) return NEUTRE;
    const pole = valeur < 0 ? axe.teinteGauche : axe.teinteDroite;
    return Math.abs(valeur) >= 2 ? pole : melanger(pole, NEUTRE, 0.55);
  }

  /** Une teinte stable par régime : le même nom donne toujours la même. */
  const PALETTE_REGIMES = [
    '#8c4f9e', '#c08a2e', '#4f8ba0', '#a4483a', '#5b9c6a', '#b06a2c',
    '#6f86a8', '#8a7b4f', '#7f4bd8', '#5f9e8f', '#a33b2f', '#6b6b66',
  ];
  const teintesRegime = new Map();
  function teinteRegime(nom) {
    if (!teintesRegime.has(nom)) {
      teintesRegime.set(nom, PALETTE_REGIMES[teintesRegime.size % PALETTE_REGIMES.length]);
    }
    return teintesRegime.get(nom);
  }

  function appliquerMode(mode) {
    modeCourant = mode || '';

    // On rend d'abord aux surfaces leur teinte d'origine.
    for (const [element, teinte] of teintesOrigine) {
      if (teinte === null) element.removeAttribute('fill');
      else element.setAttribute('fill', teinte);
    }
    teintesOrigine.clear();
    teintesRegime.clear();

    if (!modeCourant) return majLegende(null);

    const peindre = (element, teinte) => {
      if (!teintesOrigine.has(element)) teintesOrigine.set(element, element.getAttribute('fill'));
      element.setAttribute('fill', teinte);
    };

    const comptes = new Map();
    const compter = (cle) => comptes.set(cle, (comptes.get(cle) || 0) + 1);

    if (modeCourant.startsWith('doctrine:') || modeCourant === 'regime') {
      const axe = modeCourant === 'regime' ? null : AXE_PAR_ID.get(modeCourant.slice(9));
      if (modeCourant !== 'regime' && !axe) return majLegende(null);

      for (const type of ['etat', 'province']) {
        for (const { element, id } of surfacesDe(type)) {
          const etatId = type === 'etat' ? id : etatDeLaProvince(id);
          if (etatId === null) continue;

          if (axe) {
            const valeur = Number(nationDe(etatId).doctrines?.[axe.id] ?? 0);
            peindre(element, teinteDoctrine(axe, valeur));
            if (type === 'etat') compter(String(valeur));
          } else {
            const regime = regimeDe(etatId).nom;
            peindre(element, teinteRegime(regime));
            if (type === 'etat') compter(regime);
          }
        }
      }
      return majLegende(modeCourant === 'regime' ? { regime: true } : { axe }, comptes);
    }

    // Les courants libres : la teinte du courant dominant sur cet axe.
    const axe = politique.axes.find((a) => a.id === modeCourant.slice(4));
    if (!axe) return majLegende(null);
    for (const type of ['etat', 'province']) {
      if (!axe.cibles.includes(type)) continue;
      for (const { element, id } of surfacesDe(type)) {
        const dominant = courantsDe(type, id).find((c) => c.axeId === axe.id);
        if (!dominant) continue;
        peindre(element, dominant.couleur);
        compter(dominant.id);
      }
    }
    majLegende({ courants: axe }, comptes);
  }

  function majLegende(quoi, comptes) {
    const hote = document.getElementById('legende-mode');
    hote.innerHTML = '';
    if (!quoi) return;

    const ligne = (teinte, texte, compte) => {
      const li = document.createElement('li');
      const puce = document.createElement('i');
      puce.style.background = teinte;
      const nom = document.createElement('span');
      nom.textContent = texte;
      const n = document.createElement('small');
      n.textContent = compte ? String(compte) : '—';
      li.append(puce, nom, n);
      hote.appendChild(li);
    };

    if (quoi.axe) {
      const a = quoi.axe;
      ligne(teinteDoctrine(a, -2), `${a.gauche} fanatique`, comptes?.get('-2'));
      ligne(teinteDoctrine(a, -1), a.gauche, comptes?.get('-1'));
      ligne(NEUTRE, 'Ni l’un ni l’autre', comptes?.get('0'));
      ligne(teinteDoctrine(a, 1), a.droite, comptes?.get('1'));
      ligne(teinteDoctrine(a, 2), `${a.droite} fanatique`, comptes?.get('2'));
      return;
    }

    if (quoi.regime) {
      for (const [nom, compte] of [...(comptes || [])].sort((x, y) => y[1] - x[1])) {
        ligne(teinteRegime(nom), nom, compte);
      }
      return;
    }

    for (const courant of politique.courants.filter((c) => c.axeId === quoi.courants.id)) {
      ligne(courant.couleur, `${courant.symbole} ${courant.nom}`, comptes?.get(courant.id));
    }
  }

  document.getElementById('mode-carte').addEventListener('change', (ev) => {
    appliquerMode(ev.target.value);
  });

  /* ---------------------------------------------------------------- sélection */

  const panneau = document.getElementById('panneau');
  const NOMBRE = new Intl.NumberFormat('fr-FR');
  const URLS = {
    burg: 'villes', etat: 'etats', province: 'provinces',
    culture: 'cultures', religion: 'religions', lieu: 'lieux',
  };

  /**
   * Deux gestes, un seul sens : un clic renseigne, un double-clic emmène.
   *
   * Le premier clic ouvre le panneau — c'est le geste courant, celui qu'on
   * répète en parcourant la carte, et il ne doit jamais faire changer de page.
   * Le double-clic, lui, entre dans la fiche ; mais seulement sur une chose
   * visée : une ville, un lieu posé, le nom d'un royaume. Sur le territoire
   * d'un royaume, qui couvre la moitié de la carte, il continue d'agrandir la
   * vue — sinon il ne resterait plus un pixel où zoomer d'un double-clic.
   */
  let selectionCourante = null;

  const lienDe = (entree) => `/${URLS[entree.t]}/${entree.s}`;
  const rang = (n, genre) => (n === 1 ? (genre === 'm' ? '1ᵉʳ' : '1ʳᵉ') : `${n}ᵉ`);

  /** Au-delà du million, on abrège : l'ordre de grandeur suffit à l'œil. */
  const habitants = (n) =>
    n >= 1000000
      ? `${(n / 1000000).toLocaleString('fr-FR', { maximumFractionDigits: 1 })} M`
      : NOMBRE.format(n);

  /** Un lieu posé par Romain, sous la même forme que les entités de la carte. */
  const entreeLieu = (l) => ({
    t: 'lieu', s: l.slug, n: l.nom, x: l.x, y: l.y, i: l.id,
    d: l.categorie || 'Lieu', col: l.couleur, ic: l.icone,
    f: { pose: l.creeLe },
  });

  /**
   * Ce que le pointeur désigne, cherché par la position plutôt que par la
   * cible de l'événement.
   *
   * Le SVG capture le pointeur dès qu'on appuie, pour ne pas perdre un
   * déplacement qui sort de la fenêtre ; mais une fois la capture posée, le
   * navigateur réattribue tous les événements suivants au SVG lui-même. Le
   * relâchement ne désignait donc plus jamais la ville cliquée, et le clic
   * restait sans effet. On redemande donc ce qu'il y a sous le curseur.
   */
  const sousLePointeur = (ev) =>
    document.elementFromPoint(ev.clientX, ev.clientY) || ev.target;

  /**
   * `precis` distingue une cible visée — pastille de ville, lieu posé,
   * inscription — d'une vaste étendue colorée.
   */
  function entiteSous(cible) {
    const surLieu = cible.closest?.('.lieu');
    if (surLieu) {
      const lieu = lieux.find((l) => l.id === surLieu.dataset.lieu);
      return lieu ? { entree: entreeLieu(lieu), precis: true } : null;
    }

    const noeud = cible.closest?.('[data-id], [id^="state"], [id^="province"]');
    if (!noeud) return null;

    const identifiant = noeud.id || '';
    const etiquetteEtat = identifiant.match(/^stateLabel(\d+)$/);
    const territoire = identifiant.match(/^state(\d+)$/);

    if (etiquetteEtat || territoire) {
      const id = Number((etiquetteEtat || territoire)[1]);
      const entree = index.find((e) => e.t === 'etat' && e.i === id);
      return entree ? { entree, precis: Boolean(etiquetteEtat) } : null;
    }
    const province = identifiant.match(/^province(\d+)$/);
    if (province) {
      const entree = index.find((e) => e.t === 'province' && e.i === Number(province[1]));
      // Comme un royaume : une étendue se renseigne d'un clic, mais garde le
      // double-clic pour agrandir la vue.
      return entree ? { entree, precis: false } : null;
    }
    if (/^(burg|anchor|burgLabel)/.test(identifiant)) {
      const entree = index.find((e) => e.t === 'burg' && e.i === Number(noeud.dataset.id));
      return entree ? { entree, precis: true } : null;
    }
    return null;
  }

  function traiterClic(ev) {
    const vise = sousLePointeur(ev);
    const surLieu = vise.closest?.('.lieu');

    // En mode pose, cliquer un lieu existant le rouvre pour le corriger.
    if (modePose && surLieu) {
      const lieu = lieux.find((l) => l.id === surLieu.dataset.lieu);
      if (!lieu) return;
      gReperes.querySelectorAll('.lieu--choisi').forEach((g) => g.classList.remove('lieu--choisi'));
      surLieu.classList.add('lieu--choisi');
      return ouvrirEditeur({ ...lieu });
    }

    // Un clic sur la carte en mode pose plante un lieu à cet endroit précis.
    if (modePose) {
      const p = pointeur(ev);
      return ouvrirEditeur({ x: (p.x - vue.x) / vue.k, y: (p.y - vue.y) / vue.k });
    }

    const trouve = entiteSous(vise);
    // Un clic dans le vide referme la parenthèse.
    if (!trouve) return fermerPanneau();
    selectionner(trouve.entree);
  }

  svg.addEventListener('dblclick', (ev) => {
    if (modePose) return;
    const trouve = entiteSous(sousLePointeur(ev));
    if (trouve && trouve.precis) {
      ev.preventDefault();
      window.location.href = lienDe(trouve.entree);
      return;
    }
    const p = pointeur(ev);
    zoomerVers(p.x, p.y, 2);
  });

  function selectionner(entree) {
    if (!entree) return;
    const memeQue =
      selectionCourante && selectionCourante.t === entree.t && selectionCourante.i === entree.i;
    if (!memeQue || panneau.hidden) rendrePanneau(entree);
    selectionCourante = entree;
    panneau.hidden = false;
    surligner(entree);
  }

  function fermerPanneau() {
    panneau.hidden = true;
    selectionCourante = null;
    gSurbrillance.innerHTML = '';
  }

  /* ------------------------------------------------------ contenu du panneau */

  /** Faute de blason, un signe : chaque famille d'entité a le sien. */
  const GLYPHES = { burg: '◈', etat: '⚜', province: '❖', culture: '❧', religion: '✦', lieu: '◉' };

  /** Le genre du nom de famille, pour accorder « 1ʳᵉ sur 150 ». */
  const FAMILLES = { burg: 'f', etat: 'm', province: 'f' };

  const DATE = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
  const dateCourte = (iso) => {
    const d = new Date(iso);
    return Number.isNaN(d.getTime()) ? null : DATE.format(d);
  };

  const entreeDe = (type, slug) => (slug ? index.find((x) => x.t === type && x.s === slug) : null);
  const combien = (type) => index.filter((x) => x.t === type).length;
  const somme = (type, champ) => index.reduce((n, x) => (x.t === type ? n + (x.f[champ] || 0) : n), 0);

  /** Une part, jamais arrondie à zéro : « < 0,1 % » se lit, « 0 % » ment. */
  const pourcent = (part) => {
    if (!Number.isFinite(part) || part <= 0) return null;
    if (part < 0.001) return '< 0,1 %';
    return `${(part * 100).toLocaleString('fr-FR', { maximumFractionDigits: part < 0.1 ? 1 : 0 })} %`;
  };

  const km2 = (v) => (v ? `${NOMBRE.format(v)} km²` : null);

  /**
   * D'où relève l'entité : son royaume, sa province. Une ligne sous le titre,
   * cliquable de bout en bout — c'est le chemin le plus court d'une ville à
   * son royaume sans quitter la carte.
   */
  function rattachementDe(e) {
    const f = e.f || {};
    if (e.t === 'burg') {
      return [
        { nom: f.etat, cible: entreeDe('etat', f.etatSlug) },
        { nom: f.prov, cible: entreeDe('province', f.provSlug) },
      ];
    }
    if (e.t === 'province') return [{ nom: f.etat, cible: entreeDe('etat', f.etatSlug) }];
    if (e.t === 'etat') return [{ nom: f.cult ? `Culture ${f.cult}` : null }];
    if (e.t === 'religion') return [{ nom: f.cult ? `Culture ${f.cult}` : null }];
    return [];
  }

  /**
   * Les casiers de chiffres, deux par ligne. Rien n'est inventé : tout vient
   * de l'index, qui vient de l'import.
   */
  function casiersDe(e) {
    const f = e.f || {};
    const liste = [];
    const a = (cle, valeur, extra = {}) => {
      if (valeur === undefined || valeur === null || valeur === '') return;
      liste.push({ cle, valeur, ...extra });
    };
    const genre = FAMILLES[e.t];
    const classement = genre && f.rang ? `${rang(f.rang, genre)} sur ${combien(e.t)}` : null;

    if (e.t === 'burg') {
      a('Habitants', NOMBRE.format(f.pop), { note: classement });
      a('Vocation', f.nat);
      a('Culture', f.cult);
    } else if (e.t === 'etat') {
      a('Habitants', habitants(f.pop), { note: classement });
      a('Superficie', km2(f.km2));
      a('Provinces', f.prov && NOMBRE.format(f.prov));
      a('Villes', f.burgs && NOMBRE.format(f.burgs));
      a('Capitale', f.cap, { cible: entreeDe('burg', f.capSlug) });
      a('Sous les armes', f.armee && habitants(f.armee));
    } else if (e.t === 'province') {
      a('Habitants', habitants(f.pop), { note: classement });
      a('Superficie', km2(f.km2));
      a('Villes', f.burgs && NOMBRE.format(f.burgs));
      a('Chef-lieu', f.cap, { cible: entreeDe('burg', f.capSlug) });
    } else if (e.t === 'culture') {
      a('Nature', f.nat);
      a('Habitants', f.pop && habitants(f.pop));
      a('Superficie', km2(f.km2), { large: true });
    } else if (e.t === 'religion') {
      a('Forme', f.forme);
      a('Fidèles', f.pop && habitants(f.pop));
      a('Divinité', f.dieu, { large: true });
    } else if (e.t === 'lieu') {
      a('Nature', e.d);
      a('Posé le', f.pose && dateCourte(f.pose));
    }
    return liste;
  }

  /**
   * Les proportions, en barres : ce que les chiffres seuls ne montrent pas.
   * Chacune se calcule depuis l'index — le tout comparé à son propre tout.
   */
  function barresDe(e) {
    const f = e.f || {};
    const liste = [];
    const a = (cle, part) => {
      const texte = pourcent(part);
      if (texte) liste.push({ cle, part: Math.min(1, part), texte });
    };

    if (e.t === 'burg') {
      const etat = entreeDe('etat', f.etatSlug);
      if (etat) {
        a('Part du royaume', f.pop / etat.f.pop);
        if (etat.f.urb) a('Part de ses citadins', f.pop / etat.f.urb);
      }
    } else if (e.t === 'etat') {
      a('Part du monde connu', f.pop / somme('etat', 'pop'));
      if (f.urb) a('Population urbaine', f.urb / f.pop);
      a('Part des terres', f.km2 / somme('etat', 'km2'));
    } else if (e.t === 'province') {
      const etat = entreeDe('etat', f.etatSlug);
      if (etat) {
        a('Part du royaume', f.pop / etat.f.pop);
        a('Part de son territoire', f.km2 / etat.f.km2);
      }
    }
    return liste;
  }

  function rendrePanneau(e) {
    const f = e.f || {};
    panneau.style.setProperty('--teinte', e.col || 'var(--or)');

    document.getElementById('panneau-categorie').textContent = e.d || '';
    document.getElementById('panneau-titre').textContent = e.n;

    const ecusson = document.getElementById('panneau-ecusson');
    ecusson.innerHTML = '';
    if (e.bl) {
      const img = document.createElement('img');
      img.src = e.bl;
      img.alt = '';
      ecusson.appendChild(img);
    } else {
      ecusson.textContent = e.ic || GLYPHES[e.t] || '';
    }

    // Un nom qui mène ailleurs : bouton si la cible existe, texte sinon.
    const nommer = (texte, cible) => {
      if (!cible) {
        const span = document.createElement('span');
        span.textContent = texte;
        return span;
      }
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.textContent = texte;
      bouton.addEventListener('click', () => selectionner(cible));
      return bouton;
    };

    const rattachement = document.getElementById('panneau-rattachement');
    rattachement.innerHTML = '';
    for (const { nom, cible } of rattachementDe(e).filter((r) => r.nom)) {
      if (rattachement.childElementCount) {
        const sep = document.createElement('span');
        sep.className = 'sep';
        sep.textContent = '·';
        rattachement.appendChild(sep);
      }
      rattachement.appendChild(nommer(nom, cible));
    }

    const traits = document.getElementById('panneau-traits');
    traits.innerHTML = '';
    for (const t of f.traits || []) {
      const li = document.createElement('li');
      li.textContent = t;
      traits.appendChild(li);
    }

    // Le régime et les doctrines : ce que la nation est, avant ce qu'elle a.
    const nation = document.getElementById('panneau-nation');
    nation.innerHTML = '';
    if (e.t === 'etat') {
      const regime = regimeDe(e.i);
      const titre = document.createElement('p');
      titre.className = 'panneau__regime';
      titre.textContent = regime.nom;
      if (!regime.choisi) titre.title = regime.raison;
      nation.appendChild(titre);

      const tenues = doctrinesRetenues(nationDe(e.i).doctrines);
      if (tenues.length) {
        const liste = document.createElement('ul');
        liste.className = 'doctrines';
        for (const d of tenues.slice(0, 6)) {
          const li = document.createElement('li');
          li.className = 'doctrine' + (d.fanatique ? ' doctrine--fanatique' : '');
          li.style.setProperty('--teinte', d.teinte);
          const nom = document.createElement('span');
          nom.textContent = d.nom;
          li.appendChild(nom);
          if (d.fanatique) {
            const mention = document.createElement('small');
            mention.textContent = 'fanatique';
            li.appendChild(mention);
          }
          liste.appendChild(li);
        }
        nation.appendChild(liste);
      }

      const n = nationDe(e.i);
      if (n.devise) {
        const ligne = document.createElement('p');
        ligne.className = 'panneau__devise';
        ligne.textContent = `« ${n.devise} »`;
        nation.appendChild(ligne);
      }

      // La cour et les particularités : dirigeant, règne, et ce que Romain
      // a ajouté de sa main. Un petit registre, comme sur la fiche.
      const lignes = [];
      if (n.dirigeant) lignes.push([n.titreDirigeant || 'Dirigeant', n.dirigeant]);
      if (n.avenement !== undefined && n.avenement !== null) {
        lignes.push(['Règne', `depuis ${n.avenement}`]);
      }
      for (const c of n.champs || []) lignes.push([c.cle, c.valeur]);
      if (lignes.length) {
        const dl = document.createElement('dl');
        dl.className = 'panneau__cour';
        for (const [cle, valeur] of lignes) {
          const dt = document.createElement('dt');
          dt.textContent = cle;
          const dd = document.createElement('dd');
          dd.textContent = valeur;
          dl.append(dt, dd);
        }
        nation.appendChild(dl);
      }
    }

    const suivis = document.getElementById('panneau-courants');
    suivis.innerHTML = '';
    for (const courant of courantsDe(e.t, e.i)) {
      const li = document.createElement('li');
      li.style.setProperty('--teinte-courant', courant.couleur);
      const marque = document.createElement('span');
      marque.className = 'marque-courant';
      marque.textContent = courant.symbole;
      const nom = document.createElement('a');
      nom.href = `/courants/${courant.slug}`;
      nom.textContent = courant.nom;
      li.append(marque, nom);
      if (typeof courant.part === 'number') {
        const part = document.createElement('span');
        part.className = 'part';
        part.textContent = `${courant.part} %`;
        li.appendChild(part);
      }
      suivis.appendChild(li);
    }

    const grille = document.getElementById('panneau-grille');
    grille.innerHTML = '';
    const casiers = casiersDe(e);
    casiers.forEach((c, i) => {
      const casier = document.createElement('dl');
      casier.className = 'panneau__casier';
      // Un casier orphelin en fin de grille s'étale plutôt que de laisser un trou.
      if (c.large || (i === casiers.length - 1 && casiers.length % 2 === 1)) {
        casier.classList.add('panneau__casier--large');
      }
      const dt = document.createElement('dt');
      dt.textContent = c.cle;
      const dd = document.createElement('dd');
      dd.appendChild(nommer(c.valeur, c.cible));
      if (c.note) {
        const note = document.createElement('small');
        note.textContent = c.note;
        dd.appendChild(note);
      }
      casier.append(dt, dd);
      grille.appendChild(casier);
    });

    const barres = document.getElementById('panneau-barres');
    barres.innerHTML = '';
    for (const b of barresDe(e)) {
      const bloc = document.createElement('div');
      const tete = document.createElement('p');
      tete.className = 'panneau__barre-tete';
      const cle = document.createElement('span');
      cle.textContent = b.cle;
      const valeur = document.createElement('b');
      valeur.textContent = b.texte;
      tete.append(cle, valeur);
      const fond = document.createElement('div');
      fond.className = 'panneau__barre-fond';
      const trait = document.createElement('i');
      // La largeur est posée telle quelle : la transition CSS fait le reste,
      // sans dépendre d'une image d'animation qu'un onglet caché ne rendrait pas.
      trait.style.width = `${Math.max(1.5, b.part * 100)}%`;
      fond.appendChild(trait);
      bloc.append(tete, fond);
      barres.appendChild(bloc);
    }

    document.getElementById('panneau-lien').href = lienDe(e);
    document.getElementById('panneau-centrer').hidden = e.x === null || e.x === undefined;
  }

  document.getElementById('panneau-centrer').addEventListener('click', () => {
    if (selectionCourante) volerVers(selectionCourante);
  });

  /** La cible choisie est cerclée : un trait net, et une onde qui s'éteint. */
  function surligner(entree) {
    gSurbrillance.innerHTML = '';
    if (entree.x === null || entree.y === null || entree.x === undefined) return;
    for (const classe of ['marque', 'marque marque--onde']) {
      const cercle = document.createElementNS(NS, 'circle');
      cercle.setAttribute('class', classe);
      cercle.setAttribute('cx', entree.x);
      cercle.setAttribute('cy', entree.y);
      cercle.setAttribute('r', 7);
      cercle.setAttribute('fill', 'none');
      cercle.setAttribute('stroke', '#b24634');
      cercle.setAttribute('vector-effect', 'non-scaling-stroke');
      cercle.setAttribute('stroke-width', '2');
      gSurbrillance.appendChild(cercle);
    }
  }

  document.getElementById('fermer-panneau').addEventListener('click', fermerPanneau);


  /* ---------------------------------------------------------------- recherche */

  const champ = document.getElementById('recherche');
  const resultats = document.getElementById('resultats');
  const sansAccent = (s) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

  champ.addEventListener('input', () => {
    const q = sansAccent(champ.value.trim());
    resultats.innerHTML = '';
    if (q.length < 2) return;

    const trouves = repertoire()
      .map((e) => {
        const n = sansAccent(e.n);
        const position = n.indexOf(q);
        return position < 0 ? null : { e, score: position === 0 ? 0 : 1, position };
      })
      .filter(Boolean)
      .sort((a, b) => a.score - b.score || a.position - b.position || a.e.n.localeCompare(b.e.n, 'fr'))
      .slice(0, 12);

    for (const { e } of trouves) {
      const li = document.createElement('li');
      const bouton = document.createElement('button');
      bouton.type = 'button';
      const nom = document.createElement('span');
      nom.textContent = e.n;
      const meta = document.createElement('small');
      meta.textContent = e.d || '';
      bouton.append(nom, meta);
      bouton.addEventListener('click', () => {
        volerVers(e);
        selectionner(e);
      });
      li.appendChild(bouton);
      resultats.appendChild(li);
    }
  });

  function volerVers(entree) {
    if (entree.x === null || entree.y === null) return;
    vue.k = entree.t === 'etat' ? 3 : 12;
    // On centre la cible dans le viewBox.
    vue.x = dimensions.largeur / 2 - entree.x * vue.k;
    vue.y = dimensions.hauteur / 2 - entree.y * vue.k;
    appliquer();
  }

  document.addEventListener('keydown', (ev) => {
    if (ev.key === '/' && document.activeElement !== champ) {
      ev.preventDefault();
      champ.focus();
      document.getElementById('rail').classList.add('ouvert');
    } else if (ev.key === 'Escape') {
      fermerPanneau();
      resultats.innerHTML = '';
      champ.blur();
    }
  });

  /* -------------------------------------------------------------- commandes */

  document.getElementById('reinit').addEventListener('click', () => {
    vue.k = 1;
    vue.x = 0;
    vue.y = 0;
    appliquer();
  });

  const bascule = document.getElementById('bascule-rail');
  bascule.addEventListener('click', () => document.getElementById('rail').classList.toggle('ouvert'));

  /* ------------------------------------------------------------------ jauge */

  const jaugeTrait = document.getElementById('jauge-trait');
  const jaugeTexte = document.getElementById('jauge-texte');
  const jaugeZoom = document.getElementById('jauge-zoom');

  function majJauge() {
    const pixelsParUnite = echelleEcran() * vue.k;
    if (!pixelsParUnite) return;
    const kmVises = (120 / pixelsParUnite) * kmParPixel;
    // Longueur ronde la plus proche : 1, 2 ou 5 fois une puissance de dix.
    const ordre = Math.pow(10, Math.floor(Math.log10(kmVises)));
    const km = [1, 2, 5, 10].map((m) => m * ordre).find((v) => v >= kmVises) ?? ordre * 10;
    const largeur = (km / kmParPixel) * pixelsParUnite;
    jaugeTrait.parentElement.style.width = `${Math.round(largeur)}px`;
    jaugeTexte.textContent = km >= 1 ? `${NOMBRE.format(km)} km` : `${km} km`;
    jaugeZoom.textContent = `×${vue.k < 10 ? vue.k.toFixed(1) : Math.round(vue.k)}`;
  }

  /**
   * Les fiches du wiki renvoient ici avec des coordonnées (« Situer sur
   * l'atlas ») ou un identifiant en ancre. On se place alors directement au
   * bon endroit, sans que Romain ait à chercher.
   */
  function ouvrirLaDemande() {
    const params = new URLSearchParams(location.search);
    const x = Number(params.get('x'));
    const y = Number(params.get('y'));

    if (Number.isFinite(x) && Number.isFinite(y) && (x || y)) {
      vue.k = serrer(Number(params.get('z')) || 10, ZOOM_MIN, ZOOM_MAX);
      vue.x = dimensions.largeur / 2 - x * vue.k;
      vue.y = dimensions.hauteur / 2 - y * vue.k;
      appliquer();
      const proche = index.find((e) => Math.abs(e.x - x) < 0.5 && Math.abs(e.y - y) < 0.5);
      if (proche) selectionner(proche);
      return;
    }

    const ancre = decodeURIComponent(location.hash.slice(1));
    if (!ancre) return;
    const entree = index.find((e) => e.s === ancre);
    if (entree) {
      volerVers(entree);
      selectionner(entree);
    }
  }

  window.addEventListener('resize', appliquer);

  demarrer().catch((err) => {
    console.error(err);
    progression.style.background = '#b4432f';
    progression.style.width = '100%';
  });
</script>
