---
import Base from '../layouts/Base.astro';
import { monde } from '../lib/monde';
---

<Base titre="Atlas" description={`Carte interactive de ${monde.nom}`} pleinEcran>
  <div class="scene">
    <svg
      id="carte"
      viewBox={`0 0 ${monde.largeur} ${monde.hauteur}`}
      preserveAspectRatio="xMidYMid meet"
      role="application"
      aria-label={`Carte de ${monde.nom}`}
    >
      <defs id="defs-carte"></defs>
      <g id="zoom">
        <g id="couches"></g>
        <g id="surbrillance"></g>
        <g id="reperes"></g>
      </g>
    </svg>

    <div id="progression" class="progression"><i></i></div>

    <button id="bascule-rail" class="bascule-rail" aria-label="Afficher les réglages">☰</button>

    <aside class="rail" id="rail">
      <div class="rail__bloc">
        <label class="etiquette" for="recherche">Rechercher</label>
        <input
          id="recherche"
          type="search"
          autocomplete="off"
          placeholder="Ville, royaume, lieu…"
          aria-describedby="aide-recherche"
        />
        <p id="aide-recherche" class="aide">Touche <kbd>/</kbd> pour chercher, <kbd>Échap</kbd> pour fermer.</p>
        <ul id="resultats" class="resultats" role="listbox" aria-label="Résultats"></ul>
      </div>

      <div class="rail__bloc">
        <p class="etiquette">Couches</p>
        <div id="couches-controles" class="controles"></div>
      </div>

      <div class="rail__bloc">
        <p class="etiquette">Lieux</p>
        <p class="aide" id="lieux-compte">Aucun lieu posé pour l'instant.</p>
        <select id="filtre-categorie" class="select" aria-label="Filtrer par nature" hidden>
          <option value="">Toutes les natures</option>
        </select>
        <label class="controle" id="bascule-lieux" hidden>
          <input type="checkbox" id="afficher-reperes" checked />
          <span>Afficher les lieux</span>
        </label>
        <button id="placer-lieu" class="bouton" type="button">Placer un lieu</button>
      </div>

      <div class="rail__bloc">
        <button id="reinit" class="bouton" type="button">Recadrer la vue</button>
      </div>
    </aside>

    <!-- Fiche de pose d'un lieu : nom, nature, icône, couleur. -->
    <aside class="lieu-editeur" id="lieu-editeur" hidden>
      <div class="lieu-editeur__tete">
        <p class="etiquette" id="lieu-editeur-titre">Nouveau lieu</p>
        <button class="fermer" type="button" data-lieu="annuler" aria-label="Fermer">×</button>
      </div>

      <label class="champ">
        <span>Nom</span>
        <input id="lieu-nom" type="text" maxlength="120" placeholder="Le Gouffre de Selenor" />
      </label>

      <label class="champ">
        <span>Nature</span>
        <input id="lieu-categorie" type="text" maxlength="60" list="natures-lieu" placeholder="Donjon" />
      </label>
      <datalist id="natures-lieu">
        <option value="Donjon"></option>
        <option value="Ruines"></option>
        <option value="Sanctuaire"></option>
        <option value="Champ de bataille"></option>
        <option value="Repaire"></option>
        <option value="Passage"></option>
        <option value="Cité perdue"></option>
        <option value="Curiosité"></option>
        <option value="Relais"></option>
        <option value="Mine"></option>
      </datalist>

      <p class="etiquette">Icône</p>
      <div class="palette" id="lieu-icones" role="radiogroup" aria-label="Icône du lieu"></div>

      <p class="etiquette">Couleur</p>
      <div class="palette-couleurs" id="lieu-couleurs" role="radiogroup" aria-label="Couleur du lieu">
        <input type="color" id="lieu-couleur-libre" value="#c9a227" aria-label="Couleur libre" />
      </div>

      <p class="aide" id="lieu-message"></p>

      <div class="lieu-editeur__actions">
        <button class="bouton bouton--or" type="button" data-lieu="enregistrer">Enregistrer</button>
        <button class="bouton" type="button" data-lieu="supprimer" hidden>Supprimer</button>
      </div>
    </aside>

    <aside class="panneau" id="panneau" hidden>
      <button id="fermer-panneau" class="fermer" aria-label="Fermer">×</button>
      <p class="etiquette" id="panneau-categorie"></p>
      <h2 id="panneau-titre"></h2>
      <dl class="panneau__faits" id="panneau-faits"></dl>
      <div id="panneau-legende" class="panneau__legende"></div>
      <p class="panneau__indice">Cliquez une seconde fois sur la carte pour entrer dans la fiche.</p>
      <a id="panneau-lien" class="bouton bouton--or" href="#">Ouvrir la fiche</a>
    </aside>

    <div class="jauge">
      <div class="jauge__barre"><span id="jauge-trait"></span></div>
      <span class="chiffre" id="jauge-texte">—</span>
      <span class="jauge__zoom chiffre" id="jauge-zoom">×1</span>
    </div>
  </div>
</Base>

<style is:global>
  .scene {
    position: relative;
    height: calc(100svh - 60px);
    overflow: hidden;
    background: #0a0c0f;
  }

  /* Vignettage : concentre l'œil au centre sans toucher au SVG. */
  .scene::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 52%, rgba(0, 0, 0, 0.6) 100%);
  }

  #carte {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
    /* Sans cela, glisser la carte surligne les noms de villes et de royaumes
       comme du texte ordinaire : le navigateur croit à une sélection. */
    user-select: none;
    -webkit-user-select: none;
  }
  #carte.saisi {
    cursor: grabbing;
  }
  /* Pendant l'interaction, on privilégie la fluidité à la finesse du tracé. */
  #carte.saisi #zoom {
    shape-rendering: optimizeSpeed;
    text-rendering: optimizeSpeed;
  }
  #zoom {
    will-change: transform;
  }

  #reperes text {
    cursor: pointer;
    text-anchor: middle;
    dominant-baseline: central;
    paint-order: stroke;
    stroke: rgba(0, 0, 0, 0.6);
    stroke-width: 0.25px;
  }

  /* ------------------------------------------------------------ progression */

  .progression {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    pointer-events: none;
  }
  .progression i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--or);
    transition: width 0.3s ease-out, opacity 0.4s;
  }

  /* ---------------------------------------------------- panneaux d'instrument */

  .rail,
  .panneau,
  .jauge {
    background: color-mix(in srgb, var(--encre) 92%, transparent);
    backdrop-filter: blur(14px);
    border: 1px solid var(--trait-vif);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
  }

  .rail::before,
  .rail::after,
  .panneau::before,
  .panneau::after {
    content: '';
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--or-sourd);
    pointer-events: none;
  }
  .rail::before,
  .panneau::before {
    top: -1px;
    left: -1px;
    border-right: 0;
    border-bottom: 0;
  }
  .rail::after,
  .panneau::after {
    right: -1px;
    bottom: -1px;
    border-left: 0;
    border-top: 0;
  }

  /* -------------------------------------------------------------------- rail */

  .rail {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    width: 292px;
    max-height: calc(100% - 2.2rem);
    overflow-y: auto;
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .rail__bloc {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .rail__bloc > .etiquette {
    color: var(--or);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--trait);
  }

  #recherche {
    width: 100%;
    padding: 0.55rem 0.7rem;
    background: var(--encre);
    border: 1px solid var(--trait-vif);
    color: var(--parchemin);
    font-family: var(--texte-police);
    font-size: 1rem;
  }
  #recherche:focus {
    outline: none;
    border-color: var(--or-sourd);
  }

  .aide {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--parchemin-faible);
  }
  kbd {
    font-family: var(--mono);
    font-size: 0.6875rem;
    border: 1px solid var(--trait-vif);
    padding: 0.1em 0.35em;
  }

  .resultats {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 250px;
    overflow-y: auto;
  }
  .resultats li button {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.5rem;
    background: none;
    border: 0;
    color: var(--parchemin);
    font-family: var(--texte-police);
    font-size: 1rem;
    text-align: left;
    cursor: pointer;
  }
  .resultats li button:hover,
  .resultats li button:focus-visible {
    background: var(--velin-haut);
    color: var(--or-clair);
    outline: none;
  }
  .resultats small {
    color: var(--parchemin-faible);
    font-family: var(--display);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .controles {
    display: flex;
    flex-direction: column;
  }

  .controle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9375rem;
    padding: 0.22rem 0;
    cursor: pointer;
    color: var(--parchemin-doux);
  }
  .controle:hover {
    color: var(--parchemin);
  }
  .controle input {
    accent-color: var(--or);
    flex: none;
  }
  .controle .poids {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.625rem;
    color: var(--parchemin-faible);
  }

  .select {
    width: 100%;
    padding: 0.4rem 0.5rem;
    background: var(--encre);
    color: var(--parchemin);
    border: 1px solid var(--trait-vif);
    font-family: var(--texte-police);
    font-size: 0.9375rem;
  }

  .bascule-rail {
    display: none;
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    z-index: 5;
    width: 42px;
    height: 42px;
    border: 1px solid var(--trait-vif);
    background: var(--encre);
    color: var(--parchemin);
    font-size: 1.1rem;
    cursor: pointer;
  }

  /* ---------------------------------------------------------------- panneau */

  .panneau {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    width: 330px;
    max-height: calc(100% - 2.2rem);
    overflow-y: auto;
    padding: 1.3rem;
  }
  .panneau[hidden] {
    display: none;
  }
  .panneau h2 {
    font-size: 1.7rem;
    margin: 0.3rem 0 1.1rem;
    padding-right: 1.5rem;
  }
  .panneau > .etiquette {
    color: var(--or);
  }
  .fermer {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    width: 30px;
    height: 30px;
    border: 0;
    background: none;
    color: var(--parchemin-faible);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .fermer:hover {
    color: var(--or-clair);
  }

  .panneau__faits {
    margin: 0 0 1.1rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    font-size: 0.9375rem;
  }
  .panneau__faits dt {
    font-family: var(--display);
    color: var(--parchemin-faible);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    align-self: center;
  }
  .panneau__faits dd {
    margin: 0;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .panneau__legende {
    font-size: 0.9375rem;
    color: var(--parchemin-doux);
    margin-bottom: 1.1rem;
    max-height: 230px;
    overflow-y: auto;
    padding-left: 0.85rem;
    border-left: 1px solid var(--trait-vif);
  }
  .panneau__legende:empty {
    display: none;
  }

  /* ------------------------------------------------------------------ jauge */

  .jauge {
    position: absolute;
    left: 1.1rem;
    bottom: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem 0.85rem;
    font-family: var(--display);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--parchemin-doux);
    pointer-events: none;
  }
  .jauge__barre {
    width: 120px;
    height: 9px;
    border-left: 1px solid var(--or-sourd);
    border-right: 1px solid var(--or-sourd);
    border-bottom: 1px solid var(--or-sourd);
    position: relative;
  }
  .jauge__zoom {
    color: var(--parchemin-faible);
    font-family: var(--mono);
    letter-spacing: 0;
  }

  @media (max-width: 900px) {
    .rail {
      transform: translateX(calc(-100% - 1.5rem));
      transition: transform 0.25s;
      z-index: 6;
    }
    .rail.ouvert {
      transform: none;
    }
    .bascule-rail {
      display: block;
    }
    .panneau {
      width: min(330px, calc(100vw - 2.2rem));
    }
  }

  /* ------------------------------------------------- survol des royaumes */

  /**
   * Les couches décoratives ne captent plus le pointeur. Sans cela, passer
   * au-dessus d'une rivière ou d'une route interrompait le survol du royaume
   * qui se trouve dessous, et la surbrillance clignotait.
   */
  #couches [data-couche='ocean'],
  #couches [data-couche='landmass'],
  #couches [data-couche='lakes'],
  #couches [data-couche='rivers'],
  #couches [data-couche='routes'],
  #couches [data-couche='coastline'],
  #couches [data-couche='ice'],
  #couches [data-couche='borders'],
  #couches [data-couche='prec'] {
    pointer-events: none;
  }

  /**
   * Un royaume s'éclaire au survol pendant que les autres s'effacent.
   * Le sélecteur écarte `state-gap1` et consorts, qui sont les halos de
   * séparation, pas des territoires.
   */
  #couches [data-couche='regions'] path[id^='state']:not([id*='-']) {
    cursor: pointer;
    transition: opacity 0.18s ease, filter 0.18s ease;
  }
  #couches [data-couche='regions']:hover path[id^='state']:not([id*='-']) {
    opacity: 0.4;
  }
  #couches [data-couche='regions'] path[id^='state']:not([id*='-']):hover {
    opacity: 1;
    filter: brightness(1.45) saturate(1.25);
  }

  /* Villes et marqueurs annoncent eux aussi qu'ils réagissent. */
  #couches [data-couche='icons'] use,
  #couches [data-couche='labels'] text {
    cursor: pointer;
  }

  /* --------------------------------------------------------- indice du panneau */

  .panneau__indice {
    margin: 0 0 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--trait);
    font-size: 0.8125rem;
    color: var(--parchemin-faible);
  }
  .panneau__indice[hidden] {
    display: none;
  }

  /* ----------------------------------------------------------------- lieux */

  /**
   * Chaque lieu est un groupe mis à l'échelle inverse du zoom : sa pastille et
   * son icône gardent ainsi la même taille à l'écran, qu'on survole le monde
   * entier ou une seule vallée.
   */
  .lieu {
    cursor: pointer;
  }
  .lieu__fond {
    stroke: rgba(0, 0, 0, 0.65);
    stroke-width: 1.2;
    transition: r 0.12s ease;
  }
  .lieu__icone {
    font-size: 8px;
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
    paint-order: stroke;
    stroke: rgba(0, 0, 0, 0.5);
    stroke-width: 0.4px;
  }
  .lieu:hover .lieu__fond {
    r: 9;
    stroke: var(--or);
  }
  .lieu--choisi .lieu__fond {
    stroke: var(--or-clair);
    stroke-width: 2;
  }

  /* En mode pose, la carte annonce qu'un clic va planter quelque chose. */
  #carte.pose {
    cursor: crosshair;
  }
  #carte.pose .lieu {
    cursor: crosshair;
  }

  /* -------------------------------------------------------- fiche de pose */

  .lieu-editeur {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    width: 320px;
    max-height: calc(100% - 2.2rem);
    overflow-y: auto;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    background: color-mix(in srgb, var(--encre) 95%, transparent);
    backdrop-filter: blur(14px);
    border: 1px solid var(--or-sourd);
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.6);
    z-index: 8;
  }
  .lieu-editeur[hidden] {
    display: none;
  }
  .lieu-editeur__tete {
    display: flex;
    align-items: center;
  }
  .lieu-editeur__tete .etiquette {
    color: var(--or);
    margin-right: auto;
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .champ span {
    font-family: var(--display);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--parchemin-faible);
  }
  .champ input {
    padding: 0.5rem 0.65rem;
    background: var(--encre);
    border: 1px solid var(--trait-vif);
    color: var(--parchemin);
    font-family: var(--texte-police);
    font-size: 1rem;
  }
  .champ input:focus {
    outline: none;
    border-color: var(--or-sourd);
  }

  .palette {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 2px;
    max-height: 132px;
    overflow-y: auto;
    padding: 2px;
    border: 1px solid var(--trait);
    background: var(--encre);
  }
  .palette button {
    aspect-ratio: 1;
    border: 1px solid transparent;
    background: none;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }
  .palette button:hover {
    background: var(--velin-haut);
  }
  .palette button[aria-checked='true'] {
    border-color: var(--or);
    background: var(--velin-haut);
  }

  .palette-couleurs {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
  }
  .palette-couleurs button {
    width: 24px;
    height: 24px;
    border: 1px solid rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    cursor: pointer;
    padding: 0;
  }
  .palette-couleurs button[aria-checked='true'] {
    box-shadow: 0 0 0 2px var(--or-clair);
  }
  .palette-couleurs input[type='color'] {
    width: 30px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--trait-vif);
    background: var(--encre);
    cursor: pointer;
    margin-left: auto;
  }

  .lieu-editeur__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.3rem;
  }
  .lieu-editeur__actions .bouton {
    flex: 1;
    justify-content: center;
    padding: 0.5rem 0.6rem;
    font-size: 0.6875rem;
  }
  #lieu-message:empty {
    display: none;
  }
  #lieu-message {
    color: var(--sang);
    margin: 0;
  }

  @media (max-width: 900px) {
    .lieu-editeur {
      width: min(320px, calc(100vw - 2.2rem));
      left: 1.1rem;
      right: 1.1rem;
    }
  }
</style>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.getElementById('carte');
  const gZoom = document.getElementById('zoom');
  const gCouches = document.getElementById('couches');
  const gReperes = document.getElementById('reperes');
  const gSurbrillance = document.getElementById('surbrillance');
  const defs = document.getElementById('defs-carte');
  const progression = document.querySelector('#progression i');

  const serrer = (v, min, max) => Math.min(max, Math.max(min, v));
  let dimensions = { largeur: 1920, hauteur: 919 };
  let kmParPixel = 3;

  /* ------------------------------------------------------------ vue et zoom */

  const vue = { k: 1, x: 0, y: 0 };
  const ZOOM_MIN = 0.85;
  const ZOOM_MAX = 90;

  /** Échelle appliquée par le navigateur entre le viewBox et les pixels écran. */
  const echelleEcran = () => svg.getScreenCTM()?.a || 1;

  function appliquer() {
    const { largeur, hauteur } = dimensions;
    // On empêche la carte de sortir complètement du champ.
    const gardeX = Math.min(240, largeur * vue.k * 0.5);
    const gardeY = Math.min(240, hauteur * vue.k * 0.5);
    vue.x = serrer(vue.x, gardeX - largeur * vue.k, largeur - gardeX);
    vue.y = serrer(vue.y, gardeY - hauteur * vue.k, hauteur - gardeY);

    gZoom.setAttribute('transform', `translate(${vue.x} ${vue.y}) scale(${vue.k})`);
    majTailleLieux();
    gSurbrillance.style.strokeWidth = `${2 / vue.k}px`;
    majJauge();
  }

  function zoomerVers(px, py, facteur) {
    const k = serrer(vue.k * facteur, ZOOM_MIN, ZOOM_MAX);
    vue.x = px - ((px - vue.x) / vue.k) * k;
    vue.y = py - ((py - vue.y) / vue.k) * k;
    vue.k = k;
    appliquer();
  }

  /** Coordonnées du pointeur dans le repère du viewBox (avant transformation). */
  function pointeur(ev) {
    const ctm = svg.getScreenCTM();
    if (!ctm) return { x: 0, y: 0 };
    const p = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(ctm.inverse());
    return { x: p.x, y: p.y };
  }

  let minuteurInteraction;
  function marquerInteraction() {
    svg.classList.add('saisi');
    clearTimeout(minuteurInteraction);
    minuteurInteraction = setTimeout(() => svg.classList.remove('saisi'), 220);
  }

  svg.addEventListener(
    'wheel',
    (ev) => {
      ev.preventDefault();
      const p = pointeur(ev);
      marquerInteraction();
      zoomerVers(p.x, p.y, Math.exp(-ev.deltaY * 0.0016));
    },
    { passive: false }
  );

  // Déplacement et pincement : un seul jeu de pointeurs pour souris et tactile.
  const pointeurs = new Map();
  let glisse = null;
  let pincement = null;

  svg.addEventListener('pointerdown', (ev) => {
    if (ev.pointerType === 'mouse' && ev.button !== 0) return;
    // La capture échoue si le pointeur n'est plus actif : sans garde, le
    // déplacement de la carte serait perdu au lieu d'être simplement moins fluide.
    try {
      svg.setPointerCapture(ev.pointerId);
    } catch {}
    pointeurs.set(ev.pointerId, { x: ev.clientX, y: ev.clientY });

    if (pointeurs.size === 1) {
      glisse = { sx: ev.clientX, sy: ev.clientY, vx: vue.x, vy: vue.y, bouge: false };
      svg.classList.add('saisi');
    } else if (pointeurs.size === 2) {
      glisse = null;
      const [a, b] = [...pointeurs.values()];
      pincement = {
        distance: Math.hypot(a.x - b.x, a.y - b.y),
        milieu: pointeur({ clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 }),
        k: vue.k,
      };
    }
  });

  svg.addEventListener('pointermove', (ev) => {
    if (!pointeurs.has(ev.pointerId)) return;
    pointeurs.set(ev.pointerId, { x: ev.clientX, y: ev.clientY });

    if (pincement && pointeurs.size === 2) {
      const [a, b] = [...pointeurs.values()];
      const distance = Math.hypot(a.x - b.x, a.y - b.y);
      if (pincement.distance > 0) {
        const k = serrer((pincement.k * distance) / pincement.distance, ZOOM_MIN, ZOOM_MAX);
        const m = pincement.milieu;
        vue.x = m.x - ((m.x - vue.x) / vue.k) * k;
        vue.y = m.y - ((m.y - vue.y) / vue.k) * k;
        vue.k = k;
        marquerInteraction();
        appliquer();
      }
      return;
    }

    if (!glisse) return;
    const s = echelleEcran();
    const dx = ev.clientX - glisse.sx;
    const dy = ev.clientY - glisse.sy;
    if (Math.abs(dx) + Math.abs(dy) > 3) glisse.bouge = true;
    vue.x = glisse.vx + dx / s;
    vue.y = glisse.vy + dy / s;
    appliquer();
  });

  function relacher(ev) {
    pointeurs.delete(ev.pointerId);
    if (pointeurs.size < 2) pincement = null;
    if (pointeurs.size === 0) {
      svg.classList.remove('saisi');
      if (glisse && !glisse.bouge) traiterClic(ev);
      glisse = null;
    }
  }
  svg.addEventListener('pointerup', relacher);
  svg.addEventListener('pointercancel', relacher);

  svg.addEventListener('dblclick', (ev) => {
    const p = pointeur(ev);
    zoomerVers(p.x, p.y, 2);
  });

  /* ------------------------------------------------------------- chargement */

  let manifeste = null;
  let index = [];

  async function fragment(url) {
    const reponse = await fetch(url);
    if (!reponse.ok) throw new Error(`${url} : ${reponse.status}`);
    const texte = await reponse.text();
    const doc = new DOMParser().parseFromString(texte, 'image/svg+xml');
    if (doc.querySelector('parsererror')) throw new Error(`${url} : SVG illisible`);
    return doc.documentElement.firstElementChild;
  }

  let chargees = 0;
  let aCharger = 1;
  function avancer() {
    chargees++;
    const pct = Math.min(100, Math.round((chargees / aCharger) * 100));
    progression.style.width = `${pct}%`;
    if (pct >= 100) setTimeout(() => (progression.style.opacity = '0'), 400);
  }

  async function chargerCouche(id) {
    const hote = gCouches.querySelector(`[data-couche="${id}"]`);
    if (!hote || hote.dataset.charge === 'oui') return;
    hote.dataset.charge = 'encours';
    try {
      const noeud = await fragment(`/carte/couches/${id}.svg`);
      if (noeud) hote.appendChild(document.importNode(noeud, true));
      hote.dataset.charge = 'oui';
    } catch (err) {
      hote.dataset.charge = 'non';
      console.error(err);
    }
  }

  async function demarrer() {
    manifeste = await (await fetch('/carte/manifeste.json')).json();
    dimensions = { largeur: manifeste.largeur, hauteur: manifeste.hauteur };

    const parDefaut = manifeste.couches.filter((c) => c.parDefaut);
    aCharger = parDefaut.length + 1;

    // Les définitions (tracés de côtes, symboles, filtres) conditionnent le
    // rendu de presque toutes les couches : elles passent en premier.
    const noeudDefs = await fragment('/carte/couches/_defs.svg');
    if (noeudDefs) defs.appendChild(document.importNode(noeudDefs, true));
    avancer();

    // Emplacements créés dans l'ordre du manifeste pour figer la superposition,
    // quel que soit l'ordre d'arrivée des téléchargements.
    for (const c of manifeste.couches) {
      const g = document.createElementNS(NS, 'g');
      g.dataset.couche = c.id;
      if (!c.parDefaut) g.style.display = 'none';
      gCouches.appendChild(g);
    }

    construireControles();
    await Promise.all(parDefaut.map((c) => chargerCouche(c.id).then(avancer)));

    index = await (await fetch('/carte/index.json')).json();
    await chargerLieux();
    appliquer();
    ouvrirLaDemande();
  }

  /* --------------------------------------------------------------- couches */

  function construireControles() {
    const hote = document.getElementById('couches-controles');
    hote.innerHTML = '';
    for (const c of manifeste.couches) {
      const label = document.createElement('label');
      label.className = 'controle';
      const poids = c.octets > 102400 ? `${Math.round(c.octets / 1024)} Ko` : '';
      label.innerHTML =
        `<input type="checkbox" data-couche="${c.id}"${c.parDefaut ? ' checked' : ''}>` +
        `<span></span><span class="poids">${poids}</span>`;
      label.querySelector('span').textContent = c.libelle;
      label.querySelector('input').addEventListener('change', async (ev) => {
        const actif = ev.target.checked;
        const g = gCouches.querySelector(`[data-couche="${c.id}"]`);
        if (actif) {
          g.style.display = '';
          await chargerCouche(c.id);
        } else {
          g.style.display = 'none';
        }
      });
      hote.appendChild(label);
    }
  }

  /* -------------------------------------------------------------- lieux */

  /**
   * Les lieux ne viennent plus de la carte d'Azgaar, qui en produisait des
   * centaines d'identiques. Ce sont ceux que Romain pose lui-même : nom,
   * nature, icône et couleur, enregistrés sur le site.
   */
  let lieux = [];
  let stockageActif = false;
  let modePose = false;
  let lieuEnCours = null; // le lieu que la fiche de pose est en train d'éditer

  const ICONES = [
    '🏰','🏛️','🗼','⛪','🏚️','🛖','⚓','🌉','⛲','🚪',
    '⛰️','🌋','🌲','🌳','🏝️','🏜️','💧','❄️','🕳️','🪨',
    '⚔️','🛡️','🏹','🪓','🔥','💀','⚰️','🩸','🏴','⛓️',
    '🔮','✨','🌙','⭐','👁️','🕯️','📜','🗝️','⚗️','🔱',
    '🐉','🐺','🦅','🐍','🕷️','🐗','🦌','🐎','🦉','🐟',
    '💰','⚒️','🍺','🧭','📖','🎭','🎣','🌾','⚖️','📍',
  ];

  const COULEURS = [
    '#c9a227','#9a4034','#55786a','#5b9cd6','#651179',
    '#b06a2c','#7c8aa0','#3f7d3f','#a8477f','#e9dfcb',
  ];

  /** Toutes les entités cherchables : celles de la carte et les lieux posés. */
  const repertoire = () => [
    ...index,
    ...lieux.map((l) => ({
      t: 'lieu', s: l.slug, n: l.nom, x: l.x, y: l.y, i: l.id,
      d: l.categorie, ic: l.icone, f: {},
    })),
  ];

  async function chargerLieux() {
    try {
      const reponse = await fetch('/api/lieux');
      const donnees = await reponse.json();
      lieux = Array.isArray(donnees.lieux) ? donnees.lieux : [];
      stockageActif = Boolean(donnees.stockageActif);
    } catch {
      lieux = [];
    }
    dessinerLieux();
    majRailLieux();
  }

  function dessinerLieux() {
    gReperes.innerHTML = '';
    const choix = document.getElementById('filtre-categorie').value;
    const morceaux = document.createDocumentFragment();

    for (const l of lieux) {
      if (choix && l.categorie !== choix) continue;
      const groupe = document.createElementNS(NS, 'g');
      groupe.setAttribute('class', 'lieu');
      groupe.dataset.lieu = l.id;
      groupe.dataset.x = l.x;
      groupe.dataset.y = l.y;

      const fond = document.createElementNS(NS, 'circle');
      fond.setAttribute('class', 'lieu__fond');
      fond.setAttribute('r', '7');
      fond.setAttribute('fill', l.couleur);

      const icone = document.createElementNS(NS, 'text');
      icone.setAttribute('class', 'lieu__icone');
      icone.textContent = l.icone;

      groupe.append(fond, icone);
      morceaux.appendChild(groupe);
    }
    gReperes.appendChild(morceaux);
    majTailleLieux();
  }

  /** Les lieux gardent leur taille à l'écran, quel que soit l'agrandissement. */
  function majTailleLieux() {
    const echelle = 1 / vue.k;
    for (const groupe of gReperes.children) {
      groupe.setAttribute(
        'transform',
        `translate(${groupe.dataset.x} ${groupe.dataset.y}) scale(${echelle})`
      );
    }
  }

  function majRailLieux() {
    const compte = document.getElementById('lieux-compte');
    const select = document.getElementById('filtre-categorie');
    const bascule = document.getElementById('bascule-lieux');

    compte.textContent = lieux.length
      ? `${lieux.length} lieu${lieux.length > 1 ? 'x' : ''} posé${lieux.length > 1 ? 's' : ''}.`
      : "Aucun lieu posé pour l'instant. Clique « Placer un lieu », puis sur la carte.";

    const natures = [...new Set(lieux.map((l) => l.categorie))].sort((a, b) => a.localeCompare(b, 'fr'));
    const retenu = select.value;
    select.innerHTML = '<option value="">Toutes les natures</option>';
    for (const n of natures) {
      const option = document.createElement('option');
      option.value = n;
      option.textContent = n;
      if (n === retenu) option.selected = true;
      select.appendChild(option);
    }
    select.hidden = natures.length < 2;
    bascule.hidden = lieux.length === 0;
  }

  document.getElementById('filtre-categorie').addEventListener('change', dessinerLieux);
  document.getElementById('afficher-reperes').addEventListener('change', (ev) => {
    gReperes.style.display = ev.target.checked ? '' : 'none';
  });

  /* --------------------------------------------------------- fiche de pose */

  const editeur = document.getElementById('lieu-editeur');
  const champNom = document.getElementById('lieu-nom');
  const champCategorie = document.getElementById('lieu-categorie');
  const champCouleurLibre = document.getElementById('lieu-couleur-libre');
  const message = document.getElementById('lieu-message');
  let iconeChoisie = ICONES[0];
  let couleurChoisie = COULEURS[0];

  (function construirePalettes() {
    const palette = document.getElementById('lieu-icones');
    for (const emoji of ICONES) {
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.setAttribute('role', 'radio');
      bouton.textContent = emoji;
      bouton.setAttribute('aria-checked', 'false');
      bouton.addEventListener('click', () => choisirIcone(emoji));
      palette.appendChild(bouton);
    }

    const couleurs = document.getElementById('lieu-couleurs');
    for (const teinte of COULEURS) {
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.setAttribute('role', 'radio');
      bouton.style.background = teinte;
      bouton.title = teinte;
      bouton.setAttribute('aria-checked', 'false');
      bouton.addEventListener('click', () => choisirCouleur(teinte));
      couleurs.insertBefore(bouton, champCouleurLibre);
    }
    champCouleurLibre.addEventListener('input', () => choisirCouleur(champCouleurLibre.value));
  })();

  function choisirIcone(emoji) {
    iconeChoisie = emoji;
    for (const b of document.querySelectorAll('#lieu-icones button')) {
      b.setAttribute('aria-checked', String(b.textContent === emoji));
    }
  }

  function choisirCouleur(teinte) {
    couleurChoisie = teinte;
    champCouleurLibre.value = teinte;
    for (const b of document.querySelectorAll('#lieu-couleurs button')) {
      b.setAttribute('aria-checked', String(b.title === teinte));
    }
  }

  function ouvrirEditeur(lieu) {
    lieuEnCours = lieu;
    document.getElementById('lieu-editeur-titre').textContent = lieu.id ? 'Modifier le lieu' : 'Nouveau lieu';
    champNom.value = lieu.nom || '';
    champCategorie.value = lieu.categorie || '';
    choisirIcone(lieu.icone || ICONES[0]);
    choisirCouleur(lieu.couleur || COULEURS[0]);
    document.querySelector('[data-lieu="supprimer"]').hidden = !lieu.id;
    message.textContent = stockageActif ? '' : "Le stockage n'est pas disponible : impossible d'enregistrer.";
    editeur.hidden = false;
    panneau.hidden = true;
    champNom.focus();
  }

  function fermerEditeur() {
    editeur.hidden = true;
    lieuEnCours = null;
    gReperes.querySelectorAll('.lieu--choisi').forEach((g) => g.classList.remove('lieu--choisi'));
  }

  function basculerPose(actif) {
    modePose = actif;
    svg.classList.toggle('pose', actif);
    const bouton = document.getElementById('placer-lieu');
    bouton.textContent = actif ? 'Annuler la pose' : 'Placer un lieu';
    bouton.classList.toggle('bouton--or', actif);
    if (!actif) fermerEditeur();
  }

  document.getElementById('placer-lieu').addEventListener('click', () => basculerPose(!modePose));

  editeur.addEventListener('click', async (ev) => {
    const action = ev.target.closest('[data-lieu]')?.dataset.lieu;
    if (action === 'annuler') fermerEditeur();
    else if (action === 'enregistrer') await enregistrerLieu();
    else if (action === 'supprimer') await effacerLieu();
  });

  champNom.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter') enregistrerLieu();
  });

  async function envoyerAuSite(corps) {
    const CLE_MDP = 'victorum:mot-de-passe';
    let mdp = sessionStorage.getItem(CLE_MDP);
    if (!mdp) {
      mdp = prompt(
        "Mot de passe de l'atelier. S'il n'en existe pas encore, celui que tu choisis ici devient celui du site."
      );
      if (!mdp) return null;
      sessionStorage.setItem(CLE_MDP, mdp);
    }
    const reponse = await fetch('/api/lieux', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-mot-de-passe': mdp },
      body: JSON.stringify(corps),
    });
    const donnees = await reponse.json().catch(() => ({}));
    if (reponse.status === 401) sessionStorage.removeItem(CLE_MDP);
    if (!reponse.ok) {
      message.textContent = donnees.erreur || 'Enregistrement impossible.';
      return null;
    }
    return donnees;
  }

  async function enregistrerLieu() {
    if (!lieuEnCours) return;
    const nom = champNom.value.trim();
    if (!nom) {
      message.textContent = 'Il lui faut au moins un nom.';
      champNom.focus();
      return;
    }
    message.textContent = 'Enregistrement…';
    const donnees = await envoyerAuSite({
      action: 'enregistrer',
      lieu: {
        id: lieuEnCours.id,
        nom,
        categorie: champCategorie.value.trim(),
        icone: iconeChoisie,
        couleur: couleurChoisie,
        x: lieuEnCours.x,
        y: lieuEnCours.y,
      },
    });
    if (!donnees) return;
    lieux = donnees.lieux;
    dessinerLieux();
    majRailLieux();
    fermerEditeur();
    basculerPose(false);
  }

  async function effacerLieu() {
    if (!lieuEnCours?.id) return;
    if (!confirm(`Effacer « ${lieuEnCours.nom} » ? Le texte de sa fiche part avec.`)) return;
    const donnees = await envoyerAuSite({ action: 'supprimer', id: lieuEnCours.id });
    if (!donnees) return;
    lieux = donnees.lieux;
    dessinerLieux();
    majRailLieux();
    fermerEditeur();
  }

  /* ---------------------------------------------------------------- sélection */

  const panneau = document.getElementById('panneau');
  const NOMBRE = new Intl.NumberFormat('fr-FR');
  const URLS = {
    burg: 'villes', etat: 'etats', province: 'provinces',
    culture: 'cultures', religion: 'religions', lieu: 'lieux',
  };

  /**
   * Deux temps, comme feuilleter un atlas : le premier clic ouvre le panneau
   * et dit ce qu'est le lieu, le second entre dans sa fiche. Chaque chose
   * nommée sur la carte réagit ainsi — royaumes, villes, lieux remarquables —
   * y compris celles qu'un futur import ajoutera, puisque tout passe par
   * l'index plutôt que par une liste écrite à la main.
   */
  let selectionCourante = null;

  const lienDe = (entree) => `/${URLS[entree.t]}/${entree.s}`;

  function traiterClic(ev) {
    const surLieu = ev.target.closest?.('.lieu');
    if (surLieu) {
      const lieu = lieux.find((l) => l.id === surLieu.dataset.lieu);
      if (!lieu) return;
      // En mode pose, cliquer un lieu existant le rouvre pour le corriger.
      if (modePose) {
        gReperes.querySelectorAll('.lieu--choisi').forEach((g) => g.classList.remove('lieu--choisi'));
        surLieu.classList.add('lieu--choisi');
        return ouvrirEditeur({ ...lieu });
      }
      return selectionner({
        t: 'lieu', s: lieu.slug, n: lieu.nom, x: lieu.x, y: lieu.y,
        i: lieu.id, d: lieu.categorie, f: {},
      });
    }

    // Un clic sur la carte en mode pose plante un lieu à cet endroit précis.
    if (modePose) {
      const p = pointeur(ev);
      return ouvrirEditeur({ x: (p.x - vue.x) / vue.k, y: (p.y - vue.y) / vue.k });
    }

    const cible = ev.target.closest?.('[data-id], [id^="state"]');
    if (!cible) {
      // Un clic dans le vide referme la parenthèse : le lieu suivant
      // recommencera par son panneau, jamais par une navigation surprise.
      selectionCourante = null;
      return;
    }

    const identifiant = cible.id || '';
    let entree = null;

    const etiquetteEtat = identifiant.match(/^stateLabel(\d+)$/);
    const territoire = identifiant.match(/^state(\d+)$/);

    if (etiquetteEtat || territoire) {
      const id = Number((etiquetteEtat || territoire)[1]);
      entree = index.find((e) => e.t === 'etat' && e.i === id);
    } else if (/^(burg|anchor|burgLabel)/.test(identifiant)) {
      entree = index.find((e) => e.t === 'burg' && e.i === Number(cible.dataset.id));
    }

    if (entree) selectionner(entree);
  }

  function selectionner(entree) {
    if (!entree) return;

    const dejaChoisi =
      selectionCourante && selectionCourante.t === entree.t && selectionCourante.i === entree.i;
    if (dejaChoisi) {
      window.location.href = lienDe(entree);
      return;
    }
    selectionCourante = entree;

    document.getElementById('panneau-categorie').textContent = entree.d || '';
    document.getElementById('panneau-titre').textContent = entree.n;

    const faits = document.getElementById('panneau-faits');
    faits.innerHTML = '';
    const f = entree.f || {};
    const ajouter = (cle, valeur) => {
      if (valeur === undefined || valeur === null || valeur === '') return;
      const dt = document.createElement('dt');
      dt.textContent = cle;
      const dd = document.createElement('dd');
      dd.textContent = valeur;
      faits.append(dt, dd);
    };
    if (f.pop) ajouter('Habitants', NOMBRE.format(f.pop));
    ajouter('Royaume', f.etat);
    ajouter('Province', f.prov);
    if (f.port) ajouter('Port', 'oui');
    if (f.burgs) ajouter('Villes', NOMBRE.format(f.burgs));
    if (f.km2) ajouter('Superficie', `${NOMBRE.format(f.km2)} km²`);

    const legende = document.getElementById('panneau-legende');
    legende.innerHTML = '';
    if (f.leg) {
      const bloc = document.createElement('div');
      bloc.innerHTML = f.leg; // déjà assaini à l'import (ni script, ni iframe)
      legende.appendChild(bloc);
    }

    document.getElementById('panneau-lien').href = lienDe(entree);
    panneau.hidden = false;
    surligner(entree);
  }

  function surligner(entree) {
    gSurbrillance.innerHTML = '';
    if (entree.x === null || entree.y === null) return;
    const cercle = document.createElementNS(NS, 'circle');
    cercle.setAttribute('cx', entree.x);
    cercle.setAttribute('cy', entree.y);
    cercle.setAttribute('r', 7);
    cercle.setAttribute('fill', 'none');
    cercle.setAttribute('stroke', '#d4a537');
    cercle.setAttribute('vector-effect', 'non-scaling-stroke');
    cercle.setAttribute('stroke-width', '2');
    gSurbrillance.appendChild(cercle);
  }

  document.getElementById('fermer-panneau').addEventListener('click', () => {
    panneau.hidden = true;
    selectionCourante = null;
    gSurbrillance.innerHTML = '';
  });

  /* ---------------------------------------------------------------- recherche */

  const champ = document.getElementById('recherche');
  const resultats = document.getElementById('resultats');
  const sansAccent = (s) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

  champ.addEventListener('input', () => {
    const q = sansAccent(champ.value.trim());
    resultats.innerHTML = '';
    if (q.length < 2) return;

    const trouves = repertoire()
      .map((e) => {
        const n = sansAccent(e.n);
        const position = n.indexOf(q);
        return position < 0 ? null : { e, score: position === 0 ? 0 : 1, position };
      })
      .filter(Boolean)
      .sort((a, b) => a.score - b.score || a.position - b.position || a.e.n.localeCompare(b.e.n, 'fr'))
      .slice(0, 12);

    for (const { e } of trouves) {
      const li = document.createElement('li');
      const bouton = document.createElement('button');
      bouton.type = 'button';
      const nom = document.createElement('span');
      nom.textContent = e.n;
      const meta = document.createElement('small');
      meta.textContent = e.d || '';
      bouton.append(nom, meta);
      bouton.addEventListener('click', () => {
        volerVers(e);
        selectionner(e);
      });
      li.appendChild(bouton);
      resultats.appendChild(li);
    }
  });

  function volerVers(entree) {
    if (entree.x === null || entree.y === null) return;
    vue.k = entree.t === 'etat' ? 3 : 12;
    // On centre la cible dans le viewBox.
    vue.x = dimensions.largeur / 2 - entree.x * vue.k;
    vue.y = dimensions.hauteur / 2 - entree.y * vue.k;
    appliquer();
  }

  document.addEventListener('keydown', (ev) => {
    if (ev.key === '/' && document.activeElement !== champ) {
      ev.preventDefault();
      champ.focus();
      document.getElementById('rail').classList.add('ouvert');
    } else if (ev.key === 'Escape') {
      panneau.hidden = true;
      selectionCourante = null;
      gSurbrillance.innerHTML = '';
      resultats.innerHTML = '';
      champ.blur();
    }
  });

  /* -------------------------------------------------------------- commandes */

  document.getElementById('reinit').addEventListener('click', () => {
    vue.k = 1;
    vue.x = 0;
    vue.y = 0;
    appliquer();
  });

  const bascule = document.getElementById('bascule-rail');
  bascule.addEventListener('click', () => document.getElementById('rail').classList.toggle('ouvert'));

  /* ------------------------------------------------------------------ jauge */

  const jaugeTrait = document.getElementById('jauge-trait');
  const jaugeTexte = document.getElementById('jauge-texte');
  const jaugeZoom = document.getElementById('jauge-zoom');

  function majJauge() {
    const pixelsParUnite = echelleEcran() * vue.k;
    if (!pixelsParUnite) return;
    const kmVises = (120 / pixelsParUnite) * kmParPixel;
    // Longueur ronde la plus proche : 1, 2 ou 5 fois une puissance de dix.
    const ordre = Math.pow(10, Math.floor(Math.log10(kmVises)));
    const km = [1, 2, 5, 10].map((m) => m * ordre).find((v) => v >= kmVises) ?? ordre * 10;
    const largeur = (km / kmParPixel) * pixelsParUnite;
    jaugeTrait.parentElement.style.width = `${Math.round(largeur)}px`;
    jaugeTexte.textContent = km >= 1 ? `${NOMBRE.format(km)} km` : `${km} km`;
    jaugeZoom.textContent = `×${vue.k < 10 ? vue.k.toFixed(1) : Math.round(vue.k)}`;
  }

  /**
   * Les fiches du wiki renvoient ici avec des coordonnées (« Situer sur
   * l'atlas ») ou un identifiant en ancre. On se place alors directement au
   * bon endroit, sans que Romain ait à chercher.
   */
  function ouvrirLaDemande() {
    const params = new URLSearchParams(location.search);
    const x = Number(params.get('x'));
    const y = Number(params.get('y'));

    if (Number.isFinite(x) && Number.isFinite(y) && (x || y)) {
      vue.k = serrer(Number(params.get('z')) || 10, ZOOM_MIN, ZOOM_MAX);
      vue.x = dimensions.largeur / 2 - x * vue.k;
      vue.y = dimensions.hauteur / 2 - y * vue.k;
      appliquer();
      const proche = index.find((e) => Math.abs(e.x - x) < 0.5 && Math.abs(e.y - y) < 0.5);
      if (proche) selectionner(proche);
      return;
    }

    const ancre = decodeURIComponent(location.hash.slice(1));
    if (!ancre) return;
    const entree = index.find((e) => e.s === ancre);
    if (entree) {
      volerVers(entree);
      selectionner(entree);
    }
  }

  window.addEventListener('resize', appliquer);

  demarrer().catch((err) => {
    console.error(err);
    progression.style.background = '#b4432f';
    progression.style.width = '100%';
  });
</script>
