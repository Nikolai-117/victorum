  @media (max-width: 900px) {
    .rail {
      transform: translateX(calc(-100% - 1.5rem));
      transition: transform 0.25s;
      z-index: 6;
    }
    .rail.ouvert {
      transform: none;
    }
    .bascule-rail {
      display: block;
    }
    .panneau {
      width: min(340px, calc(100vw - 2.2rem));
    }
  }

  /* ------------------------------------------------- survol des royaumes */

  /**
   * Les couches décoratives ne captent plus le pointeur. Sans cela, passer
   * au-dessus d'une rivière ou d'une route interrompait le survol du royaume
   * qui se trouve dessous, et la surbrillance clignotait.
   */
  #couches [data-couche='ocean'],
  #couches [data-couche='landmass'],
  #couches [data-couche='lakes'],
  #couches [data-couche='rivers'],
  #couches [data-couche='routes'],
  #couches [data-couche='coastline'],
  #couches [data-couche='ice'],
  #couches [data-couche='borders'],
  #couches [data-couche='prec'] {
    pointer-events: none;
  }

  /**
   * Un royaume s'éclaire au survol pendant que les autres s'effacent.
   * Le sélecteur écarte `state-gap1` et consorts, qui sont les halos de
   * séparation, pas des territoires.
   */
  #couches [data-couche='regions'] path[id^='state']:not([id*='-']) {
    cursor: pointer;
    transition: opacity 0.18s ease, filter 0.18s ease;
  }
  #couches [data-couche='regions']:hover path[id^='state']:not([id*='-']) {
    opacity: 0.4;
  }
  #couches [data-couche='regions'] path[id^='state']:not([id*='-']):hover {
    opacity: 1;
    filter: brightness(1.45) saturate(1.25);
  }

  /**
   * Les provinces se comportent comme les royaumes : la survolée s'éclaire,
   * les autres s'effacent. Et tant qu'elles sont affichées, l'aplat des
   * royaumes s'estompe — sinon les deux teintes se mélangeraient.
   */
  #couches .province {
    cursor: pointer;
    transition: opacity 0.18s ease, filter 0.18s ease;
  }
  #couches [data-couche='provinces']:hover .province {
    opacity: 0.45;
  }
  #couches .province:hover {
    opacity: 1;
    filter: brightness(1.4) saturate(1.2);
  }
  /* Le nom ne capte pas le pointeur : le clic revient à l'aplat qu'il désigne. */
  #couches .province text {
    fill: #f6edda;
    paint-order: stroke;
    pointer-events: none;
    dominant-baseline: central;
  }
  #couches [data-couche='regions'] {
    transition: opacity 0.25s ease;
  }
  #couches.provinces-visibles [data-couche='regions'] {
    opacity: 0.2;
  }

  /* Villes et marqueurs annoncent eux aussi qu'ils réagissent. */
  #couches [data-couche='icons'] use,
  #couches [data-couche='labels'] text {
    cursor: pointer;
  }

  /* ----------------------------------------------------------------- lieux */

  /**
   * Chaque lieu est un groupe mis à l'échelle inverse du zoom : sa pastille et
   * son icône gardent ainsi la même taille à l'écran, qu'on survole le monde
   * entier ou une seule vallée.
   */
  .lieu {
    cursor: pointer;
  }
  .lieu__fond {
    stroke: rgba(0, 0, 0, 0.65);
    stroke-width: 1.2;
    transition: r 0.12s ease;
  }
  .lieu__icone {
    font-size: 8px;
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
    paint-order: stroke;
    stroke: rgba(0, 0, 0, 0.5);
    stroke-width: 0.4px;
  }
  .lieu:hover .lieu__fond {
    r: 9;
    stroke: var(--or);
  }
  .lieu--choisi .lieu__fond {
    stroke: var(--or-clair);
    stroke-width: 2;
  }

  /* En mode pose, la carte annonce qu'un clic va planter quelque chose. */
  #carte.pose {
    cursor: crosshair;
  }
  #carte.pose .lieu {
    cursor: crosshair;
  }

  /* -------------------------------------------------------- fiche de pose */

  .lieu-editeur {
    position: absolute;
    right: 1.1rem;
