---
import Fiche from '../../components/Fiche.astro';
import { contexteDe } from '../../lib/contexte';
import { lieuParSlug } from '../../lib/stockage';

// Les lieux sont posés par Romain depuis l'atlas et vivent dans le stockage
// du site : leurs fiches se rendent donc à la demande.
export const prerender = false;

const lieu = await lieuParSlug(Astro.locals, Astro.params.slug ?? '');
if (!lieu) return Astro.rewrite('/404');
---

<Fiche contexte={contexteDe.lieu(lieu)} />
