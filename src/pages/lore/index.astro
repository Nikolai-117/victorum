  .codex .beast .r { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; font-size: .82rem; }
  .codex .beast .r .k { font-family: var(--font-mono); font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .codex .beast .r .v { font-weight: 600; text-align: right; color: var(--ink); }
  .codex .beast .go { margin-top: auto; padding-top: 14px; font-size: .83rem; font-weight: 600; color: var(--accent); }

  /* ------------------------------------------------------------ royaumes */
  .codex .realms { display: flex; flex-direction: column; gap: 12px; }
  .codex .realm { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: clamp(16px,3vw,34px); background-image: var(--glass); background-color: var(--surface); backdrop-filter: var(--blur); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow), var(--glass-hi); padding: 20px clamp(18px,3vw,28px); overflow: hidden; color: inherit; transition: transform .28s cubic-bezier(.34,1.4,.64,1), box-shadow .3s, border-color .3s; }
  .codex .realm:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift), var(--glass-hi); border-color: color-mix(in srgb, var(--k) 40%, var(--line)); text-decoration: none; }
  .codex .realm::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background: var(--k); }
  .codex .realm .crest { width: 56px; height: 64px; flex: none; color: var(--k); }
  .codex .realm .crest svg { width: 100%; height: 100%; }
  .codex .realm h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.6rem; line-height: 1; margin: 0; color: var(--ink); }
  .codex .realm .gov { font-family: var(--font-mono); font-size: .64rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--k); margin-top: 5px; }
  .codex .realm .desc { font-size: .87rem; color: var(--muted); margin: 8px 0 0; max-width: 56ch; }
  .codex .realm .figs { display: flex; gap: 22px; flex: none; }
  @media (max-width: 820px) { .codex .realm { grid-template-columns: auto 1fr; } .codex .realm .figs { grid-column: 1/-1; padding-top: 14px; border-top: 1px solid var(--line); width: 100%; } }
  .codex .realm .figs .f { display: flex; flex-direction: column; }
  .codex .realm .figs .f .n { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; line-height: 1; font-variant-numeric: tabular-nums; color: var(--ink); }
  .codex .realm .figs .f .l { font-family: var(--font-mono); font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-top: 3px; }

  /* --------------------------------------------------------- personnages */
  .codex .people { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  @media (max-width: 1000px) { .codex .people { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) { .codex .people { grid-template-columns: repeat(2, 1fr); } }
  .codex .person { text-align: center; color: inherit; display: flex; flex-direction: column; align-items: center; padding: 8px 4px 14px; border-radius: 16px; transition: background .25s; }
  .codex .person:hover { background-image: var(--glass); text-decoration: none; }
  .codex .person .med { position: relative; width: 112px; height: 112px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(160deg, #EFE6D4, #E0D2B9); border: 1px solid var(--line); box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,.8); overflow: hidden; transition: transform .3s cubic-bezier(.34,1.4,.64,1), box-shadow .3s; }
  .codex .person:hover .med { transform: translateY(-4px); box-shadow: var(--shadow-lift), inset 0 1px 0 rgba(255,255,255,.8); }
  .codex .person .med svg { width: 100%; height: 100%; }
  .codex .person .med::after { content: ''; position: absolute; inset: 5px; border-radius: 50%; border: 1px solid rgba(114,101,85,.28); pointer-events: none; }
  .codex .person .dot { position: absolute; bottom: 6px; right: 14px; width: 13px; height: 13px; border-radius: 50%; background: var(--k); border: 2px solid var(--surface); z-index: 2; }
  .codex .person h3 { font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; line-height: 1.15; margin: 12px 0 0; color: var(--ink); }
  .codex .person .role { font-size: .76rem; color: var(--muted); margin-top: 2px; }

  /* --------------------------------------------------------------- index */
  .codex .indexcard { background-image: var(--glass-strong); background-color: var(--surface); backdrop-filter: var(--blur); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow), var(--glass-hi); padding: clamp(22px,3.4vw,34px); }
  .codex .alpha { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 22px; }
  .codex .alpha button { width: 29px; height: 29px; border-radius: 8px; border: 1px solid transparent; background: transparent; font-family: var(--font-mono); font-size: .76rem; font-weight: 600; color: var(--muted); cursor: pointer; transition: background .18s, color .18s, border-color .18s; }
  .codex .alpha button:hover { background: rgba(138,47,60,.08); color: var(--accent); }
  .codex .alpha button[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); border-color: var(--accent-strong); }
  .codex .alpha button:disabled { opacity: .28; cursor: default; }
  .codex .cols { columns: 3; column-gap: 34px; }
  @media (max-width: 900px) { .codex .cols { columns: 2; } }
  @media (max-width: 560px) { .codex .cols { columns: 1; } }
  .codex .grp { break-inside: avoid; margin-bottom: 20px; }
  .codex .grp .ltr { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--accent); border-bottom: 1px solid var(--line); padding-bottom: 3px; margin-bottom: 7px; }
  .codex .grp a { display: flex; align-items: baseline; gap: 8px; padding: 4px 0; color: var(--ink); font-size: .88rem; border-bottom: 1px dotted transparent; }
  .codex .grp a:hover { color: var(--accent); text-decoration: none; border-bottom-color: rgba(138,47,60,.4); }
  .codex .grp a .cat { margin-left: auto; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .codex .grp a.todo { color: var(--muted); font-style: italic; }
  .codex .grp a.todo .cat { color: var(--accent); }
  .codex .idx-foot { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--line); font-family: var(--font-mono); font-size: .7rem; color: var(--muted); }
  .codex .empty { display: none; padding: 26px 0; text-align: center; color: var(--muted); font-style: italic; font-family: var(--font-display); font-size: 1.15rem; }
  .codex .empty.on { display: block; }

  .codex .rise { opacity: 0; transform: translateY(14px); animation: cx-rise .6s cubic-bezier(.2,.7,.3,1) forwards; }
  @keyframes cx-rise { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .codex .rise { opacity: 1; transform: none; animation: none; }
    .codex .aura i { animation: none !important; }
  }
</style>

<script>
  const D = JSON.parse(document.getElementById('donnees-codex').textContent);
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const svgFer = (cle, w) =>
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="' + (w || 1.7) +
    '" stroke-linecap="round" stroke-linejoin="round">' + (D.fers[cle] || D.fers.book) + '</svg>';

  /* ===================== surcouches ===================== */
  const scrim = $('scrim'), sheetAll = $('sheetAll'), sheetNew = $('sheetNew');
  function fermer() { scrim.classList.remove('on'); sheetAll.classList.remove('on'); sheetNew.classList.remove('on'); }
  scrim.addEventListener('click', fermer);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fermer(); });
  for (const b of document.querySelectorAll('[data-close]')) b.addEventListener('click', fermer);

  /* La bibliothèque : tous les rayons d'un coup d'œil. */
  $('openAll').addEventListener('click', () => {
    const grille = $('allGrid');
    grille.innerHTML = '';
    for (const r of D.rayons) {
      const a = document.createElement('a');
      a.className = 'tile'; a.href = r.url; a.style.setProperty('--lb', r.cuir);
      a.innerHTML = '<span class="mini">' + svgFer(r.fer, 1.9) + '</span>' +
        '<span class="tx"><span class="nm">' + esc(r.nom) + '</span>' +
        '<span class="cn">' + r.n + ' entrée' + (r.n > 1 ? 's' : '') + '</span></span>';
      grille.appendChild(a);
    }
    const mk = document.createElement('button');
    mk.className = 'tile mk'; mk.type = 'button';
    mk.innerHTML = '<span class="tx"><span class="nm">+ Nouveau rayon</span></span>';
    mk.addEventListener('click', () => { fermer(); setTimeout(ouvrirNouveau, 200); });
    grille.appendChild(mk);
    scrim.classList.add('on'); sheetAll.classList.add('on');
  });

  /* ===================== relier un volume ===================== */
  const CUIRS = Object.keys(D.cuirs);
  let choix = { reliure: CUIRS[0], fer: 'book' };
  const pvSpine = $('pvSpine'), pvNom = $('pvName'), pvIcone = $('pvIcon'), rNom = $('rName');

  function majApercu() {
    pvSpine.style.setProperty('--lb', D.cuirs[choix.reliure]);
    pvIcone.innerHTML = svgFer(choix.fer, 1.9);
    pvNom.textContent = rNom.value.trim() || 'Sans titre';
  }
  CUIRS.forEach((cle, i) => {
    const b = document.createElement('button');
    b.className = 'pick col'; b.type = 'button';
    b.style.setProperty('--lb', D.cuirs[cle]);
    b.setAttribute('aria-pressed', String(i === 0));
    b.setAttribute('aria-label', 'Reliure ' + (i + 1));
    b.addEventListener('click', () => {
      choix.reliure = cle;
      for (const x of b.parentNode.children) x.setAttribute('aria-pressed', String(x === b));
      majApercu();
    });
    $('colPicks').appendChild(b);
  });
  Object.keys(D.fers).forEach((cle) => {
    const b = document.createElement('button');
    b.className = 'pick ico'; b.type = 'button'; b.innerHTML = svgFer(cle, 1.9);
    b.setAttribute('aria-pressed', String(cle === 'book'));
    b.setAttribute('aria-label', 'Fer ' + cle);
    b.addEventListener('click', () => {
      choix.fer = cle;
      for (const x of b.parentNode.children) x.setAttribute('aria-pressed', String(x === b));
      majApercu();
    });
    $('icoPicks').appendChild(b);
  });
  rNom.addEventListener('input', majApercu);

  function ouvrirNouveau() {
    scrim.classList.add('on'); sheetNew.classList.add('on');
    $('etatNew').textContent = '';
    majApercu();
    setTimeout(() => rNom.focus(), 320);
  }
  $('newShelf').addEventListener('click', ouvrirNouveau);
  $('newShelf2').addEventListener('click', ouvrirNouveau);

  const CLE_MDP = 'victorum:mot-de-passe';
  function motDePasse() {
    let mdp = sessionStorage.getItem(CLE_MDP);
    if (!mdp) {
      mdp = prompt(D.motDePasseDefini
        ? "Mot de passe de l'atelier :"
        : "Choisis le mot de passe de ton atelier. Il te sera demandé pour toute modification, et personne d'autre ne pourra écrire sur ton site.");
      if (mdp) sessionStorage.setItem(CLE_MDP, mdp);
    }
    return mdp;
  }

  $('doCreate').addEventListener('click', async () => {
    const etat = $('etatNew');
    const nom = rNom.value.trim();
    if (!nom) { etat.textContent = 'Donne un nom au rayon.'; return rNom.focus(); }
    if (!D.stockageActif) { etat.textContent = "Le stockage n'est pas relié : impossible de relier un volume."; return; }
    const mdp = motDePasse(); if (!mdp) return;
    etat.textContent = 'Reliure en cours…';
    try {
      const r = await fetch('/api/lore', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-mot-de-passe': mdp },
        body: JSON.stringify({ action: 'categorie', nom, reliure: choix.reliure, fer: choix.fer }),
      });
      const res = await r.json().catch(() => ({}));
      if (r.status === 401) { sessionStorage.removeItem(CLE_MDP); etat.textContent = res.erreur || 'Mot de passe refusé.'; return; }
      if (!r.ok) { etat.textContent = res.erreur || 'Échec.'; return; }
      const creee = (res.lore.categories || []).find((c) => c.nom === nom);
      location.href = creee ? '/lore/' + creee.slug : '/lore';
    } catch {
      etat.textContent = 'Réseau indisponible.';
    }
  });

  /* ===================== index général ===================== */
  const cols = $('cols'), alpha = $('alpha'), vide = $('empty'), compte = $('idxCount');
  const LETTRES = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
  let lettre = null, requete = '';
  const sansAccent = (s) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const initiale = (s) => (sansAccent(s)[0] || '?').toUpperCase();

  for (const L of LETTRES) {
    const b = document.createElement('button');
    b.type = 'button'; b.textContent = L; b.setAttribute('aria-pressed', 'false');
    if (!D.index.some((e) => initiale(e.nom) === L)) b.disabled = true;
    b.addEventListener('click', () => {
      lettre = lettre === L ? null : L;
      for (const x of alpha.children) x.setAttribute('aria-pressed', String(x.textContent === lettre));
      rendre();
    });
    alpha.appendChild(b);
  }

  function rendre() {
    const liste = D.index.filter((e) => {
      const okL = !lettre || initiale(e.nom) === lettre;
      const okQ = !requete || sansAccent(e.nom).includes(requete) || sansAccent(e.cat).includes(requete);
      return okL && okQ;
    });
    const groupes = {};
    for (const e of liste) (groupes[initiale(e.nom)] ??= []).push(e);
    cols.innerHTML = '';
    for (const L of Object.keys(groupes).sort()) {
      const d = document.createElement('div');
      d.className = 'grp';
      d.innerHTML = '<div class="ltr">' + esc(L) + '</div>' + groupes[L].map((e) =>
        '<a class="' + (e.vide ? 'todo' : '') + '" href="' + esc(e.url) + '"><span>' + esc(e.nom) +
        '</span><span class="cat">' + (e.vide ? 'à écrire' : esc(e.cat)) + '</span></a>').join('');
      cols.appendChild(d);
    }
    vide.classList.toggle('on', liste.length === 0);
    compte.textContent = liste.length + ' entrée' + (liste.length > 1 ? 's affichées' : ' affichée') +
      ' sur ' + D.index.length;
  }

  $('q').addEventListener('input', (e) => { requete = sansAccent(e.target.value.trim()); rendre(); });
  $('goSearch').addEventListener('click', () => document.getElementById('sec-index').scrollIntoView({ behavior: 'smooth' }));
  rendre();
</script>
