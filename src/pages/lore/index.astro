---
/**
 * Le Codex — l'armorial.
 *
 * Une bibliothèque, pas une liste : les rayons se tiennent debout sur une
 * étagère, reliés de cuir, frappés d'un fer doré. On en ouvre un, on en relie
 * un neuf, et tout ce que le monde compte se retrouve dans l'index général.
 *
 * Tout ce qui s'affiche ici est VRAI : les rayons sont les catégories du
 * codex, leurs compteurs les articles réellement écrits, l'index rassemble
 * chaque fiche du monde en signalant celles qui restent blanches. Rien n'est
 * inventé — le codex vierge le dit et s'arrête là.
 */
import Base from '../../layouts/Base.astro';
import { lireLore, categoriesDe, articlesDe, RELIURES, FERS, FER_PAR_DEFAUT } from '../../lib/lore';
import { lireChroniques } from '../../lib/chroniques';
import { listerPagesEcrites, listerLieux, motDePasseDefini, stockage } from '../../lib/stockage';
import {
  monde, SITE, etats, provinces, burgs, cultures, religions,
  nombre, habitants, nomAffiche, formeEtat, etatParId,
} from '../../lib/monde';

export const prerender = false;

const [lore, chron, lieux, pages] = await Promise.all([
  lireLore(Astro.locals),
  lireChroniques(Astro.locals),
  listerLieux(Astro.locals),
  listerPagesEcrites(Astro.locals),
]);

const categories = categoriesDe(lore);
const articles = lore.articles ?? [];
const ecrites = new Set(pages.map((p) => `${p.section}/${p.slug}`));
const teinte = (id: number | null | undefined) =>
  (id != null ? etatParId.get(id)?.couleur : null) ?? 'var(--muted)';

/* ------------------------------------------------------------------ rayons */
const CUIRS = Object.keys(RELIURES);
const rayons = categories.map((c, i) => {
  const n = articlesDe(lore, c.slug).length;
  // On garde la CLÉ du fer (pour le client) et son TRACÉ (pour le rendu ici).
  const ferCle = c.fer ?? FER_PAR_DEFAUT[c.slug] ?? 'book';
  return {
    slug: c.slug,
    nom: c.nom,
    n,
    ferCle,
    cuir: RELIURES[c.reliure ?? CUIRS[i % CUIRS.length]],
    fer: FERS[ferCle],
    url: `/lore/${c.slug}`,
    // Des hauteurs légèrement inégales : une étagère n'est jamais alignée.
    hauteur: [250, 232, 262, 240, 256, 244, 236, 254][i % 8],
  };
});
const totalArticles = articles.length;

/* ------------------------------------------------- la pièce maîtresse */
const derniere = [...articles].sort((a, b) => (b.modifieLe ?? '').localeCompare(a.modifieLe ?? ''))[0] ?? null;
const nomCat = new Map(categories.map((c) => [c.slug, c.nom]));
const feature = derniere
  ? {
      titre: derniere.titre,
      resume: derniere.resume,
      symbole: derniere.symbole || '❖',
      couleur: derniere.couleur || 'var(--accent)',
      rayon: nomCat.get(derniere.categorie) ?? 'Codex',
      url: `/lore/${derniere.categorie}/${derniere.slug}`,
      voisins: articlesDe(lore, derniere.categorie).length,
    }
  : null;

/* ------------------------------------------------------------ les rayons montrés */
const bestiaire = articlesDe(lore, 'bestiaire').slice(0, 3);
const figures = articlesDe(lore, 'personnages').slice(0, 5);
const nbBestiaire = articlesDe(lore, 'bestiaire').length;
const nbFigures = articlesDe(lore, 'personnages').length;

/* Les trois royaumes, tels que les données les décrivent. */
const royaumes = etats.map((e) => ({
  nom: e.nom,
  url: `/etats/${e.slug}`,
  couleur: e.couleur,
  forme: formeEtat(e.forme),
  provinces: provinces.filter((p) => p.etatId === e.id).length,
  villes: e.nbBurgs,
  population: habitants(e.population),
}));

/* --------------------------------------------------------- l'index général */
type Entree = { nom: string; cat: string; url: string; vide: boolean };
const index: Entree[] = [
  ...articles.map((a) => ({ nom: a.titre, cat: nomCat.get(a.categorie) ?? 'Codex', url: `/lore/${a.categorie}/${a.slug}`, vide: false })),
  ...chron.evenements.map((e) => ({ nom: e.titre, cat: 'Chronologie', url: `/chronologie/${e.chronique}/${e.slug}`, vide: false })),
  ...etats.map((e) => ({ nom: e.nom, cat: 'Royaumes', url: `/etats/${e.slug}`, vide: !ecrites.has(`etats/${e.slug}`) })),
  ...provinces.map((p) => ({ nom: p.nom, cat: 'Provinces', url: `/provinces/${p.slug}`, vide: !ecrites.has(`provinces/${p.slug}`) })),
  ...burgs.map((b) => ({ nom: nomAffiche(b.nom), cat: 'Villes', url: `/villes/${b.slug}`, vide: !ecrites.has(`villes/${b.slug}`) })),
  ...cultures.map((c) => ({ nom: c.nom, cat: 'Cultures', url: `/cultures/${c.slug}`, vide: !ecrites.has(`cultures/${c.slug}`) })),
  ...religions.map((r) => ({ nom: r.nom, cat: 'Religions', url: `/religions/${r.slug}`, vide: !ecrites.has(`religions/${r.slug}`) })),
  ...lieux.map((l) => ({ nom: l.nom, cat: 'Lieux', url: `/lieux/${l.slug}`, vide: !ecrites.has(`lieux/${l.slug}`) })),
].sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));

const donnees = {
  index,
  cuirs: RELIURES,
  fers: FERS,
  rayons: rayons.map((r) => ({ slug: r.slug, nom: r.nom, n: r.n, cuir: r.cuir, fer: r.ferCle, url: r.url })),
  stockageActif: Boolean(stockage(Astro.locals)),
  motDePasseDefini: await motDePasseDefini(Astro.locals),
};

/* L'engravure générique d'un médaillon : une silhouette, pas un portrait. */
const BUSTE = 'M56 18C44 18 34 26 32 38c-1 5-2 7-5 10-3 3-4 4-2 6 2 1 4 1 5 3-2 2-1 4 1 5-1 2 0 4 3 6 3 2 6 3 9 3 0 5-1 9-3 12-10 5-16 13-16 29h64c0-16-6-24-16-28-4-2-6-6-6-12 10-6 16-16 16-28C82 28 70 18 56 18z';
const ECUS = [
  '<path d="M28 3l23 8v22c0 15-11 24-23 28C16 57 5 48 5 33V11l23-8z"/><path d="M16 26l5 5 7-10 7 10 5-5-2 17H18l-2-17z" fill="currentColor" fill-opacity=".18"/>',
  '<path d="M28 3l23 8v22c0 15-11 24-23 28C16 57 5 48 5 33V11l23-8z"/><path d="M28 16l12 7v14l-12 7-12-7V23l12-7z" fill="currentColor" fill-opacity=".18"/><path d="M16 23l12 7 12-7M28 30v14"/>',
  '<path d="M28 3l23 8v22c0 15-11 24-23 28C16 57 5 48 5 33V11l23-8z"/><path d="M28 44V24M28 24l-8-8M28 30l8-8M28 36l-7-6M28 24c0-6 4-10 4-10"/><circle cx="28" cy="20" r="3" fill="currentColor" fill-opacity=".3"/>',
];
---

<Base titre="Codex" description={`Le codex de ${monde.nom} : bestiaire, royaumes, figures, croyances, magie, géographie.`}>
  <div class="codex">
    <div class="aura" aria-hidden="true"><i class="a1"></i><i class="a2"></i><i class="a3"></i><i class="a4"></i></div>

    <div class="wrap">
      <!-- ============================ EN-TÊTE ============================ -->
      <header class="head">
        <div>
          <p class="eyebrow rise">Codex · le savoir du monde</p>
          <h1 class="rise" style="animation-delay:.08s">Tout ce que l'on sait,<br />et tout ce qu'on <em>invente</em>.</h1>
          <p class="lede rise" style="animation-delay:.16s">
            {categories.map((c) => c.nom).slice(0, 6).join(', ')}. {nombre(categories.length)} rayons,
            une seule mémoire — la tienne.
          </p>
        </div>
        <div class="head-fig rise" style="animation-delay:.2s">
          <div class="n">{nombre(totalArticles)}</div>
          <div class="l">{totalArticles > 1 ? 'entrées au codex' : 'entrée au codex'}</div>
        </div>
      </header>

      <div class="searchbar rise" style="animation-delay:.24s">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.3-4.3"/></svg>
        <input id="q" type="search" placeholder="Chercher une créature, un royaume, une figure, un rite…" autocomplete="off" />
        <button class="go" id="goSearch" type="button">Chercher</button>
      </div>

      <!-- ============================ ÉTAGÈRE ============================ -->
      <div class="shelf-sec">
        <div class="shelf" id="shelf">
          {
            rayons.map((r, i) => (
              <a class="spine" href={r.url} style={`--lb:${r.cuir};--h:${r.hauteur}px`} data-rayon={r.slug}>
                <span class="gloss" />
                <span class="em"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={r.fer} /></span>
                <span class="tt">{r.nom}</span>
                <span class="ct">{r.n}</span>
              </a>
            ))
          }
          <button class="spine add" id="newShelf" type="button">
            <span class="em"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
            <span class="tt">Nouveau rayon</span>
            <span class="ct" />
          </button>
        </div>
        <div class="board" />
        <div class="shelf-bar">
          <span class="lbl">
            <b>{nombre(rayons.length)}</b> rayons · <b>{nombre(totalArticles)}</b>
            {totalArticles > 1 ? ' entrées' : ' entrée'}
          </span>
          <div class="shelf-acts">
            <button class="pill solid" id="openAll" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h7v16H3zM14 4h7v16h-7z"/><path d="M6.5 8h1M17.5 8h1"/></svg>
              Voir toute la bibliothèque
            </button>
          </div>
        </div>
      </div>

      <!-- ======================= PIÈCE MAÎTRESSE ======================= -->
      <section id="sec-feature">
        <div class="sec-head">
          <div><p class="kicker">Pièce maîtresse</p><h2>La dernière entrée</h2></div>
          <a class="more" href="#sec-index">Voir toutes les entrées<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
        {
          feature ? (
            <article class="feature" style={`--sceau:${feature.couleur}`}>
              <div class="plate">
                <svg viewBox="0 0 240 240" role="img" aria-label={`Sceau de ${feature.titre}`}>
                  <circle cx="120" cy="120" r="104" fill="none" stroke="#B9A98E" stroke-width="1.4" />
                  <circle cx="120" cy="120" r="96" fill="none" stroke="#B9A98E" stroke-width="3" />
                  <circle cx="120" cy="120" r="72" fill="none" stroke="#B9A98E" stroke-width="1" />
                  <g stroke="#5C4A3D" stroke-width="1.8" fill="none" stroke-linecap="round">
                    <path d="M120 60 L120 180" /><path d="M84 96 L120 120 L156 96" /><path d="M84 144 L120 120 L156 144" />
                  </g>
                  <circle cx="120" cy="120" r="30" fill="#F1EBDD" stroke="var(--sceau)" stroke-width="2.4" />
                  <text x="120" y="132" text-anchor="middle" font-size="30">{feature.symbole}</text>
                  <text x="120" y="212" text-anchor="middle" font-family="Cormorant Garamond,serif" font-style="italic" font-size="15" fill="#726555">{feature.rayon}</text>
                </svg>
              </div>
              <div class="txt">
                <span class="tag">{feature.rayon}</span>
                <h3>{feature.titre}</h3>
                {feature.resume && <p class="sub">{feature.resume}</p>}
                <div class="meta">
                  <div><div class="k">Rayon</div><div class="v">{feature.rayon}</div></div>
                  <div><div class="k">Entrées du rayon</div><div class="v">{nombre(feature.voisins)}</div></div>
                  <div><div class="k">Au codex</div><div class="v">{nombre(totalArticles)}</div></div>
                </div>
                <div class="acts">
                  <a class="btn primary" href={feature.url}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    Enrichir l'entrée
                  </a>
                  <a class="btn ghost" href={feature.url}>Lire en entier<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                </div>
              </div>
            </article>
          ) : (
            <p class="vide-bloc">
              Le codex est vierge. Ouvre un rayon de l'étagère et écris-y ta
              première entrée — elle prendra cette place.
            </p>
          )
        }
      </section>

      <!-- ============================ BESTIAIRE ============================ -->
      <section id="sec-bestiaire">
        <div class="sec-head">
          <div><p class="kicker">Rayon I</p><h2>Bestiaire</h2></div>
          <a class="more" href="/lore/bestiaire">
            {nbBestiaire ? `${nombre(nbBestiaire)} ${nbBestiaire > 1 ? 'créatures' : 'créature'}` : 'Ouvrir le rayon'}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        {
          bestiaire.length ? (
            <div class="beasts">
              {bestiaire.map((a) => (
                <a class="beast" href={`/lore/bestiaire/${a.slug}`} style={`--sceau:${a.couleur || 'var(--accent)'}`}>
                  <div class="plate"><span class="sceau">{a.symbole || '❖'}</span></div>
                  <div class="bd">
                    <h3>{a.titre}</h3>
                    {a.resume && <p class="lat">{a.resume}</p>}
                    <div class="rows">
                      <div class="r"><span class="k">Rayon</span><span class="v">Bestiaire</span></div>
                    </div>
                    <span class="go">Ouvrir la fiche →</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p class="vide-bloc">
              Aucune créature au bestiaire. <a href="/lore/bestiaire">Ouvre le rayon</a> pour y poser la première.
            </p>
          )
        }
      </section>

      <!-- ============================ ROYAUMES ============================ -->
      <section id="sec-royaumes">
        <div class="sec-head">
          <div><p class="kicker">Rayon II</p><h2>Royaumes &amp; maisons</h2></div>
          <a class="more" href="/etats">
            {nombre(royaumes.length)} couronnes · {nombre(provinces.length)} provinces
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        <div class="realms">
          {
            royaumes.map((r, i) => (
              <a class="realm" href={r.url} style={`--k:${r.couleur}`}>
                <span class="crest">
                  <svg viewBox="0 0 56 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" set:html={ECUS[i % ECUS.length]} />
                </span>
                <div>
                  <h3>{r.nom}</h3>
                  <p class="gov">{r.forme} · {nombre(r.provinces)} {r.provinces > 1 ? 'provinces' : 'province'}</p>
                  <p class="desc">
                    {nombre(r.villes)} {r.villes > 1 ? 'villes recensées' : 'ville recensée'} sur les terres de {r.nom}.
                    Ouvre sa fiche pour en écrire l'histoire.
                  </p>
                </div>
                <div class="figs">
                  <span class="f"><span class="n">{nombre(r.villes)}</span><span class="l">villes</span></span>
                  <span class="f"><span class="n">{r.population}</span><span class="l">habitants</span></span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <!-- =========================== PERSONNAGES =========================== -->
      <section id="sec-personnages">
        <div class="sec-head">
          <div><p class="kicker">Rayon III</p><h2>Figures du monde</h2></div>
          <a class="more" href="/lore/personnages">
            {nbFigures ? `${nombre(nbFigures)} ${nbFigures > 1 ? 'personnages' : 'personnage'}` : 'Ouvrir le rayon'}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
        {
          figures.length ? (
            <div class="people">
              {figures.map((a) => (
                <a class="person" href={`/lore/personnages/${a.slug}`}>
                  <span class="med">
                    <svg viewBox="0 0 112 112" aria-hidden="true"><path d={BUSTE} fill="#5C4A3D" opacity=".72" /></svg>
                    <span class="dot" style={`--k:${a.couleur || 'var(--accent)'}`} />
                  </span>
                  <h3>{a.titre}</h3>
                  {a.resume && <span class="role">{a.resume}</span>}
                </a>
              ))}
            </div>
          ) : (
            <p class="vide-bloc">
              Aucune figure au codex. <a href="/lore/personnages">Ouvre le rayon</a> pour y graver la première.
            </p>
          )
        }
      </section>

      <!-- ============================== INDEX ============================== -->
      <section id="sec-index">
        <div class="sec-head">
          <div><p class="kicker">Toutes les entrées</p><h2>Index général</h2></div>
          <button class="more more--bouton" id="newShelf2" type="button">
            Ajouter un rayon<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          </button>
        </div>
        <div class="indexcard">
          <div class="alpha" id="alpha" />
          <div class="cols" id="cols" />
          <p class="empty" id="empty">Aucune entrée ne répond à cette recherche — c'est peut-être une page à écrire.</p>
          <div class="idx-foot">
            <span id="idxCount" />
            <span>les entrées <i>en italique</i> restent à écrire</span>
          </div>
        </div>
      </section>
    </div>

    <!-- ============================ SURCOUCHES ============================ -->
    <div class="scrim" id="scrim" />

    <div class="sheet" id="sheetAll" role="dialog" aria-modal="true" aria-label="Tous les rayons">
      <div class="cap" />
      <div class="sh">
        <div>
          <p class="kick">Bibliothèque</p>
          <h3>Tous les rayons</h3>
          <p>Chaque rayon du codex, d'un seul coup d'œil — sans rien faire défiler.</p>
        </div>
        <button class="xbtn" data-close type="button" aria-label="Fermer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <div class="body"><div class="grid" id="allGrid" /></div>
    </div>

    <div class="sheet sheet--etroite" id="sheetNew" role="dialog" aria-modal="true" aria-label="Créer un rayon">
      <div class="cap" />
      <div class="sh">
        <div>
          <p class="kick">Nouveau rayon</p>
          <h3>Relier un volume</h3>
          <p>Nomme-le, choisis sa reliure et son fer. Il rejoindra l'étagère.</p>
        </div>
        <button class="xbtn" data-close type="button" aria-label="Fermer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <div class="body">
        <div class="preview">
          <div class="pv" id="pvSpine"><span class="i" id="pvIcon" /><span class="t" id="pvName">Sans titre</span></div>
          <p class="cap2">Aperçu de la reliure.<br />Elle rejoindra l'étagère avec <b>0 entrée</b>.</p>
        </div>
        <div class="field">
          <label for="rName">Nom du rayon</label>
          <input id="rName" type="text" placeholder="Langues, Navires, Recettes…" maxlength="22" autocomplete="off" />
        </div>
        <div class="field"><label>Reliure</label><div class="picks" id="colPicks" /></div>
        <div class="field"><label>Fer doré</label><div class="picks" id="icoPicks" /></div>
        <div class="foot">
          <span class="note" id="noteRayons">{nombre(rayons.length)} rayons existants</span>
          <button class="pill solid" id="doCreate" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            Créer le rayon
          </button>
        </div>
        <p class="modale__etat" id="etatNew" />
      </div>
    </div>
  </div>

  <script type="application/json" id="donnees-codex" set:html={JSON.stringify(donnees)} />
</Base>

<style is:global>
  /* =====================================================================
     LE CODEX — l'armorial.
     Le thème Parchemin & Bordeaux reste la source de vérité ; cette page y
     ajoute sa famille de cuirs et ses plaques gravées.
     ===================================================================== */
  .codex {
    --l1: #5c4a3d; --l2: #4a4038; --l3: #6b5b4a;
    --l4: #5e4b4e; --l5: #57503f; --l6: #6e5a52;
    --shadow: 0 10px 30px -20px rgba(38, 32, 28, .25);
    --shadow-lift: 0 20px 46px -26px rgba(38, 32, 28, .42);
    --glass: linear-gradient(152deg, rgba(255,253,247,.78), rgba(247,242,231,.44));
    --glass-strong: linear-gradient(152deg, rgba(255,254,250,.92), rgba(247,242,231,.70));
    --glass-accent: linear-gradient(152deg, rgba(255,252,248,.90), rgba(250,236,235,.62) 55%, rgba(243,226,226,.52));
    --accent-soft: rgba(138, 47, 60, .10);
    --accent-line: linear-gradient(90deg, var(--accent), rgba(138, 47, 60, .35));
    --glass-line: rgba(255,255,255,.72);
    --glass-hi: inset 0 1px 0 rgba(255,255,255,.85);
    --blur: blur(16px) saturate(140%);
    --dark-glass: linear-gradient(160deg, rgba(38,33,29,.93), rgba(28,24,21,.90));
    --font-display: var(--display);
    --font-body: var(--texte-police);
    --font-mono: var(--chrome);
    position: relative;
    font-family: var(--font-body);
    line-height: 1.55;
  }
