---
/**
 * Le codex : l'index des catégories.
 *
 * À l'image de la page des royaumes, il ne fait que présenter les catégories
 * comme des portes ; chacune est une page composable (`/lore/[categorie]`), et
 * chaque article l'est aussi. Créer une catégorie se fait ici ; tout le reste
 * se compose sur la page concernée, avec le même atelier que les fiches.
 */
import Base from '../../layouts/Base.astro';
import { lireLore, categoriesDe, articlesDe } from '../../lib/lore';
import { motDePasseDefini, stockage } from '../../lib/stockage';
import { nombre, burgs } from '../../lib/monde';

export const prerender = false;

const lore = await lireLore(Astro.locals);
const categories = categoriesDe(lore);

const donnees = {
  stockageActif: Boolean(stockage(Astro.locals)),
  motDePasseDefini: await motDePasseDefini(Astro.locals),
};
---

<Base titre="Codex" description="Le lore du monde de Victorum : bestiaire, géographie, magie et le reste.">
  <div class="contenant">
    <header class="cartouche">
      <p class="etiquette">Le lore du monde</p>
      <h1>Codex</h1>
    </header>

    <div class="tete-lore">
      <p class="discret tete-lore__intro">
        Tout ce que la carte ne dit pas. Chaque catégorie est une page à part
        entière : ouvre-la pour la mettre en page et y ranger tes articles,
        comme tu composes un royaume.
      </p>
      <button id="nouvelle-categorie" class="bouton bouton--or" type="button">+ Catégorie</button>
    </div>

    <div class="grille grille--lore">
      <a class="carte carte--porte carte--villes" href="/villes">
        <span class="porte__cadre">
          <span class="porte__vide"><i class="lore-marque lore-marque--grande">🏛️</i></span>
        </span>
        <span class="porte__pied">
          <span class="carte__titre">🏛️ Villes</span>
          <span class="carte__meta">{nombre(burgs.length)} localités du monde</span>
        </span>
      </a>
      {
        categories.map((cat) => {
          const n = articlesDe(lore, cat.slug).length;
          return (
            <a class="carte carte--porte" href={`/lore/${cat.slug}`}>
              <span class="porte__cadre">
                {cat.image ? (
                  <img class="porte__image" src={cat.image} alt="" loading="lazy" />
                ) : (
                  <span class="porte__vide"><i class="lore-marque lore-marque--grande">{cat.symbole}</i></span>
                )}
              </span>
              <span class="porte__pied">
                <span class="carte__titre">{cat.symbole} {cat.nom}</span>
                <span class="carte__meta">
                  {n ? `${nombre(n)} article${n > 1 ? 's' : ''}` : 'Vide pour l’instant'}
                  {cat.fixe ? '' : ' · ajoutée'}
                </span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>

  <!-- Créer une catégorie : une porte de plus dans le codex. -->
  <div class="modale" id="modale-cat" hidden>
    <div class="modale__voile" data-fermer></div>
    <div class="modale__boite modale__boite--etroite" role="dialog" aria-label="Nouvelle catégorie">
      <header class="modale__tete">
        <h2>Nouvelle catégorie</h2>
        <button class="fermer" type="button" data-fermer aria-label="Fermer">×</button>
      </header>
      <div class="modale__corps">
        <label class="champ"><span>Nom</span>
          <input id="cat-nom" type="text" maxlength="60" placeholder="Astronomie, Héraldique…" />
        </label>
        <label class="champ"><span>Symbole</span>
          <input id="cat-symbole" type="text" maxlength="4" value="❖" />
        </label>
        <p class="modale__etat" id="cat-etat"></p>
      </div>
      <footer class="modale__pied modale__pied--simple">
        <button class="bouton bouton--plein" id="cat-creer" type="button">Créer et composer</button>
      </footer>
    </div>
  </div>

  <script type="application/json" id="donnees-lore" set:html={JSON.stringify(donnees)} />
</Base>

<style is:global>
  .modale__tete .fermer {
    position: static;
    margin-left: auto;
  }
  .tete-lore {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin: 2rem 0 2.5rem;
    flex-wrap: wrap;
  }
  .tete-lore__intro {
    flex: 1;
    min-width: 20rem;
    max-width: var(--mesure);
    margin: 0;
  }
  .grille--lore {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
  /* Une porte du codex : une image en couverture, un pied qui la nomme. */
  .carte--porte {
    padding: 0;
    overflow: hidden;
  }
  .porte__cadre {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--encre-2);
  }
  .porte__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .porte__vide {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #febe98 0%, #f87472 58%, #df7f83 100%);
  }
  .carte--villes .porte__vide {
    background: #464646;
  }
  .lore-marque--grande {
    width: 74px;
    height: 74px;
    font-size: 2.4rem;
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);
  }
  .porte__pied {
    display: block;
    padding: 0.85rem 1.05rem 1rem;
  }
  .porte__pied .carte__titre {
    font-size: 1.2rem;
  }

  /* Une modale étroite réutilise l'ossature de la chancellerie. */
  .modale__boite--etroite {
    width: min(440px, 100%);
  }
  .modale__corps {
    padding: 1.1rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .modale__corps input[type='text'] {
    padding: 0.5rem 0.7rem;
    background: var(--saisie);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-s);
    color: var(--parchemin);
    font-family: var(--texte-police);
    font-size: 1.0625rem;
  }
  .modale__pied--simple {
    justify-content: flex-end;
  }
</style>

<script>
  const donnees = JSON.parse(document.getElementById('donnees-lore').textContent);
  const CLE_MDP = 'victorum:mot-de-passe';
  const $ = (id) => document.getElementById(id);
  const modale = $('modale-cat');

  $('nouvelle-categorie').addEventListener('click', () => {
    modale.hidden = false;
    $('cat-nom').focus();
  });
  for (const b of modale.querySelectorAll('[data-fermer]')) {
    b.addEventListener('click', () => (modale.hidden = true));
  }

  function motDePasse() {
    let mdp = sessionStorage.getItem(CLE_MDP);
    if (!mdp) {
      mdp = prompt(
        donnees.motDePasseDefini
          ? "Mot de passe de l'atelier :"
          : "Choisis le mot de passe de ton atelier. Il te sera demandé pour toute modification, et personne d'autre ne pourra écrire sur ton site."
      );
      if (mdp) sessionStorage.setItem(CLE_MDP, mdp);
    }
    return mdp;
  }

  $('cat-creer').addEventListener('click', async () => {
    const etat = $('cat-etat');
    if (!donnees.stockageActif) return (etat.textContent = "Stockage non relié : impossible d'enregistrer.");
    const nom = $('cat-nom').value.trim();
    if (!nom) return (etat.textContent = 'Donne un nom à la catégorie.');
    const mdp = motDePasse();
    if (!mdp) return (etat.textContent = 'Mot de passe non saisi.');

    etat.textContent = 'Création…';
    try {
      const r = await fetch('/api/lore', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-mot-de-passe': mdp },
        body: JSON.stringify({ action: 'categorie', nom, symbole: $('cat-symbole').value }),
      });
      const res = await r.json().catch(() => ({}));
      if (r.status === 401) {
        sessionStorage.removeItem(CLE_MDP);
        return (etat.textContent = res.erreur || 'Mot de passe refusé.');
      }
      if (!r.ok) return (etat.textContent = res.erreur || 'Échec.');
      // On ouvre la nouvelle catégorie pour la composer aussitôt.
      const creee = (res.lore.categories || []).find((c) => c.nom === nom);
      location.href = creee ? `/lore/${creee.slug}` : '/lore';
    } catch {
      etat.textContent = 'Réseau indisponible.';
    }
  });
</script>
