---
/**
 * Une chronique : sa présentation composable, puis sa frise vivante.
 *
 * L'en-tête et l'intro se mettent en page avec le même atelier que les fiches.
 * La frise, elle, est une chronologie horizontale — âges en bandes, événements
 * en nœuds alternés, chacun ouvrant une bulle détaillée. Elle se peuple des
 * seuls événements que Romain pose ; vide, elle le dit. Le rendu de la frise
 * est fait par la page à partir des données (pas par le moteur de blocs) :
 * c'est de la donnée vivante, pas une mise en page figée.
 */
import Base from '../../../layouts/Base.astro';
import Atelier from '../../../components/Atelier.astro';
import {
  lireChroniques,
  chroniqueParSlug,
  evenementsDe,
  CATEGORIES_EVT,
  STATUTS_EVT,
} from '../../../lib/chroniques';
import { lirePage, motDePasseDefini, stockage } from '../../../lib/stockage';
import { rendrePage, markdownCourt, CATALOGUE_LORE } from '../../../lib/blocs.js';
import { etats, monde } from '../../../lib/monde';

export const prerender = false;

const data = await lireChroniques(Astro.locals);
const chronique = chroniqueParSlug(data, Astro.params.chronique ?? '');
if (!chronique) return Astro.rewrite('/404');

const evenements = evenementsDe(data, chronique.slug);
const nomEtat = new Map(etats.map((e) => [e.id, e.nom]));
const lien = (() => {
  const m = chronique.portee.match(/^etat:(\d+)$/);
  return m ? { nom: nomEtat.get(Number(m[1])), slug: etats.find((e) => e.id === Number(m[1]))?.slug } : null;
})();

const clePage = `c-${chronique.slug}`;
const enregistre = await lirePage(Astro.locals, 'lore', clePage);

const contexte = {
  type: 'lore',
  slug: chronique.slug,
  titre: chronique.titre,
  surtitre: lien ? `Chronique · ${lien.nom}` : chronique.portee === 'monde' ? 'La grande chronologie' : 'Chronique',
  couleur: chronique.couleur,
  symbole: null,
  blason: null,
  url: `/chronologie/${chronique.slug}`,
  cheminTexte: '',
  corpsHtml: enregistre?.texte ? markdownCourt(enregistre.texte) : chronique.intro ? markdownCourt(chronique.intro) : null,
  position: null,
  faits: [],
  chiffres: [],
  groupes: {},
};

const enregistres = enregistre?.blocs as unknown[] | undefined;
const blocs = enregistres?.length
  ? enregistres
  : [{ type: 'bandeau', largeur: 'pleine', options: chronique.intro ? { accroche: chronique.intro } : {} }];
const html = rendrePage(blocs, contexte);

const stockageActif = Boolean(stockage(Astro.locals));
const mdpDefini = await motDePasseDefini(Astro.locals);

// Âges déjà employés, pour la saisie assistée de l'éditeur.
const eresConnues = [...new Set(evenements.map((e) => e.ere).filter(Boolean))] as string[];

const donneesFrise = {
  slug: chronique.slug,
  teinte: chronique.couleur,
  baseUrl: `/chronologie/${chronique.slug}`,
  categories: CATEGORIES_EVT,
  statuts: STATUTS_EVT,
  evenements: evenements.map((e) => ({
    id: e.id,
    slug: e.slug,
    titre: e.titre,
    an: e.an,
    anFin: e.anFin ?? null,
    resume: e.resume ?? '',
    categorie: e.categorie ?? 'autre',
    statut: e.statut ?? 'atteste',
    couleur: e.couleur,
    ere: e.ere ?? '',
    lieu: e.lieu ?? '',
    acteurs: e.acteurs ?? '',
    consequence: e.consequence ?? '',
    citation: e.citation ?? null,
    tags: e.tags ?? [],
    lien: e.lien ?? '',
    image: e.image ?? '',
  })),
};
---

<Base titre={chronique.titre} description={`${chronique.titre} — chronologie de ${monde.nom}.`}>
  <div class="contenant">
    <div class="lore-outils">
      <a class="bouton" href="/chronologie">‹ Chroniques</a>
      {lien?.slug && <a class="bouton" href={`/etats/${lien.slug}`}>Royaume · {lien.nom}</a>}
      <button class="bouton bouton--plein" id="nouvel-evenement" type="button">+ Événement</button>
      <button class="bouton" id="ouvrir-props" type="button">Propriétés</button>
    </div>

    <Atelier
      contexte={contexte}
      blocs={blocs}
      section="lore"
      slug={clePage}
      texte={enregistre?.texte ?? ''}
      stockageActif={stockageActif}
      motDePasseDefini={mdpDefini}
      catalogue={CATALOGUE_LORE}
    />
    <div id="fiche" set:html={html} />
  </div>

  <!-- La frise vivante. Rendue par le client à partir des événements. -->
  <section class="frise-hote" style={`--teinte:${chronique.couleur}`}>
    <div class="contenant">
      {
        evenements.length === 0 ? (
          <p class="frise-vide discret">
            Aucun événement sur cette frise. Clique « + Événement » pour poser le
            premier — une date, une nature, et ce que tu veux en dire.
          </p>
        ) : (
          <>
            <div class="controls" id="filters"></div>
            <div class="stage">
              <div class="viewport" id="viewport">
                <div class="scroller" id="scroller">
                  <div class="era-lane" id="eraLane"></div>
                  <div class="track" id="track"><div class="spine" id="spine"></div></div>
                </div>
              </div>
            </div>
            <div class="rail"><i id="railFill"></i></div>
            <div class="footline">
              <div class="legend">
                <span><i class="m a"></i>Attesté</span>
                <span><i class="m l"></i>Légende</span>
                <span><i class="m c"></i>Contesté</span>
              </div>
              <span class="hint">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 12h16M4 12l4-4M4 12l4 4M20 12l-4-4M20 12l-4 4"/></svg>
                Glisse ou molette pour traverser les âges
              </span>
            </div>
          </>
        )
      }
    </div>
  </section>

  <!-- La bulle d'un événement : sa chronique complète, ouverte au clic. -->
  <div class="scrim" id="scrim"></div>
  <div class="bubble" id="bubble" role="dialog" aria-modal="false" aria-label="Chronique de l'évènement" hidden>
    <div class="cap"></div>
    <span class="arrow" id="arrow"></span>
    <div class="body">
      <img class="bImg" id="bImg" alt="" hidden />
      <div class="head">
        <span class="badge" id="bBadge"></span>
        <button class="close" id="bClose" type="button" aria-label="Fermer"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      <span class="status" id="bStatus"></span>
      <p class="year" id="bYear"></p>
      <h3 id="bTitle"></h3>
      <p class="desc" id="bDesc"></p>
      <div class="epi" id="bEpi" hidden></div>
      <div class="meta" id="bMeta"></div>
      <div class="conseq" id="bConseq" hidden></div>
      <div class="tags" id="bTags"></div>
      <div class="bActions">
        <a class="bouton bouton--mini" id="bOuvrir" href="#">Ouvrir la page ›</a>
        <button class="bouton bouton--mini" id="bEditer" type="button">Éditer</button>
      </div>
    </div>
  </div>

  <!-- L'atelier d'un événement : tout ce qu'on peut en dire, en un seul endroit. -->
  <div class="modale" id="modale-evt" hidden>
    <div class="modale__voile" data-fermer></div>
    <div class="modale__boite modale__boite--large" role="dialog" aria-label="Événement">
      <header class="modale__tete">
        <h2 id="ev-titre-modale">Nouvel événement</h2>
        <button class="fermer" type="button" data-fermer aria-label="Fermer">×</button>
      </header>
      <div class="modale__corps">
        <input type="hidden" id="ev-id" />
        <label class="champ"><span>Titre</span>
          <input id="ev-titre" type="text" maxlength="120" placeholder="La Croisade de Labria" />
        </label>
        <div class="duo">
          <label class="champ"><span>Année</span>
            <input id="ev-an" type="number" step="1" placeholder="921" />
          </label>
          <label class="champ"><span>Fin (facultative)</span>
            <input id="ev-anfin" type="number" step="1" placeholder="927" />
          </label>
        </div>
        <div class="duo">
          <label class="champ"><span>Âge</span>
            <input id="ev-ere" type="text" maxlength="60" list="eres-connues" placeholder="Âge des Cendres" />
          </label>
          <label class="champ"><span>Nature</span>
            <select id="ev-cat">
              {CATEGORIES_EVT.map((c) => <option value={c.cle}>{c.label}</option>)}
              <option value="__autre">Autre…</option>
            </select>
          </label>
        </div>
        <label class="champ champ--cache" id="ev-cat-libre-champ"><span>Nature libre</span>
          <input id="ev-cat-libre" type="text" maxlength="30" placeholder="Schisme, Découverte…" />
        </label>
        <datalist id="eres-connues">
          {eresConnues.map((e) => <option value={e}></option>)}
        </datalist>
        <div class="duo">
          <label class="champ"><span>Statut</span>
            <select id="ev-statut">
              {STATUTS_EVT.map((s) => <option value={s.cle}>{s.label}</option>)}
            </select>
          </label>
          <label class="champ"><span>Couleur</span>
            <input id="ev-couleur" type="color" value={chronique.couleur} />
            <button type="button" class="lien-mini" id="ev-couleur-auto">Suivre la nature</button>
          </label>
        </div>
        <label class="champ"><span>Description</span>
          <textarea id="ev-resume" rows="3" maxlength="600" placeholder="Ce qui s'est passé, en quelques phrases."></textarea>
        </label>
        <div class="duo">
          <label class="champ"><span>Lieu</span>
            <input id="ev-lieu" type="text" maxlength="120" placeholder="Mont Kaldr, Hautes-Aubes" />
          </label>
          <label class="champ"><span>Acteurs</span>
            <input id="ev-acteurs" type="text" maxlength="160" placeholder="Les Veilleurs · les Peuples des Brumes" />
          </label>
        </div>
        <label class="champ"><span>Conséquence</span>
          <textarea id="ev-consequence" rows="2" maxlength="400" placeholder="Ce que l'événement a changé."></textarea>
        </label>
        <div class="duo">
          <label class="champ"><span>Citation</span>
            <input id="ev-cit-texte" type="text" maxlength="300" placeholder="Et la nuit recula…" />
          </label>
          <label class="champ"><span>Source de la citation</span>
            <input id="ev-cit-source" type="text" maxlength="120" placeholder="Livre des Aubes, tablette I" />
          </label>
        </div>
        <label class="champ"><span>Mots-clés (séparés par des virgules)</span>
          <input id="ev-tags" type="text" maxlength="400" placeholder="Mythe fondateur, Feu sacré" />
        </label>
        <label class="champ"><span>Lien (facultatif)</span>
          <input id="ev-lien" type="text" maxlength="500" placeholder="/etats/… ou https://…" />
        </label>
        <label class="champ"><span>Image (facultative)</span>
          <input id="ev-image" type="text" maxlength="500" placeholder="/illustrations/… ou https://…" />
        </label>
        <p class="modale__etat" id="ev-etat"></p>
      </div>
      <footer class="modale__pied">
        <button class="bouton" id="ev-supprimer" type="button" hidden>Supprimer</button>
        <button class="bouton bouton--plein" id="ev-enregistrer" type="button">Enregistrer</button>
      </footer>
    </div>
  </div>

  <!-- Propriétés de la chronique. -->
  <div class="modale" id="modale-props" hidden>
    <div class="modale__voile" data-fermer></div>
    <div class="modale__boite modale__boite--etroite" role="dialog" aria-label="Propriétés de la chronique">
      <header class="modale__tete">
        <h2>Propriétés</h2>
        <button class="fermer" type="button" data-fermer aria-label="Fermer">×</button>
      </header>
      <div class="modale__corps">
        <label class="champ"><span>Titre</span>
          <input id="pc-titre" type="text" maxlength="80" value={chronique.titre} disabled={chronique.fixe} />
        </label>
        <label class="champ"><span>Couleur</span>
          <input id="pc-couleur" type="color" value={chronique.couleur} />
        </label>
        <label class="champ"><span>Image de couverture</span>
          <input id="pc-image" type="text" maxlength="500" value={chronique.image ?? ''} placeholder="/illustrations/… ou https://…" />
        </label>
        <label class="champ"><span>Présentation</span>
          <textarea id="pc-intro" rows="3" maxlength="400">{chronique.intro ?? ''}</textarea>
        </label>
        {chronique.fixe && <p class="modale__note">La chronologie du monde ne se renomme ni ne se supprime.</p>}
        <p class="modale__etat" id="pc-etat"></p>
      </div>
      <footer class="modale__pied modale__pied--simple">
        {!chronique.fixe && <button class="bouton" id="pc-supprimer" type="button">Supprimer</button>}
        <button class="bouton bouton--plein" id="pc-enregistrer" type="button">Enregistrer</button>
      </footer>
    </div>
  </div>

  <script type="application/json" id="donnees-frise" set:html={JSON.stringify(donneesFrise)} />
  <script
    type="application/json"
    id="donnees-ch"
    set:html={JSON.stringify({ slug: chronique.slug, fixe: Boolean(chronique.fixe), stockageActif, motDePasseDefini: mdpDefini })}
  />
</Base>

<style is:global>
  .modale__tete .fermer { position: static; margin-left: auto; }
  .lore-outils { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  .modale__note { margin: 0; font-family: var(--chrome); font-size: 0.6875rem; color: var(--parchemin-faible); }
  .champ--cache { display: none; }
  .champ--cache.ouvert { display: flex; }
  .lien-mini {
    background: none; border: 0; padding: 0; margin-top: 0.3rem; cursor: pointer; align-self: flex-start;
    font-family: var(--chrome); font-size: 0.62rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--parchemin-doux);
  }
  .lien-mini:hover { color: var(--or); }
  .modale__boite--large { width: min(620px, 100%); }
  .modale__corps input[type='text'],
  .modale__corps input[type='number'],
  .modale__corps select,
  .modale__corps textarea {
    padding: 0.5rem 0.7rem; background: var(--saisie); border: 1px solid var(--trait);
    border-radius: var(--rayon-s); color: var(--parchemin); font-family: var(--texte-police);
    font-size: 1.0625rem; width: 100%;
  }
  .modale__corps textarea { resize: vertical; }
  .modale__corps input[type='color'] {
    height: 38px; padding: 2px; background: var(--saisie);
    border: 1px solid var(--trait); border-radius: var(--rayon-s); cursor: pointer; width: 100%;
  }
  .bouton--mini { padding: 0.34rem 0.8rem; font-size: 0.7rem; }

  /* =====================================================================
     La frise — chronologie horizontale posée sur l'atmosphère du monde.
     Structure et gestes repris d'une référence de Romain ; les couleurs
     suivent les tokens du site, les teintes de nature restent parlantes.
     ===================================================================== */

  .frise-hote { margin-top: 2.5rem; }
  .frise-vide {
    border: 1px dashed var(--trait-vif); border-radius: var(--rayon);
    padding: 2.4rem; text-align: center; background: var(--verre); backdrop-filter: var(--flou);
    box-shadow: var(--ombre-basse), var(--lueur);
  }

  /* Plaque de verre : la forme de base de tout ce qui flotte sur la frise. */
  :root { --fr-verre: linear-gradient(150deg, rgba(255,255,255,.7), rgba(255,255,255,.42)); }
  :root { --fr-verre-fort: linear-gradient(150deg, rgba(255,255,255,.86), rgba(255,255,255,.62)); }
  :root { --fr-bord: rgba(255,255,255,.7); }
  :root { --fr-hi: inset 0 1px 0 rgba(255,255,255,.85); }

  .controls { display: flex; gap: 0.55rem; flex-wrap: wrap; margin: 0 0 0.3rem; align-items: center; }
  .chip {
    font-family: var(--chrome); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.04em;
    border: 1px solid var(--trait); background: var(--fr-verre); backdrop-filter: var(--flou);
    color: var(--parchemin-doux); padding: 0.5rem 0.85rem 0.5rem 0.72rem; border-radius: var(--pilule);
    cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem;
    box-shadow: var(--ombre-basse), var(--fr-hi); transition: color .2s, transform .18s, box-shadow .2s;
  }
  .chip:hover { transform: translateY(-2px); color: var(--parchemin); }
  .chip .swatch { width: 9px; height: 9px; border-radius: 50%; background: var(--dot, var(--parchemin-faible)); box-shadow: 0 0 8px var(--dot, transparent); }
  .chip[aria-pressed="true"] { color: #fff; border-color: color-mix(in srgb, var(--dot, var(--parchemin)) 55%, white); background: linear-gradient(150deg, color-mix(in srgb, var(--dot, var(--parchemin)) 88%, white), var(--dot, var(--parchemin))); }
  .chip[data-cat="all"][aria-pressed="true"] { background: linear-gradient(150deg, #4a4038, var(--parchemin)); }
  .chip[aria-pressed="true"] .swatch { background: rgba(255,255,255,.95); box-shadow: 0 0 8px rgba(255,255,255,.6); }
  .toggle {
    margin-left: auto; display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--chrome);
    font-size: 0.72rem; color: var(--parchemin-doux); border: 1px solid var(--trait); background: var(--fr-verre);
    backdrop-filter: var(--flou); padding: 0.45rem 0.8rem; border-radius: var(--pilule); cursor: pointer;
    box-shadow: var(--ombre-basse), var(--fr-hi);
  }
  .toggle .sw { width: 34px; height: 19px; border-radius: 999px; background: color-mix(in srgb, var(--parchemin-faible) 55%, transparent); position: relative; transition: background .25s; flex: none; }
  .toggle .sw::after { content: ""; position: absolute; top: 2px; left: 2px; width: 15px; height: 15px; border-radius: 50%; background: #fff; box-shadow: 0 2px 5px rgba(0,0,0,.3); transition: transform .28s cubic-bezier(.34,1.56,.64,1); }
  .toggle[aria-pressed="true"] .sw { background: linear-gradient(120deg, #c6982f, #d5a044); }
  .toggle[aria-pressed="true"] .sw::after { transform: translateX(15px); }
  .count { font-family: var(--chrome); font-size: 0.64rem; color: var(--parchemin-faible); width: 100%; text-align: right; letter-spacing: 0.04em; }

  .stage { position: relative; margin-top: 0.8rem; }
  .viewport {
    overflow-x: auto; overflow-y: hidden; padding: 0.5rem 0 0.4rem;
    scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--teinte) 45%, transparent) transparent;
    cursor: grab; -webkit-overflow-scrolling: touch;
  }
  .viewport.dragging { cursor: grabbing; scroll-behavior: auto; }
  .viewport::-webkit-scrollbar { height: 8px; }
  .viewport::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--teinte) 45%, transparent); border-radius: 8px; }
  .viewport::-webkit-scrollbar-track { background: transparent; }

  .scroller { position: relative; }
  .era-lane { position: relative; height: 32px; margin-bottom: 4px; }
  .era { position: absolute; top: 0; height: 100%; display: flex; align-items: center; justify-content: center; pointer-events: none; }
  .era .lab {
    font-family: var(--chrome); font-size: 0.6rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: color-mix(in srgb, var(--era) 70%, var(--parchemin)); white-space: nowrap; padding: 0.32rem 0.85rem; border-radius: 999px;
    background: color-mix(in srgb, var(--era) 15%, transparent); backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--era) 30%, transparent); box-shadow: var(--fr-hi);
  }

  .track { position: relative; height: 456px; }
  .era-band { position: absolute; top: 0; bottom: 0; z-index: 0; border-radius: 26px; background: color-mix(in srgb, var(--era) 9%, transparent); }
  .era-div { position: absolute; top: 10px; bottom: 10px; width: 0; border-left: 1px dashed color-mix(in srgb, var(--parchemin-doux) 45%, transparent); opacity: .55; z-index: 0; }
  .spine {
    position: absolute; top: 50%; left: 0; height: 4px; border-radius: 4px;
    transform: translateY(-50%) scaleX(var(--draw, 1)); transform-origin: left center;
    background: linear-gradient(90deg, color-mix(in srgb, var(--teinte) 45%, #fff), var(--teinte) 60%, color-mix(in srgb, var(--teinte) 80%, #000 12%));
    box-shadow: 0 0 18px color-mix(in srgb, var(--teinte) 45%, transparent); z-index: 1;
  }
  .year-tick {
    position: absolute; top: 50%; transform: translate(-50%, -50%); font-family: var(--chrome);
    font-size: 0.62rem; font-weight: 500; font-variant-numeric: tabular-nums; letter-spacing: 0.03em;
    color: var(--parchemin-doux); background: var(--fr-verre-fort); backdrop-filter: blur(10px);
    padding: 0.18rem 0.5rem; border-radius: 8px; pointer-events: none; border: 1px solid var(--trait);
    box-shadow: var(--fr-hi); z-index: 1;
  }

  .event { position: absolute; top: 0; height: 100%; width: 230px; transform: translateX(-50%); z-index: 2; opacity: 0; }
  .event.in { animation: fr-pop .55s cubic-bezier(.2,.7,.3,1) forwards; }
  @keyframes fr-pop { from { opacity: 0; transform: translateX(-50%) translateY(12px); } to { opacity: 1; transform: translateX(-50%) translateY(0); } }

  .event .node {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 22px; height: 22px; border-radius: 50%;
    border: 1px solid var(--fr-bord); padding: 0; cursor: pointer; background: var(--fr-verre-fort); backdrop-filter: blur(6px);
    display: grid; place-items: center; z-index: 3;
    box-shadow: 0 0 0 5px var(--encre), 0 4px 10px -2px rgba(42,36,32,.28), inset 0 1px 1px rgba(255,255,255,.9);
    transition: transform .28s cubic-bezier(.34,1.56,.64,1), box-shadow .28s;
  }
  .event .node::after { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--cat); box-shadow: 0 0 8px color-mix(in srgb, var(--cat) 70%, transparent); }
  .event .node::before { content: ""; position: absolute; inset: -5px; border-radius: 50%; background: var(--cat); opacity: .25; transform: scale(.4); transition: transform .3s, opacity .3s; }
  .event .node:hover { transform: translate(-50%, -50%) scale(1.2); }
  .event .node:hover::before, .event.active .node::before { transform: scale(1); opacity: .2; }
  .event.active .node { box-shadow: 0 0 0 5px var(--encre), 0 0 0 7px var(--cat), 0 4px 12px -2px rgba(42,36,32,.28); }
  .event .node:focus-visible { outline: none; box-shadow: 0 0 0 5px var(--encre), 0 0 0 7px var(--cat); }
  .event.st-legende .node::after { background: transparent; border: 2px solid var(--cat); box-shadow: none; }
  .event.st-conteste .node::after { background: var(--cat); opacity: .42; }

  .event .stem { position: absolute; left: 50%; width: 2px; transform: translateX(-50%); opacity: .5; z-index: 1; }
  .event.top .stem { bottom: 50%; height: 64px; background: linear-gradient(0deg, var(--cat), transparent); }
  .event.bottom .stem { top: 50%; height: 64px; background: linear-gradient(180deg, var(--cat), transparent); }

  .card {
    position: absolute; left: 50%; transform: translateX(-50%); width: 212px; text-align: left; display: flex; flex-direction: column;
    align-items: flex-start; background: var(--fr-verre); backdrop-filter: var(--flou); border: 1px solid var(--fr-bord);
    border-radius: 18px; padding: 0.85rem 1rem; cursor: pointer; box-shadow: var(--ombre), var(--fr-hi); z-index: 2;
    transition: transform .32s cubic-bezier(.34,1.4,.64,1), box-shadow .3s, border-color .3s;
  }
  .event.top .card { bottom: calc(50% + 70px); }
  .event.bottom .card { top: calc(50% + 70px); }
  .card:hover { transform: translateX(-50%) translateY(-4px); box-shadow: 0 22px 50px -18px rgba(42,36,32,.4), var(--fr-hi); }
  .event.active .card { border-color: color-mix(in srgb, var(--cat) 60%, var(--fr-bord)); }
  .card .k { display: flex; align-items: center; gap: 0.45rem; font-family: var(--chrome); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.05em; font-variant-numeric: tabular-nums; color: var(--parchemin-doux); text-transform: uppercase; }
  .card .k b { width: 7px; height: 7px; border-radius: 50%; background: var(--cat); flex: none; box-shadow: 0 0 6px color-mix(in srgb, var(--cat) 70%, transparent); }
  .card .t { margin: 0.5rem 0 0; font-family: var(--display); font-weight: 400; font-size: 1.12rem; line-height: 1.12; color: var(--parchemin); letter-spacing: 0.005em; }
  .card .cat { margin-top: 0.55rem; font-family: var(--chrome); font-size: 0.64rem; color: var(--parchemin-faible); }
  .card .cat .st { font-weight: 600; color: var(--sc); }

  .event.dim { pointer-events: none; }
  .event.dim .card, .event.dim .node, .event.dim .stem { opacity: .13; filter: grayscale(.5); }

  .rail { margin: 1.4rem auto 0; height: 5px; width: min(360px, 70%); background: color-mix(in srgb, var(--parchemin-doux) 22%, transparent); border-radius: 5px; overflow: hidden; box-shadow: var(--fr-hi); }
  .rail i { display: block; height: 100%; width: 20%; background: linear-gradient(90deg, color-mix(in srgb, var(--teinte) 45%, #fff), var(--teinte)); border-radius: 5px; }
  .footline { display: flex; justify-content: center; align-items: center; gap: 1.4rem; flex-wrap: wrap; margin: 0.9rem 0 0; }
  .legend { display: flex; gap: 1rem; flex-wrap: wrap; font-family: var(--chrome); font-size: 0.64rem; font-weight: 500; color: var(--parchemin-doux); letter-spacing: 0.02em; }
  .legend span { display: inline-flex; align-items: center; gap: 0.45rem; }
  .legend .m { width: 12px; height: 12px; border-radius: 50%; flex: none; }
  .legend .m.a { background: var(--parchemin-doux); }
  .legend .m.l { background: transparent; border: 2px solid var(--parchemin-doux); }
  .legend .m.c { background: var(--parchemin-doux); opacity: .42; }
  .hint { font-family: var(--chrome); font-size: 0.64rem; color: var(--parchemin-faible); letter-spacing: 0.02em; display: inline-flex; align-items: center; gap: 0.45rem; }
  .hint svg { width: 13px; height: 13px; opacity: .7; }

  /* ------------------------------------------------------------- la bulle */
  .bubble {
    position: fixed; z-index: 70; width: min(364px, 92vw); background: var(--fr-verre-fort);
    backdrop-filter: blur(28px) saturate(160%); border: 1px solid var(--fr-bord); border-radius: var(--rayon);
    box-shadow: var(--ombre), 0 40px 80px -30px rgba(42,36,32,.4), var(--fr-hi); overflow: hidden; opacity: 0;
    transform: scale(.92) translateY(8px); transform-origin: var(--org, center bottom); pointer-events: none;
    transition: opacity .24s, transform .32s cubic-bezier(.34,1.56,.64,1);
  }
  .bubble.show { opacity: 1; transform: scale(1) translateY(0); pointer-events: auto; }
  .bubble[hidden] { display: block; }
  .bubble .cap { height: 5px; background: linear-gradient(90deg, var(--cat), color-mix(in srgb, var(--cat) 40%, white)); }
  .bubble .body { padding: 1.1rem 1.3rem 1.3rem; max-height: 78vh; overflow-y: auto; }
  .bubble .bImg { width: 100%; height: 130px; object-fit: cover; border-radius: 12px; margin-bottom: 0.9rem; border: 1px solid var(--trait); }
  .bubble .head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .bubble .badge {
    display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--chrome); font-size: 0.62rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--cat); background: color-mix(in srgb, var(--cat) 15%, transparent);
    padding: 0.36rem 0.65rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--cat) 26%, transparent);
  }
  .bubble .badge svg { width: 13px; height: 13px; }
  .bubble .close { border: 1px solid var(--fr-bord); background: var(--fr-verre); color: var(--parchemin-doux); width: 30px; height: 30px; border-radius: 50%; cursor: pointer; display: grid; place-items: center; flex: none; transition: background .2s, color .2s, transform .25s; }
  .bubble .close:hover { background: var(--cat); color: #fff; transform: rotate(90deg); }
  .bubble .status { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0.85rem 0 0; font-family: var(--chrome); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sc); background: color-mix(in srgb, var(--sc) 16%, transparent); padding: 0.32rem 0.65rem; border-radius: 999px; }
  .bubble .status .d { width: 7px; height: 7px; border-radius: 50%; background: var(--sc); }
  .bubble .year { font-family: var(--chrome); font-size: 0.72rem; font-variant-numeric: tabular-nums; color: var(--parchemin-doux); margin: 0.8rem 0 0; }
  .bubble h3 { font-family: var(--display); font-weight: 400; font-size: 1.45rem; line-height: 1.08; margin: 0.25rem 0 0; letter-spacing: 0.005em; text-wrap: balance; }
  .bubble p.desc { margin: 0.75rem 0 0; font-size: 0.95rem; color: var(--parchemin); line-height: 1.55; }
  .bubble .epi { margin: 0.95rem 0 0; padding: 0.7rem 0.9rem; border-left: 3px solid color-mix(in srgb, var(--cat) 55%, transparent); background: color-mix(in srgb, var(--cat) 7%, transparent); border-radius: 0 12px 12px 0; }
  .bubble .epi q { font-family: var(--display); font-style: italic; font-size: 1rem; line-height: 1.45; color: var(--parchemin); quotes: "«\00a0" "\00a0»"; }
  .bubble .epi cite { display: block; margin-top: 0.45rem; font-style: normal; font-family: var(--chrome); font-size: 0.64rem; font-weight: 500; color: var(--parchemin-doux); letter-spacing: 0.02em; }
  .bubble .meta { margin: 1rem 0 0; display: flex; flex-direction: column; gap: 0.65rem; }
  .bubble .row { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.88rem; }
  .bubble .row svg { width: 15px; height: 15px; flex: none; color: var(--parchemin-doux); margin-top: 2px; }
  .bubble .row .lb { font-family: var(--chrome); font-size: 0.58rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--parchemin-faible); width: 54px; flex: none; margin-top: 3px; }
  .bubble .row .vl { color: var(--parchemin); }
  .bubble .conseq { margin: 1rem 0 0; padding: 0.75rem 0.9rem; border-radius: 14px; background: color-mix(in srgb, var(--cat) 10%, transparent); border: 1px solid color-mix(in srgb, var(--cat) 24%, transparent); }
  .bubble .conseq .lb { font-family: var(--chrome); font-size: 0.58rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cat); display: block; margin-bottom: 0.3rem; }
  .bubble .conseq p { margin: 0; font-size: 0.88rem; color: var(--parchemin); line-height: 1.5; }
  .bubble .tags { margin: 1rem 0 0; display: flex; gap: 0.45rem; flex-wrap: wrap; }
  .bubble .tags:empty { display: none; }
  .bubble .tag { font-family: var(--chrome); font-size: 0.66rem; color: var(--parchemin-doux); background: var(--fr-verre); border: 1px solid var(--trait); padding: 0.3rem 0.6rem; border-radius: 999px; }
  .bubble .bActions { margin: 1.1rem 0 0; display: flex; gap: 0.5rem; }
  .bubble .arrow { position: absolute; width: 15px; height: 15px; background: var(--fr-verre-fort); backdrop-filter: blur(28px); border: 1px solid var(--fr-bord); transform: rotate(45deg); z-index: -1; }
  .scrim { position: fixed; inset: 0; z-index: 65; background: transparent; opacity: 0; pointer-events: none; transition: opacity .2s; }
  .scrim.show { opacity: 1; pointer-events: auto; }

  @media (max-width: 560px) { .track { height: 416px; } .event { width: 200px; } .card { width: 186px; } }
  @media (prefers-reduced-motion: reduce) {
    .event.in { animation: none; opacity: 1; }
    .spine { transform: translateY(-50%); }
  }
</style>

<script>
  import { brancherTeleversement } from '../../../lib/upload.js';

  const D = JSON.parse(document.getElementById('donnees-frise').textContent);
  const meta = JSON.parse(document.getElementById('donnees-ch').textContent);
  const CLE_MDP = 'victorum:mot-de-passe';
  const $ = (id) => document.getElementById(id);
  const fmt = new Intl.NumberFormat('fr-FR');
  const CATS = Object.fromEntries(D.categories.map((c) => [c.cle, c]));
  const STAT = Object.fromEntries(D.statuts.map((s) => [s.cle, s]));
  const catDe = (k) => CATS[k] || { cle: k, label: k ? k[0].toUpperCase() + k.slice(1) : 'Événement', couleur: '#b24634', icone: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>' };
  const statDe = (k) => STAT[k] || D.statuts[0];
  const svg = (inner, w) => '<svg viewBox="0 0 24 24" width="' + (w || 15) + '" height="' + (w || 15) + '" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + inner + '</svg>';
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const anLabel = (y) => 'An ' + fmt.format(y);

  const IC = {
    era: '<path d="M6 3h12M6 21h12M8 3c0 4 8 5 8 9s-8 5-8 9M16 3c0 4-8 5-8 9"/>',
    place: '<path d="M12 21s6-5.3 6-10a6 6 0 1 0-12 0c0 4.7 6 10 6 10z"/><circle cx="12" cy="11" r="2.3"/>',
    actors: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-5 6-5s6 1.7 6 5"/><path d="M16 6.2A3 3 0 0 1 18 12M21 20c0-2.6-1.4-4.2-3.6-4.8"/>',
  };

  /* ===================== construction de la frise ===================== */
  const EV = D.evenements;
  const hasFrise = EV.length > 0;
  const SLOT = 262, PAD = 150;
  let nodes = [], current = 'all', legendsOn = true;
  let activeIdx = -1, activeEl = null;

  if (hasFrise) construireFrise();

  function construireFrise() {
    const scroller = $('scroller'), track = $('track'), eraLane = $('eraLane'), spine = $('spine'), viewport = $('viewport');
    const trackW = PAD * 2 + (EV.length - 1) * SLOT;
    [scroller, track, eraLane, spine].forEach((el) => (el.style.width = trackW + 'px'));
    const xOf = (i) => PAD + i * SLOT;

    // Âges : bandes des événements consécutifs partageant le même âge.
    const aDesEres = EV.some((e) => e.ere);
    if (aDesEres) {
      const eras = [];
      EV.forEach((ev, i) => {
        const last = eras[eras.length - 1];
        const nom = ev.ere || '—';
        if (last && last.name === nom) last.end = i;
        else eras.push({ name: nom, start: i, end: i, couleur: ev.couleur });
      });
      eras.forEach((er, idx) => {
        let left = xOf(er.start) - SLOT / 2, right = xOf(er.end) + SLOT / 2;
        if (idx === 0) left = 0;
        if (idx === eras.length - 1) right = trackW;
        const band = document.createElement('div');
        band.className = 'era-band'; band.style.left = left + 'px'; band.style.width = (right - left) + 'px';
        band.style.setProperty('--era', er.couleur); track.appendChild(band);
        if (idx > 0) { const d = document.createElement('div'); d.className = 'era-div'; d.style.left = left + 'px'; track.appendChild(d); }
        if (er.name !== '—') {
          const lab = document.createElement('div');
          lab.className = 'era'; lab.style.left = left + 'px'; lab.style.width = (right - left) + 'px';
          lab.style.setProperty('--era', er.couleur); lab.innerHTML = '<span class="lab">' + esc(er.name) + '</span>';
          eraLane.appendChild(lab);
        }
      });
    } else {
      eraLane.style.display = 'none';
    }

    // Filtres : « Tout » + une puce par nature présente, + bascule légendes.
    const fWrap = $('filters');
    const presentes = [...new Set(EV.map((e) => e.categorie))];
    const chip = (cat, label, dot) => {
      const b = document.createElement('button');
      b.className = 'chip'; b.dataset.cat = cat; b.type = 'button'; b.setAttribute('aria-pressed', cat === 'all');
      if (dot) b.style.setProperty('--dot', dot);
      b.innerHTML = '<span class="swatch"></span>' + esc(label);
      b.addEventListener('click', () => { current = cat; applyFilter(); });
      return b;
    };
    fWrap.appendChild(chip('all', 'Tout', null));
    presentes.forEach((k) => fWrap.appendChild(chip(k, catDe(k).label, catDe(k).couleur)));
    const aDesRecits = EV.some((e) => e.statut !== 'atteste');
    if (aDesRecits) {
      const toggle = document.createElement('button');
      toggle.className = 'toggle'; toggle.type = 'button'; toggle.setAttribute('aria-pressed', 'true');
      toggle.innerHTML = '<span class="sw"></span>Légendes & récits';
      toggle.addEventListener('click', () => { legendsOn = !legendsOn; toggle.setAttribute('aria-pressed', legendsOn); applyFilter(); });
      fWrap.appendChild(toggle);
    }
    const countEl = document.createElement('span'); countEl.className = 'count'; fWrap.appendChild(countEl);
    fWrap._countEl = countEl;

    // Événements.
    EV.forEach((ev, i) => {
      const cat = catDe(ev.categorie), st = statDe(ev.statut);
      const el = document.createElement('div');
      el.className = 'event ' + (i % 2 === 0 ? 'top' : 'bottom') + ' st-' + ev.statut;
      el.style.left = xOf(i) + 'px'; el.style.setProperty('--cat', ev.couleur); el.style.setProperty('--sc', st.couleur);
      const an = anLabel(ev.an) + (ev.anFin != null ? '–' + fmt.format(ev.anFin) : '');
      el.innerHTML =
        '<div class="stem"></div>' +
        '<button class="node" type="button" aria-label="' + esc(ev.titre) + ' — ' + esc(st.label) + '"></button>' +
        '<button class="card" type="button"><span class="k"><b></b>' + esc(an) + '</span>' +
        '<span class="t">' + esc(ev.titre) + '</span>' +
        '<span class="cat">' + esc(cat.label) + ' · <span class="st">' + esc(st.label) + '</span></span></button>';
      track.appendChild(el);
      el.querySelector('.node').addEventListener('click', (e) => { e.stopPropagation(); openBubble(i, el); });
      el.querySelector('.card').addEventListener('click', (e) => { e.stopPropagation(); openBubble(i, el); });
      nodes.push({ el, ev });
      setTimeout(() => el.classList.add('in'), 120 + i * 55);
    });
    EV.forEach((ev, i) => {
      const t = document.createElement('div'); t.className = 'year-tick'; t.textContent = fmt.format(ev.an);
      t.style.left = xOf(i) + 'px'; t.style.top = (i % 2 === 0 ? '62%' : '38%'); track.appendChild(t);
    });

    // Défilement horizontal : molette, glissé, rail.
    viewport.addEventListener('wheel', (e) => { if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) { viewport.scrollLeft += e.deltaY; e.preventDefault(); } }, { passive: false });
    let down = false, startX = 0, startL = 0;
    viewport.addEventListener('pointerdown', (e) => { if (e.target.closest('.card') || e.target.closest('.node')) return; down = true; startX = e.clientX; startL = viewport.scrollLeft; viewport.classList.add('dragging'); viewport.setPointerCapture(e.pointerId); });
    viewport.addEventListener('pointermove', (e) => { if (down) viewport.scrollLeft = startL - (e.clientX - startX); });
    const up = () => { down = false; viewport.classList.remove('dragging'); };
    viewport.addEventListener('pointerup', up); viewport.addEventListener('pointercancel', up);
    viewport.addEventListener('scroll', () => { if (activeIdx >= 0) position(); updateRail(); }, { passive: true });
    window.addEventListener('resize', () => { if (activeIdx >= 0) position(); updateRail(); });

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      spine.style.setProperty('--draw', '0');
      requestAnimationFrame(() => { spine.style.transition = 'transform 1.1s cubic-bezier(.22,.7,.2,1)'; spine.style.setProperty('--draw', '1'); });
    }
    applyFilter(); updateRail();
  }

  function applyFilter() {
    const fWrap = $('filters');
    fWrap.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', c.dataset.cat === current));
    let shown = 0;
    nodes.forEach((n) => {
      const vis = (current === 'all' || n.ev.categorie === current) && (n.ev.statut === 'atteste' || legendsOn);
      n.el.classList.toggle('dim', !vis); if (vis) shown++;
    });
    if (fWrap._countEl) fWrap._countEl.textContent = shown + (shown > 1 ? ' évènements visibles' : ' évènement visible');
    closeBubble();
  }

  function updateRail() {
    const viewport = $('viewport'), railFill = $('railFill'); if (!viewport || !railFill) return;
    const max = viewport.scrollWidth - viewport.clientWidth;
    const ratio = max > 0 ? viewport.scrollLeft / max : 0;
    const vis = Math.max(.14, viewport.clientWidth / viewport.scrollWidth);
    railFill.style.width = (vis * 100) + '%'; railFill.style.marginLeft = (ratio * (100 - vis * 100)) + '%';
  }

  /* ========================= la bulle détaillée ========================= */
  const bubble = $('bubble'), scrim = $('scrim'), arrow = $('arrow');
  const metaRow = (icon, label, val) => '<div class="row">' + svg(icon) + '<span class="lb">' + label + '</span><span class="vl">' + esc(val) + '</span></div>';

  function openBubble(i, el) {
    const ev = EV[i], cat = catDe(ev.categorie), st = statDe(ev.statut);
    if (activeEl) activeEl.classList.remove('active');
    activeIdx = i; activeEl = el; el.classList.add('active');
    bubble.style.setProperty('--cat', ev.couleur); bubble.style.setProperty('--sc', st.couleur);
    const img = $('bImg');
    if (ev.image) { img.src = ev.image; img.hidden = false; } else { img.hidden = true; img.removeAttribute('src'); }
    $('bBadge').innerHTML = svg(cat.icone, 13) + esc(cat.label);
    $('bStatus').innerHTML = '<span class="d"></span>' + esc(st.label);
    $('bYear').textContent = anLabel(ev.an) + (ev.anFin != null ? ' → ' + anLabel(ev.anFin) : '') + (ev.ere ? '  ·  ' + ev.ere : '');
    $('bTitle').textContent = ev.titre;
    const desc = $('bDesc'); desc.textContent = ev.resume || ''; desc.hidden = !ev.resume;
    const epi = $('bEpi');
    if (ev.citation && ev.citation.texte) { epi.hidden = false; epi.innerHTML = '<q>' + esc(ev.citation.texte) + '</q>' + (ev.citation.source ? '<cite>' + esc(ev.citation.source) + '</cite>' : ''); }
    else epi.hidden = true;
    let rows = '';
    if (ev.ere) rows += metaRow(IC.era, 'Âge', ev.ere);
    if (ev.lieu) rows += metaRow(IC.place, 'Lieu', ev.lieu);
    if (ev.acteurs) rows += metaRow(IC.actors, 'Acteurs', ev.acteurs);
    $('bMeta').innerHTML = rows;
    const cq = $('bConseq');
    if (ev.consequence) { cq.hidden = false; cq.innerHTML = '<span class="lb">Conséquence</span><p>' + esc(ev.consequence) + '</p>'; }
    else cq.hidden = true;
    $('bTags').innerHTML = (ev.tags || []).map((t) => '<span class="tag">' + esc(t) + '</span>').join('');
    $('bOuvrir').href = D.baseUrl + '/' + ev.slug;
    $('bEditer').onclick = () => { closeBubble(); ouvrirEditeur(ev); };
    scrim.classList.add('show'); bubble.classList.add('show'); position();
  }
  function position() {
    if (activeIdx < 0 || !activeEl) return;
    const r = activeEl.querySelector('.node').getBoundingClientRect();
    const bw = bubble.offsetWidth, bh = bubble.offsetHeight, gap = 16, margin = 10;
    const cx = r.left + r.width / 2;
    const left = Math.max(margin, Math.min(cx - bw / 2, innerWidth - bw - margin));
    const below = r.top < bh + gap + 20;
    let top = below ? r.bottom + gap : r.top - bh - gap;
    top = Math.max(margin, Math.min(top, innerHeight - bh - margin));
    bubble.style.left = left + 'px'; bubble.style.top = top + 'px'; bubble.style.setProperty('--org', below ? 'center top' : 'center bottom');
    const ax = Math.max(16, Math.min(cx - left - 7, bw - 30)); arrow.style.left = ax + 'px';
    if (below) { arrow.style.top = '-1px'; arrow.style.borderRight = 'none'; arrow.style.borderBottom = 'none'; arrow.style.borderTop = '1px solid var(--fr-bord)'; arrow.style.borderLeft = '1px solid var(--fr-bord)'; }
    else { arrow.style.top = (bh - 7) + 'px'; arrow.style.borderTop = 'none'; arrow.style.borderLeft = 'none'; arrow.style.borderRight = '1px solid var(--fr-bord)'; arrow.style.borderBottom = '1px solid var(--fr-bord)'; }
  }
  function closeBubble() { bubble.classList.remove('show'); scrim.classList.remove('show'); if (activeEl) activeEl.classList.remove('active'); activeEl = null; activeIdx = -1; }
  $('bClose').addEventListener('click', closeBubble);
  scrim.addEventListener('click', closeBubble);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeBubble(); fermerEditeur(); } });

  /* ===================== l'atelier d'un événement ===================== */
  const modale = $('modale-evt');
  brancherTeleversement({ champ: $('ev-image'), motDePasse, etat: $('ev-etat') });
  brancherTeleversement({ champ: $('pc-image'), motDePasse, etat: $('pc-etat') });

  function motDePasse() {
    let mdp = sessionStorage.getItem(CLE_MDP);
    if (!mdp) {
      mdp = prompt(meta.motDePasseDefini ? "Mot de passe de l'atelier :" : "Choisis le mot de passe de ton atelier. Il te sera demandé pour toute modification, et personne d'autre ne pourra écrire sur ton site.");
      if (mdp) sessionStorage.setItem(CLE_MDP, mdp);
    }
    return mdp;
  }

  async function envoyer(corps, etatEl) {
    if (!meta.stockageActif) { if (etatEl) etatEl.textContent = 'Stockage non relié.'; return null; }
    const mdp = motDePasse(); if (!mdp) return null;
    const r = await fetch('/api/chroniques', { method: 'POST', headers: { 'content-type': 'application/json', 'x-mot-de-passe': mdp }, body: JSON.stringify(corps) });
    const res = await r.json().catch(() => ({}));
    if (r.status === 401) { sessionStorage.removeItem(CLE_MDP); if (etatEl) etatEl.textContent = res.erreur || 'Mot de passe refusé.'; return null; }
    if (!r.ok) { if (etatEl) etatEl.textContent = res.erreur || 'Échec.'; return null; }
    return res.chroniques;
  }

  function fermerEditeur() { modale.hidden = true; }
  for (const b of modale.querySelectorAll('[data-fermer]')) b.addEventListener('click', fermerEditeur);

  // Bascule du champ « nature libre » selon le choix du menu.
  const catSel = $('ev-cat'), catLibreChamp = $('ev-cat-libre-champ'), catLibre = $('ev-cat-libre');
  const majCatLibre = () => catLibreChamp.classList.toggle('ouvert', catSel.value === '__autre');
  catSel.addEventListener('change', majCatLibre);
  // « Suivre la nature » : réaligne la couleur sur la teinte de la nature.
  $('ev-couleur-auto').addEventListener('click', () => {
    const cle = catSel.value === '__autre' ? '' : catSel.value;
    const c = catDe(cle); if (c && c.couleur) $('ev-couleur').value = c.couleur;
  });

  function ouvrirEditeur(ev) {
    $('ev-titre-modale').textContent = ev ? 'Modifier l’événement' : 'Nouvel événement';
    $('ev-id').value = ev?.id || '';
    $('ev-titre').value = ev?.titre || '';
    $('ev-an').value = ev && ev.an != null ? ev.an : '';
    $('ev-anfin').value = ev && ev.anFin != null ? ev.anFin : '';
    $('ev-ere').value = ev?.ere || '';
    const cle = ev?.categorie || 'fondation';
    if (ev && !CATS[cle]) { catSel.value = '__autre'; catLibre.value = cle; } else { catSel.value = cle; catLibre.value = ''; }
    majCatLibre();
    $('ev-statut').value = ev?.statut || 'atteste';
    $('ev-couleur').value = ev?.couleur || catDe(cle).couleur;
    $('ev-resume').value = ev?.resume || '';
    $('ev-lieu').value = ev?.lieu || '';
    $('ev-acteurs').value = ev?.acteurs || '';
    $('ev-consequence').value = ev?.consequence || '';
    $('ev-cit-texte').value = ev?.citation?.texte || '';
    $('ev-cit-source').value = ev?.citation?.source || '';
    $('ev-tags').value = (ev?.tags || []).join(', ');
    $('ev-lien').value = ev?.lien || '';
    $('ev-image').value = ev?.image || '';
    $('ev-etat').textContent = '';
    $('ev-supprimer').hidden = !ev;
    modale.hidden = false;
    $('ev-titre').focus();
  }

  $('nouvel-evenement').addEventListener('click', () => ouvrirEditeur(null));

  $('ev-enregistrer').addEventListener('click', async () => {
    const etat = $('ev-etat');
    const titre = $('ev-titre').value.trim();
    if (!titre) return (etat.textContent = 'Donne un titre.');
    if ($('ev-an').value === '') return (etat.textContent = 'Donne une année.');
    const categorie = catSel.value === '__autre' ? catLibre.value.trim() : catSel.value;
    etat.textContent = 'Enregistrement…';
    const chroniques = await envoyer({
      action: 'evenement', id: $('ev-id').value || undefined, chronique: meta.slug, titre,
      an: $('ev-an').value, anFin: $('ev-anfin').value, ere: $('ev-ere').value,
      categorie, statut: $('ev-statut').value, couleur: $('ev-couleur').value,
      resume: $('ev-resume').value, lieu: $('ev-lieu').value, acteurs: $('ev-acteurs').value,
      consequence: $('ev-consequence').value,
      citation: { texte: $('ev-cit-texte').value, source: $('ev-cit-source').value },
      tags: $('ev-tags').value, lien: $('ev-lien').value, image: $('ev-image').value,
    }, etat);
    if (chroniques) location.reload();
  });

  $('ev-supprimer').addEventListener('click', async () => {
    const id = $('ev-id').value; if (!id) return;
    if (!confirm('Supprimer cet événement et sa page ?')) return;
    const chroniques = await envoyer({ action: 'supprimer-evenement', id }, $('ev-etat'));
    if (chroniques) location.reload();
  });

  /* ===================== propriétés de la chronique ===================== */
  const props = $('modale-props');
  $('ouvrir-props').addEventListener('click', () => (props.hidden = false));
  for (const b of props.querySelectorAll('[data-fermer]')) b.addEventListener('click', () => (props.hidden = true));

  $('pc-enregistrer').addEventListener('click', async () => {
    $('pc-etat').textContent = 'Enregistrement…';
    const chroniques = await envoyer({ action: 'chronique', slug: meta.slug, titre: $('pc-titre').value, couleur: $('pc-couleur').value, image: $('pc-image').value, intro: $('pc-intro').value }, $('pc-etat'));
    if (chroniques) location.reload();
  });
  const suppr = $('pc-supprimer');
  if (suppr) suppr.addEventListener('click', async () => {
    if (!confirm('Supprimer cette chronique et tous ses événements ?')) return;
    const chroniques = await envoyer({ action: 'supprimer-chronique', slug: meta.slug }, $('pc-etat'));
    if (chroniques) location.href = '/chronologie';
  });
</script>
