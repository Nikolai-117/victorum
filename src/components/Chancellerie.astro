---
/**
 * La chancellerie d'une nation : son régime, ses doctrines, sa cour.
 *
 * Chaque axe oppose deux doctrines et se règle sur cinq crans — le cran
 * extrême vaut position fanatique, le cran central « ni l'un ni l'autre ».
 * Choisir un pôle exclut donc l'autre, ce qui évite les nations qui seraient
 * à la fois belliqueuses et pacifiques.
 *
 * Le régime se déduit des doctrines au fil des clics ; Romain peut toujours
 * le contredire d'un choix, ou saisir une forme que la liste n'a pas prévue.
 */
import { AXES, REGIMES, TOUS_REGIMES } from '../lib/doctrines';
import type { Nation } from '../lib/politique';

interface Props {
  titre: string;
  entite: string;
  nation: Nation;
  formeAzgaar: string | null;
  stockageActif: boolean;
  motDePasseDefini: boolean;
}

const { titre, entite, nation, formeAzgaar, stockageActif, motDePasseDefini } = Astro.props;

const CRANS = [
  { valeur: -2, signe: '««', aide: 'Fanatique' },
  { valeur: -1, signe: '«', aide: 'Marqué' },
  { valeur: 0, signe: '—', aide: 'Ni l’un ni l’autre' },
  { valeur: 1, signe: '»', aide: 'Marqué' },
  { valeur: 2, signe: '»»', aide: 'Fanatique' },
];

const regimeConnu = nation.regime && TOUS_REGIMES.includes(nation.regime);
---

<div class="chancellerie">
  <button class="bouton bouton--or" id="ouvrir-chancellerie" type="button">
    Régime et doctrines…
  </button>
</div>

<div class="modale" id="modale-nation" hidden>
  <div class="modale__voile" data-fermer></div>

  <div class="modale__boite" role="dialog" aria-label={`Doctrines de ${titre}`}>
    <header class="modale__tete">
      <h2>Doctrines — {titre}</h2>
      <button class="fermer" type="button" data-fermer aria-label="Fermer">×</button>
    </header>

    <p class="modale__aide">
      Chaque axe oppose deux doctrines : choisir un pôle exclut l'autre. Le second
      cran marque une position fanatique.
    </p>

    <div class="axes">
      {
        AXES.map((axe) => (
          <div class="axe-ligne" data-axe={axe.id} data-teinte-gauche={axe.teinteGauche} data-teinte-droite={axe.teinteDroite}>
            <span class="axe-ligne__pole axe-ligne__pole--gauche">{axe.gauche}</span>
            <div class="crans" role="group" aria-label={axe.sujet}>
              {CRANS.map((cran) => (
                <button type="button" data-valeur={cran.valeur} title={cran.aide}>
                  {cran.signe}
                </button>
              ))}
            </div>
            <span class="axe-ligne__pole axe-ligne__pole--droite">{axe.droite}</span>
          </div>
        ))
      }
    </div>

    <div class="modale__cour">
      <label class="champ"><span>Devise</span>
        <input id="nation-devise" type="text" maxlength="160" value={nation.devise ?? ''} />
      </label>
      <label class="champ"><span>Titre</span>
        <input id="nation-titre" type="text" maxlength="60" value={nation.titreDirigeant ?? ''} placeholder="Roi, Doge, Prince-évêque…" />
      </label>
      <label class="champ"><span>Dirigeant</span>
        <input id="nation-dirigeant" type="text" maxlength="80" value={nation.dirigeant ?? ''} />
      </label>
      <label class="champ"><span>Avènement</span>
        <input id="nation-avenement" type="number" step="1" value={nation.avenement ?? ''} />
      </label>
    </div>

    <div class="modale__champs">
      <p class="etiquette">Particularités</p>
      <p class="modale__champs-aide">Ce que rien n'a prévu : berceau, dynastie, langue de cour… un libellé, une valeur.</p>
      <div class="champs-libres" id="champs-libres"></div>
      <button class="bouton" id="ajouter-champ" type="button">+ Ajouter une particularité</button>
    </div>

    <footer class="modale__pied">
      <div class="modale__resultat">
        <p class="etiquette">Type de gouvernement</p>
        <p class="modale__regime" id="apercu-regime"></p>
        <p class="modale__raison" id="apercu-raison"></p>
        <ul class="doctrines" id="apercu-doctrines"></ul>
      </div>

      <div class="modale__reglages">
        <label class="champ"><span>Forme</span>
          <select id="nation-regime" class="select">
            <option value="">— déduite des doctrines —</option>
            {
              REGIMES.map((famille) => (
                <optgroup label={famille.famille}>
                  {famille.formes.map((forme) => (
                    <option value={forme} selected={regimeConnu && nation.regime === forme}>
                      {forme}
                    </option>
                  ))}
                </optgroup>
              ))
            }
            <option value="__autre" selected={Boolean(nation.regime) && !regimeConnu}>
              — autre (à saisir)…
            </option>
          </select>
        </label>
        <input
          id="nation-regime-libre"
          type="text"
          maxlength="60"
          placeholder="Forme de votre cru"
          value={regimeConnu ? '' : nation.regime ?? ''}
          hidden={Boolean(regimeConnu) || !nation.regime}
        />
        <button class="bouton bouton--plein" id="enregistrer-nation" type="button">Terminer</button>
        <p class="modale__etat" id="etat-nation"></p>
      </div>
    </footer>
  </div>
</div>

<script
  type="application/json"
  id="donnees-nation"
  set:html={JSON.stringify({ entite, nation, formeAzgaar, stockageActif, motDePasseDefini })}
/>

<style is:global>
  .chancellerie {
    margin: 0 0 1.5rem;
  }

  /* ------------------------------------------------------------- modale */

  .modale {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 1.5rem;
  }
  .modale[hidden] {
    display: none;
  }
  .modale__voile {
    position: absolute;
    inset: 0;
    background: rgba(8, 6, 5, 0.72);
    backdrop-filter: blur(3px);
  }
  .modale__boite {
    position: relative;
    width: min(920px, 100%);
    max-height: min(86svh, 900px);
    display: flex;
    flex-direction: column;
    background: var(--verre);
    backdrop-filter: var(--flou);
    border: 1px solid var(--trait-vif);
    border-radius: var(--rayon);
    box-shadow: var(--ombre);
    overflow: hidden;
  }
  .modale__tete {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.4rem 0.9rem;
  }
  .modale__tete h2 {
    font-size: 1.5rem;
  }
  .modale__tete .fermer {
    position: static;
    margin-left: auto;
  }
  .modale__aide {
    margin: 0 1.4rem 0.9rem;
    font-family: var(--chrome);
    font-size: 0.6875rem;
    color: var(--parchemin-faible);
  }

  .axes {
    overflow-y: auto;
    padding: 0 1.4rem;
    border-top: 1px solid var(--trait);
    border-bottom: 1px solid var(--trait);
  }

  /** Une ligne : un pôle, cinq crans, l'autre pôle. */
  .axe-ligne {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 0.6rem;
    border-radius: var(--rayon-s);
  }
  .axe-ligne:nth-child(odd) {
    background: rgba(70, 62, 58, 0.03);
  }
  .axe-ligne__pole {
    font-size: 1.0625rem;
    color: var(--parchemin-faible);
    transition: color 0.15s;
  }
  .axe-ligne__pole--gauche {
    text-align: right;
  }
  /** Le pôle tenu se détache ; l'autre s'efface, puisqu'il est exclu. */
  .axe-ligne[data-choix='gauche'] .axe-ligne__pole--gauche,
  .axe-ligne[data-choix='droite'] .axe-ligne__pole--droite {
    color: var(--parchemin);
  }
  .axe-ligne__pole small {
    display: block;
    font-family: var(--chrome);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teinte, var(--or));
  }

  .crans {
    display: flex;
    gap: 2px;
  }
  .crans button {
    width: 38px;
    height: 30px;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-xs);
    background: var(--saisie);
    color: var(--parchemin-faible);
    font-family: var(--chrome);
    font-size: 0.75rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .crans button:hover {
    color: var(--parchemin);
    border-color: var(--trait-vif);
  }
  .crans button[aria-pressed='true'] {
    border-color: var(--teinte, var(--or));
    background: color-mix(in srgb, var(--teinte, var(--or)) 22%, transparent);
    color: color-mix(in srgb, var(--teinte, var(--or)) 55%, #464646);
  }

  .modale__cour {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
    padding: 1rem 1.4rem;
  }

  .modale__pied {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
    padding: 1.1rem 1.4rem 1.3rem;
    border-top: 1px solid var(--trait);
    flex-wrap: wrap;
  }
  .modale__resultat {
    flex: 1;
    min-width: 16rem;
  }
  .modale__regime {
    font-family: var(--display);
    font-size: 1.6rem;
    margin: 0.25rem 0 0;
  }
  .modale__raison {
    margin: 0.15rem 0 0;
    font-family: var(--chrome);
    font-size: 0.6875rem;
    color: var(--parchemin-faible);
  }
  .modale__reglages {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 15rem;
  }
  .modale__etat {
    margin: 0;
    font-family: var(--chrome);
    font-size: 0.6875rem;
    color: var(--parchemin-faible);
    min-height: 1em;
  }
  .modale__reglages input[type='text'] {
    padding: 0.5rem 0.7rem;
    background: var(--saisie);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-s);
    color: var(--parchemin);
    font-family: var(--texte-police);
    font-size: 1.0625rem;
  }

  .modale__champs {
    padding: 0 1.4rem 0.4rem;
  }
  .modale__champs .etiquette {
    color: var(--or);
  }
  .modale__champs-aide {
    margin: 0.3rem 0 0.7rem;
    font-family: var(--chrome);
    font-size: 0.6875rem;
    color: var(--parchemin-faible);
  }
  .champs-libres {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }
  .champ-libre {
    display: grid;
    grid-template-columns: minmax(7rem, 1fr) minmax(0, 2fr) auto;
    gap: 0.5rem;
    align-items: center;
  }
  .champ-libre input {
    padding: 0.45rem 0.65rem;
    background: var(--saisie);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-s);
    color: var(--parchemin);
    font-family: var(--texte-police);
    font-size: 1rem;
  }
  .champ-libre input:first-child {
    font-family: var(--chrome);
    font-size: 0.8125rem;
  }
  .champ-libre button {
    width: 32px;
    height: 32px;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-s);
    background: none;
    color: var(--parchemin-faible);
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
  }
  .champ-libre button:hover {
    color: var(--sang);
    border-color: var(--sang);
  }

  @media (max-width: 720px) {
    .axe-ligne {
      grid-template-columns: 1fr;
      gap: 0.3rem;
      text-align: center;
    }
    .axe-ligne__pole--gauche {
      text-align: center;
    }
    .crans {
      justify-content: center;
    }
  }
</style>

<script>
  import { AXES, regimeDeduit, doctrinesRetenues } from '../lib/doctrines';

  const donnees = JSON.parse(document.getElementById('donnees-nation').textContent);
  const CLE_MDP = 'victorum:mot-de-passe';

  const $ = (id) => document.getElementById(id);
  const modale = $('modale-nation');
  const doctrines = { ...(donnees.nation.doctrines || {}) };

  /* --------------------------------------------------- particularités */

  const champsHote = $('champs-libres');

  /** Une ligne : un libellé, une valeur, un bouton pour la retirer. */
  function ligneChamp(cle = '', valeur = '') {
    const ligne = document.createElement('div');
    ligne.className = 'champ-libre';
    const iCle = document.createElement('input');
    iCle.type = 'text';
    iCle.maxLength = 40;
    iCle.placeholder = 'Berceau, Dynastie…';
    iCle.value = cle;
    const iVal = document.createElement('input');
    iVal.type = 'text';
    iVal.maxLength = 240;
    iVal.placeholder = 'Valeur';
    iVal.value = valeur;
    const retirer = document.createElement('button');
    retirer.type = 'button';
    retirer.textContent = '×';
    retirer.setAttribute('aria-label', 'Retirer');
    retirer.addEventListener('click', () => ligne.remove());
    ligne.append(iCle, iVal, retirer);
    return ligne;
  }

  for (const c of donnees.nation.champs || []) champsHote.appendChild(ligneChamp(c.cle, c.valeur));
  $('ajouter-champ').addEventListener('click', () => {
    const ligne = ligneChamp();
    champsHote.appendChild(ligne);
    ligne.querySelector('input').focus();
  });

  /** Ce que valent les particularités au moment de l'envoi. */
  const champsSaisis = () =>
    [...champsHote.querySelectorAll('.champ-libre')]
      .map((l) => {
        const [cle, valeur] = l.querySelectorAll('input');
        return { cle: cle.value.trim(), valeur: valeur.value.trim() };
      })
      .filter((c) => c.cle && c.valeur);

  $('ouvrir-chancellerie').addEventListener('click', () => {
    modale.hidden = false;
  });
  for (const bouton of modale.querySelectorAll('[data-fermer]')) {
    bouton.addEventListener('click', () => (modale.hidden = true));
  }
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && !modale.hidden) modale.hidden = true;
  });

  /* ------------------------------------------------------------- les crans */

  for (const ligne of modale.querySelectorAll('.axe-ligne')) {
    const axeId = ligne.dataset.axe;
    for (const bouton of ligne.querySelectorAll('.crans button')) {
      bouton.addEventListener('click', () => {
        const valeur = Number(bouton.dataset.valeur);
        // Recliquer le cran déjà tenu revient à ne plus rien professer.
        doctrines[axeId] = doctrines[axeId] === valeur ? 0 : valeur;
        rendre();
      });
    }
  }

  function rendre() {
    for (const ligne of modale.querySelectorAll('.axe-ligne')) {
      const axeId = ligne.dataset.axe;
      const valeur = Number(doctrines[axeId] ?? 0);
      const teinte = valeur < 0 ? ligne.dataset.teinteGauche : ligne.dataset.teinteDroite;
      ligne.style.setProperty('--teinte', teinte);
      ligne.dataset.choix = valeur === 0 ? '' : valeur < 0 ? 'gauche' : 'droite';

      for (const bouton of ligne.querySelectorAll('.crans button')) {
        bouton.setAttribute('aria-pressed', String(Number(bouton.dataset.valeur) === valeur));
      }

      // La mention « fanatique » s'écrit sous le pôle tenu, pas ailleurs.
      for (const pole of ligne.querySelectorAll('.axe-ligne__pole')) {
        pole.querySelector('small')?.remove();
      }
      if (Math.abs(valeur) >= 2) {
        const pole = ligne.querySelector(
          valeur < 0 ? '.axe-ligne__pole--gauche' : '.axe-ligne__pole--droite'
        );
        const mention = document.createElement('small');
        mention.textContent = 'fanatique';
        pole.appendChild(mention);
      }
    }
    majApercu();
  }

  /* ------------------------------------------------------------- l'aperçu */

  function majApercu() {
    const choisi = regimeChoisi();
    const deduit = regimeDeduit(doctrines, donnees.formeAzgaar);
    $('apercu-regime').textContent = choisi || deduit.nom;
    $('apercu-raison').textContent = choisi ? 'choisi' : deduit.raison;

    const liste = $('apercu-doctrines');
    liste.innerHTML = '';
    for (const d of doctrinesRetenues(doctrines)) {
      const li = document.createElement('li');
      li.className = 'doctrine' + (d.fanatique ? ' doctrine--fanatique' : '');
      li.style.setProperty('--teinte', d.teinte);
      const nom = document.createElement('span');
      nom.textContent = d.nom;
      li.appendChild(nom);
      if (d.fanatique) {
        const mention = document.createElement('small');
        mention.textContent = 'fanatique';
        li.appendChild(mention);
      }
      liste.appendChild(li);
    }
  }

  function regimeChoisi() {
    const choix = $('nation-regime').value;
    if (choix === '__autre') return $('nation-regime-libre').value.trim();
    return choix;
  }

  $('nation-regime').addEventListener('change', () => {
    const autre = $('nation-regime').value === '__autre';
    $('nation-regime-libre').hidden = !autre;
    if (autre) $('nation-regime-libre').focus();
    majApercu();
  });
  $('nation-regime-libre').addEventListener('input', majApercu);

  /* ----------------------------------------------------------- écriture */

  function motDePasse(redemander) {
    let mdp = sessionStorage.getItem(CLE_MDP);
    if (!mdp || redemander) {
      mdp = prompt(
        donnees.motDePasseDefini
          ? "Mot de passe de l'atelier :"
          : "Choisis le mot de passe de ton atelier. Il te sera demandé pour toute modification, et personne d'autre ne pourra écrire sur ton site."
      );
      if (mdp) sessionStorage.setItem(CLE_MDP, mdp);
    }
    return mdp;
  }

  $('enregistrer-nation').addEventListener('click', async () => {
    const etat = $('etat-nation');
    if (!donnees.stockageActif) {
      etat.textContent = "Le stockage n'est pas relié : impossible d'enregistrer.";
      return;
    }
    const mdp = motDePasse(false);
    if (!mdp) {
      etat.textContent = 'Mot de passe non saisi.';
      return;
    }

    const avenement = $('nation-avenement').value;
    etat.textContent = 'Enregistrement…';
    try {
      const reponse = await fetch('/api/politique', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-mot-de-passe': mdp },
        body: JSON.stringify({
          action: 'nation',
          entite: donnees.entite,
          regime: regimeChoisi(),
          doctrines,
          devise: $('nation-devise').value,
          dirigeant: $('nation-dirigeant').value,
          titreDirigeant: $('nation-titre').value,
          avenement: avenement === '' ? null : Number(avenement),
          champs: champsSaisis(),
        }),
      });
      const resultat = await reponse.json().catch(() => ({}));
      if (reponse.status === 401) {
        sessionStorage.removeItem(CLE_MDP);
        etat.textContent = resultat.erreur || 'Mot de passe refusé.';
        return;
      }
      if (!reponse.ok) {
        etat.textContent = resultat.erreur || 'Échec de l’enregistrement.';
        return;
      }
      // La fiche est rendue par le serveur : on la laisse se refaire.
      location.reload();
    } catch {
      etat.textContent = 'Réseau indisponible.';
    }
  });

  rendre();
</script>
