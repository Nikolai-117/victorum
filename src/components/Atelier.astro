---
/**
 * L'atelier : composer la fiche et y écrire, sans jamais quitter le site.
 *
 * Il recompose la page avec exactement le même moteur que celui utilisé côté
 * serveur (`src/lib/blocs.js`) : ce que Romain voit en composant est
 * littéralement ce qui sera servi.
 *
 * Tout enregistrement part vers le site. Le navigateur ne sert que de filet :
 * une copie locale est gardée en permanence pour qu'une coupure réseau ou un
 * onglet fermé ne fasse jamais perdre une phrase.
 */
import { CATALOGUE } from '../lib/blocs.js';

interface Props {
  contexte: unknown;
  blocs: unknown[];
  section: string;
  slug: string;
  texte: string;
  stockageActif: boolean;
}

const { contexte, blocs, section, slug, texte, stockageActif } = Astro.props;
---

<div class="atelier-barre contenant" id="atelier-barre" role="toolbar" aria-label="Mise en page">
  <span class="atelier-barre__titre">Atelier</span>
  <span class="atelier-etat" id="atelier-etat"></span>
  <button class="bouton" type="button" data-atelier="texte">Écrire</button>
  <button class="bouton" type="button" data-atelier="ajouter">+ Bloc</button>
  <button class="bouton" type="button" data-atelier="modeles">Modèles</button>
  <button class="bouton" type="button" data-atelier="reinitialiser">Réinitialiser</button>
  <button class="bouton bouton--or" type="button" data-atelier="terminer">Terminer</button>
</div>

<div class="atelier-texte" id="atelier-texte" hidden>
  <div class="atelier-texte__tete">
    <p class="etiquette">Texte de la fiche</p>
    <span class="atelier-texte__compte" id="atelier-compte"></span>
    <button class="bouton" type="button" data-atelier="fermer-texte">Replier</button>
  </div>
  <textarea
    id="atelier-redaction"
    spellcheck="true"
    placeholder="Écris ici. Une ligne vide sépare deux paragraphes. ## pour un titre, - pour une liste, **gras**, *italique*, > pour une citation."
  >{texte}</textarea>
</div>

<button class="bouton atelier-ouvrir" type="button" id="atelier-ouvrir">Mettre en page</button>

<div class="atelier-fenetre" id="atelier-fenetre" role="dialog" aria-modal="true" aria-labelledby="atelier-fenetre-titre">
  <div class="atelier-fenetre__boite">
    <div class="atelier-fenetre__tete">
      <h2 id="atelier-fenetre-titre">Ajouter une section</h2>
      <button class="bouton" type="button" data-atelier="fermer-fenetre">Fermer</button>
    </div>
    <div class="atelier-fenetre__corps">
      <div class="atelier-familles" id="atelier-familles" role="tablist"></div>
      <div class="atelier-choix" id="atelier-choix"></div>
    </div>
    <p class="atelier-fenetre__pied" id="atelier-fenetre-pied">
      La section s'ajoute à la fin, puis se déplace par la poignée ⣿ ou les flèches.
    </p>
  </div>
</div>

<script type="application/json" id="atelier-contexte" set:html={JSON.stringify(contexte)}></script>
<script type="application/json" id="atelier-blocs" set:html={JSON.stringify(blocs)}></script>
<script type="application/json" id="atelier-catalogue" set:html={JSON.stringify(CATALOGUE)}></script>
<script
  type="application/json"
  id="atelier-page"
  set:html={JSON.stringify({ section, slug, stockageActif })}
></script>

<script>
  import { rendrePage, nouveauBloc, LARGEURS, modeles, BLOCS_CONNUS, markdownCourt } from '../lib/blocs.js';

  const lire = (id) => JSON.parse(document.getElementById(id).textContent);
  const fiche = document.getElementById('fiche');
  if (fiche) demarrer();

  function demarrer() {
    const contexte = lire('atelier-contexte');
    const catalogue = lire('atelier-catalogue');
    const page = lire('atelier-page');
    const servi = lire('atelier-blocs');

    const CLE_LOCALE = `victorum:page:${page.section}/${page.slug}`;
    const CLE_MDP = 'victorum:mot-de-passe';
    const redaction = document.getElementById('atelier-redaction');
    const etatBarre = document.getElementById('atelier-etat');

    let blocs = structuredClone(servi);
    let texte = redaction.value;
    let ouvert = null; // index du bloc dont les réglages sont dépliés
    let etat = 'synchro'; // synchro | attente | envoi | echec | local

    /* ------------------------------------------------------- reprise locale */

    /**
     * Le filet de sécurité. Si une sauvegarde n'était pas partie la dernière
     * fois — réseau coupé, onglet fermé trop vite — on la retrouve ici et on
     * la renvoie plutôt que de la perdre en silence.
     */
    (function reprendre() {
      try {
        const brut = localStorage.getItem(CLE_LOCALE);
        if (!brut) return;
        const local = JSON.parse(brut);
        if (!local?.enAttente) return;
        if (Array.isArray(local.blocs)) blocs = local.blocs;
        if (typeof local.texte === 'string') {
          texte = local.texte;
          redaction.value = texte;
        }
        etat = 'attente';
        dessiner();
        planifierEnvoi(0);
      } catch {}
    })();

    /* --------------------------------------------------------- enregistrement */

    const memoriserLocalement = (enAttente) => {
      try {
        localStorage.setItem(CLE_LOCALE, JSON.stringify({ blocs, texte, enAttente }));
      } catch {}
    };

    let minuteur;
    /** Deux secondes après la dernière frappe : assez pour ne pas saturer le stockage. */
    function planifierEnvoi(delai = 2000) {
      memoriserLocalement(true);
      etat = 'attente';
      majEtat();
      clearTimeout(minuteur);
      minuteur = setTimeout(envoyer, delai);
    }

    function motDePasse(redemander) {
      let mdp = sessionStorage.getItem(CLE_MDP);
      if (!mdp || redemander) {
        mdp = prompt("Mot de passe de l'atelier :");
        if (mdp) sessionStorage.setItem(CLE_MDP, mdp);
      }
      return mdp;
    }

    async function envoyer(redemander = false) {
      if (!page.stockageActif) {
        etat = 'local';
        memoriserLocalement(true);
        majEtat();
        return;
      }

      const mdp = motDePasse(redemander);
      if (!mdp) {
        etat = 'echec';
        majEtat('Mot de passe non saisi.');
        return;
      }

      etat = 'envoi';
      majEtat();
      try {
        const reponse = await fetch('/api/page', {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-mot-de-passe': mdp },
          body: JSON.stringify({ section: page.section, slug: page.slug, blocs, texte }),
        });
        const donnees = await reponse.json().catch(() => ({}));

        if (reponse.status === 401) {
          sessionStorage.removeItem(CLE_MDP);
          etat = 'echec';
          majEtat(donnees.erreur || 'Mot de passe refusé.');
          return;
        }
        if (!reponse.ok) {
          etat = reponse.status === 503 ? 'local' : 'echec';
          majEtat(donnees.erreur);
          return;
        }

        memoriserLocalement(false);
        etat = 'synchro';
        majEtat();
      } catch (erreur) {
        etat = 'echec';
        majEtat('Réseau indisponible — le brouillon est gardé dans ce navigateur.');
      }
    }

    function majEtat(detail) {
      const messages = {
        synchro: `${blocs.length} blocs · enregistré sur le site`,
        attente: 'Modifications en attente…',
        envoi: 'Enregistrement…',
        echec: detail || 'Échec de l’enregistrement',
        local: detail || 'Stockage non relié — brouillon gardé dans ce navigateur',
      };
      etatBarre.dataset.etat = etat;
      etatBarre.textContent = messages[etat];
      etatBarre.title = detail || '';
    }

    /* ------------------------------------------------------------- rendu */

    function dessiner() {
      const contexteRendu = { ...contexte, corpsHtml: texte.trim() ? markdownCourt(texte) : contexte.corpsHtml };
      fiche.innerHTML = rendrePage(blocs, contexteRendu);
      if (document.body.classList.contains('en-edition')) habiller();
      majEtat();
    }

    /** Ajoute la barre d'outils et les réglages au-dessus de chaque bloc. */
    function habiller() {
      fiche.querySelectorAll('.bloc').forEach((section, index) => {
        const bloc = blocs[index];
        const modele = BLOCS_CONNUS.get(bloc.type);

        const barre = document.createElement('div');
        barre.className = 'bloc__barre';
        barre.innerHTML =
          `<span class="bloc__nom" draggable="true">${modele?.nom || bloc.type}</span>` +
          `<select class="bloc__largeur" aria-label="Largeur">` +
          LARGEURS.map(
            (l) => `<option value="${l.valeur}"${l.valeur === bloc.largeur ? ' selected' : ''}>${l.libelle}</option>`
          ).join('') +
          `</select>` +
          `<button class="bloc__action" data-agir="haut" title="Monter">↑</button>` +
          `<button class="bloc__action" data-agir="bas" title="Descendre">↓</button>` +
          `<button class="bloc__action" data-agir="reglages" title="Réglages">⚙</button>` +
          `<button class="bloc__action" data-agir="dupliquer" title="Dupliquer">⧉</button>` +
          `<button class="bloc__action bloc__action--danger" data-agir="supprimer" title="Supprimer">✕</button>`;
        section.prepend(barre);

        if (ouvert === index) {
          section.classList.add('bloc--ouvert');
          section.append(reglagesDe(bloc, index));
        }
      });
    }

    /* --------------------------------------------------------- réglages */

    const CHAMPS = {
      bandeau: [
        { cle: 'titre', libelle: 'Titre', gabarit: 'input', substitut: contexte.titre },
        { cle: 'sousTitre', libelle: 'Surtitre', gabarit: 'input', substitut: contexte.surtitre },
        { cle: 'accroche', libelle: 'Accroche', gabarit: 'textarea' },
      ],
      titre: [{ cle: 'texte', libelle: 'Titre de la section', gabarit: 'input' }],
      chapeau: [{ cle: 'texte', libelle: 'Accroche', gabarit: 'textarea' }],
      citation: [
        { cle: 'texte', libelle: 'Citation', gabarit: 'textarea' },
        { cle: 'source', libelle: 'Source', gabarit: 'input' },
      ],
      note: [{ cle: 'md', libelle: 'Texte (gras **ainsi**, listes avec -)', gabarit: 'textarea' }],
      identite: [{ cle: 'titre', libelle: 'Intitulé', gabarit: 'input', substitut: "Fiche d'identité" }],
      blason: [{ cle: 'legende', libelle: 'Légende', gabarit: 'input', substitut: 'Armes' }],
      liens: [
        { cle: 'groupe', libelle: 'Contenu', gabarit: 'groupe' },
        { cle: 'limite', libelle: 'Nombre maximum', gabarit: 'nombre' },
      ],
      tableau: [
        { cle: 'groupe', libelle: 'Contenu', gabarit: 'groupe' },
        { cle: 'limite', libelle: 'Nombre maximum', gabarit: 'nombre' },
      ],
      jauge: [
        { cle: 'groupe', libelle: 'Contenu', gabarit: 'groupe' },
        { cle: 'limite', libelle: 'Nombre maximum', gabarit: 'nombre' },
      ],
      carte: [{ cle: 'zoom', libelle: 'Agrandissement', gabarit: 'nombre' }],
      image: [
        { cle: 'src', libelle: 'Chemin (dépose le fichier dans public/illustrations/)', gabarit: 'input' },
        { cle: 'alt', libelle: 'Description pour les lecteurs d’écran', gabarit: 'input' },
        { cle: 'legende', libelle: 'Légende', gabarit: 'input' },
      ],
      separateur: [{ cle: 'motif', libelle: 'Motif', gabarit: 'input' }],
      espace: [{ cle: 'hauteur', libelle: 'Hauteur (en rem)', gabarit: 'nombre' }],
      texte: [],
      chiffres: [],
    };

    function reglagesDe(bloc, index) {
      const boite = document.createElement('div');
      boite.className = 'bloc__reglages';
      const champs = CHAMPS[bloc.type] || [];

      if (bloc.type === 'texte') {
        const p = document.createElement('p');
        p.className = 'discret';
        p.style.margin = '0';
        p.textContent = 'Ce bloc affiche le texte de la fiche. Le bouton « Écrire » de la barre l’ouvre.';
        boite.appendChild(p);
        return boite;
      }
      if (!champs.length) {
        boite.innerHTML = `<p class="discret" style="margin:0">Ce bloc se remplit tout seul à partir des faits de la carte.</p>`;
        return boite;
      }

      for (const champ of champs) {
        const etiquette = document.createElement('label');
        const valeur = bloc.options?.[champ.cle] ?? '';
        let controle;

        if (champ.gabarit === 'textarea') {
          controle = document.createElement('textarea');
          controle.value = valeur;
        } else if (champ.gabarit === 'groupe') {
          controle = document.createElement('select');
          for (const [cle, groupe] of Object.entries(contexte.groupes || {})) {
            const option = document.createElement('option');
            option.value = cle;
            option.textContent = groupe.titre;
            if (cle === valeur) option.selected = true;
            controle.appendChild(option);
          }
        } else {
          controle = document.createElement('input');
          controle.type = champ.gabarit === 'nombre' ? 'number' : 'text';
          controle.value = valeur;
          if (champ.substitut) controle.placeholder = champ.substitut;
        }

        controle.addEventListener('change', () => {
          bloc.options = bloc.options || {};
          const v = controle.value;
          if (v === '') delete bloc.options[champ.cle];
          else bloc.options[champ.cle] = champ.gabarit === 'nombre' ? Number(v) : v;
          planifierEnvoi();
          dessiner();
        });

        etiquette.append(document.createTextNode(champ.libelle), controle);
        boite.appendChild(etiquette);
      }
      return boite;
    }

    /* ------------------------------------------------------------ écriture */

    const panneauTexte = document.getElementById('atelier-texte');
    const compte = document.getElementById('atelier-compte');

    let minuteurRendu;
    redaction.addEventListener('input', () => {
      texte = redaction.value;
      majCompte();
      planifierEnvoi();
      // Le rendu suit la frappe d'un peu loin : recomposer à chaque touche
      // ferait sauter la page sous les yeux.
      clearTimeout(minuteurRendu);
      minuteurRendu = setTimeout(dessiner, 400);
    });

    function majCompte() {
      const mots = texte.trim() ? texte.trim().split(/\s+/).length : 0;
      compte.textContent = `${mots} mot${mots > 1 ? 's' : ''}`;
    }

    function basculerTexte(afficher) {
      panneauTexte.hidden = !afficher;
      if (afficher) {
        majCompte();
        redaction.focus();
      }
    }

    /* ---------------------------------------------------------- actions */

    fiche.addEventListener('click', (ev) => {
      const bouton = ev.target.closest('[data-agir]');
      if (!bouton) return;
      const index = Number(bouton.closest('.bloc').dataset.bloc);
      const action = bouton.dataset.agir;

      if (action === 'haut' && index > 0) {
        [blocs[index - 1], blocs[index]] = [blocs[index], blocs[index - 1]];
        ouvert = null;
      } else if (action === 'bas' && index < blocs.length - 1) {
        [blocs[index + 1], blocs[index]] = [blocs[index], blocs[index + 1]];
        ouvert = null;
      } else if (action === 'dupliquer') {
        blocs.splice(index + 1, 0, structuredClone(blocs[index]));
        ouvert = null;
      } else if (action === 'supprimer') {
        blocs.splice(index, 1);
        ouvert = null;
      } else if (action === 'reglages') {
        ouvert = ouvert === index ? null : index;
        dessiner();
        return;
      } else {
        return;
      }
      planifierEnvoi();
      dessiner();
    });

    fiche.addEventListener('change', (ev) => {
      const select = ev.target.closest('.bloc__largeur');
      if (!select) return;
      blocs[Number(select.closest('.bloc').dataset.bloc)].largeur = select.value;
      planifierEnvoi();
      dessiner();
    });

    /* -------------------------------------------------- glisser-déposer */

    let source = null;
    fiche.addEventListener('dragstart', (ev) => {
      const poignee = ev.target.closest('.bloc__nom');
      if (!poignee) return;
      source = Number(poignee.closest('.bloc').dataset.bloc);
      ev.dataTransfer.effectAllowed = 'move';
      ev.dataTransfer.setData('text/plain', String(source));
      poignee.closest('.bloc').classList.add('bloc--glisse');
    });

    fiche.addEventListener('dragover', (ev) => {
      if (source === null) return;
      ev.preventDefault();
      const cible = ev.target.closest('.bloc');
      fiche.querySelectorAll('.bloc--cible').forEach((b) => b.classList.remove('bloc--cible'));
      if (cible) cible.classList.add('bloc--cible');
    });

    fiche.addEventListener('drop', (ev) => {
      if (source === null) return;
      ev.preventDefault();
      const cible = ev.target.closest('.bloc');
      if (cible) {
        const destination = Number(cible.dataset.bloc);
        const [deplace] = blocs.splice(source, 1);
        blocs.splice(destination, 0, deplace);
        ouvert = null;
        planifierEnvoi();
      }
      source = null;
      dessiner();
    });

    fiche.addEventListener('dragend', () => {
      source = null;
      fiche.querySelectorAll('.bloc--glisse, .bloc--cible').forEach((b) =>
        b.classList.remove('bloc--glisse', 'bloc--cible')
      );
    });

    /* ----------------------------------------------------------- fenêtre */

    const fenetre = document.getElementById('atelier-fenetre');
    const familles = document.getElementById('atelier-familles');
    const choix = document.getElementById('atelier-choix');
    const titreFenetre = document.getElementById('atelier-fenetre-titre');
    const piedFenetre = document.getElementById('atelier-fenetre-pied');

    function ouvrirFenetre(mode) {
      familles.innerHTML = '';
      choix.innerHTML = '';

      if (mode === 'modeles') {
        titreFenetre.textContent = 'Modèles de page';
        piedFenetre.textContent = 'Appliquer un modèle remplace la disposition actuelle.';
        for (const modele of modeles(contexte)) {
          const bouton = document.createElement('button');
          bouton.type = 'button';
          bouton.innerHTML = `<strong>${modele.nom}</strong><small>${modele.description}</small>`;
          bouton.addEventListener('click', () => {
            blocs = modele.blocs();
            ouvert = null;
            planifierEnvoi();
            dessiner();
            fermerFenetre();
          });
          choix.appendChild(bouton);
        }
        fenetre.dataset.ouverte = 'oui';
        return;
      }

      titreFenetre.textContent = 'Ajouter une section';
      piedFenetre.textContent = 'La section s’ajoute à la fin, puis se déplace par la poignée ⣿.';

      const montrer = (famille) => {
        choix.innerHTML = '';
        for (const b of famille.blocs) {
          const bouton = document.createElement('button');
          bouton.type = 'button';
          bouton.innerHTML = `<strong>${b.nom}</strong><small>${b.apercu}</small>`;
          bouton.addEventListener('click', () => {
            blocs.push(nouveauBloc(b.type));
            ouvert = blocs.length - 1;
            planifierEnvoi();
            dessiner();
            fermerFenetre();
            fiche.querySelector('.bloc:last-of-type')?.scrollIntoView({ block: 'center' });
          });
          choix.appendChild(bouton);
        }
      };

      catalogue.forEach((famille, i) => {
        const onglet = document.createElement('button');
        onglet.type = 'button';
        onglet.role = 'tab';
        onglet.textContent = famille.famille;
        onglet.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        onglet.addEventListener('click', () => {
          familles.querySelectorAll('button').forEach((b) => b.setAttribute('aria-selected', 'false'));
          onglet.setAttribute('aria-selected', 'true');
          montrer(famille);
        });
        familles.appendChild(onglet);
        if (i === 0) montrer(famille);
      });

      fenetre.dataset.ouverte = 'oui';
    }

    const fermerFenetre = () => (fenetre.dataset.ouverte = 'non');
    fenetre.addEventListener('click', (ev) => {
      if (ev.target === fenetre) fermerFenetre();
    });

    /* ------------------------------------------------------------ barre */

    function basculer(actif) {
      document.body.classList.toggle('en-edition', actif);
      ouvert = null;
      if (!actif) basculerTexte(false);
      dessiner();
    }

    document.getElementById('atelier-ouvrir').addEventListener('click', () => basculer(true));

    document.getElementById('atelier-barre').addEventListener('click', (ev) => {
      const action = ev.target.closest('[data-atelier]')?.dataset.atelier;
      if (action === 'ajouter') ouvrirFenetre('blocs');
      else if (action === 'modeles') ouvrirFenetre('modeles');
      else if (action === 'texte') basculerTexte(panneauTexte.hidden);
      else if (action === 'reinitialiser') reinitialiser();
      else if (action === 'terminer') {
        clearTimeout(minuteur);
        envoyer().finally(() => basculer(false));
      }
    });

    document.addEventListener('click', (ev) => {
      if (ev.target.closest('[data-atelier="fermer-fenetre"]')) fermerFenetre();
      if (ev.target.closest('[data-atelier="fermer-texte"]')) basculerTexte(false);
      // Un échec d'enregistrement se rejoue en cliquant l'état.
      if (ev.target.closest('#atelier-etat') && etat === 'echec') envoyer(true);
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        if (fenetre.dataset.ouverte === 'oui') fermerFenetre();
        else if (document.activeElement === redaction) redaction.blur();
        else if (document.body.classList.contains('en-edition')) basculer(false);
      }
    });

    // Dernière chance : prévenir avant de fermer sur un travail non parti.
    window.addEventListener('beforeunload', (ev) => {
      if (etat === 'attente' || etat === 'envoi') {
        ev.preventDefault();
        ev.returnValue = '';
      }
    });

    function reinitialiser() {
      if (!confirm('Revenir à la disposition d’origine de cette fiche ? Le texte est conservé.')) return;
      blocs = structuredClone(servi);
      ouvert = null;
      planifierEnvoi(0);
      dessiner();
    }

    majEtat();
    majCompte();
  }
</script>
