---
/**
 * Une fiche du wiki : un contexte de faits, une disposition de blocs, et
 * l'atelier qui permet de la recomposer.
 *
 * Trois sources se superposent, de la plus faible à la plus forte : la
 * disposition déduite des faits, ce qui est versionné dans `src/contenu/`,
 * puis ce que Romain a enregistré depuis le site. La fiche est rendue à la
 * demande pour que le dernier enregistrement soit servi immédiatement, sans
 * clignotement ni attente.
 */
import Base from '../layouts/Base.astro';
import Atelier from './Atelier.astro';
import { rendrePage, dispositionParDefaut, markdownCourt } from '../lib/blocs.js';
import { dispositionDe } from '../lib/contenu';
import { lirePage, stockage } from '../lib/stockage';
import { SECTIONS } from '../lib/monde';
import type { Contexte } from '../lib/contexte';

interface Props {
  contexte: Contexte;
}

const { contexte } = Astro.props;
const section = SECTIONS[contexte.type].url;

const enregistre = await lirePage(Astro.locals, section, contexte.slug);

// Le texte écrit depuis le site prend le pas sur le fichier Markdown versionné.
const contexteFinal: Contexte = enregistre?.texte
  ? { ...contexte, corpsHtml: markdownCourt(enregistre.texte) }
  : contexte;

// Une disposition vide n'est jamais voulue : plutôt que de servir une page
// blanche, on retombe sur la disposition d'origine.
const enregistree = enregistre?.blocs as unknown[] | undefined;
const blocs =
  (enregistree?.length ? enregistree : null) ??
  dispositionDe(section, contexte.slug) ??
  dispositionParDefaut(contexte.type, contexteFinal);

const html = rendrePage(blocs, contexteFinal);
---

<Base titre={contexte.titre}>
  <div class="contenant">
    <Atelier
      contexte={contexteFinal}
      blocs={blocs}
      section={section}
      slug={contexte.slug}
      texte={enregistre?.texte ?? ''}
      stockageActif={Boolean(stockage(Astro.locals))}
    />
    <div id="fiche" set:html={html} />
  </div>
</Base>
