---
import '../styles/global.css';
import { monde, SITE } from '../lib/monde';

interface Props {
  titre: string;
  description?: string;
  /** L'atlas occupe tout l'écran : ni marges, ni pied de page. */
  pleinEcran?: boolean;
}

const { titre, description, pleinEcran = false } = Astro.props;
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const actif = (prefixe: string) => (chemin === prefixe || chemin.startsWith(prefixe + '/') ? 'page' : undefined);

// « Royaumes » a quitté le menu : les couronnes sont un rayon du Codex, comme
// le reste du lore. On y accède par /lore, ou par le fil d'Ariane de la page.
const NAV = [
  { url: '/atlas', libelle: 'Atlas' },
  { url: '/lieux', libelle: 'Lieux' },
  { url: '/lore', libelle: 'Codex' },
  { url: '/chronologie', libelle: 'Chronologie' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre === SITE.nom ? SITE.nom : `${titre} — ${SITE.nom}`}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="dark" />
    <!-- Site privé : Romain décide qui le voit en partageant l'adresse.
         Rien ici ne doit apparaître dans un moteur de recherche. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Les deux voix du site, telles que la maquette de l'atelier les fixe :
         Cormorant Garamond pour le monde, Hanken Grotesk pour la lecture,
         IBM Plex Mono pour l'appareil. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    {/* Le monde lui-même, hors du point, derrière chaque page. L'atlas s'en
        passe : la vraie carte l'occupe déjà tout entier, et un flou de cette
        taille se paierait là où le rendu compte le plus. */}
    {!pleinEcran && <div class="atmosphere" aria-hidden="true" />}

    <header class="entete">
      <a class="marque" href="/">{SITE.nom}<span>.</span></a>
      <nav class="nav">
        {NAV.map((l) => <a href={l.url} aria-current={actif(l.url)}>{l.libelle}</a>)}
      </nav>
      <p class="date-monde">an <b>{monde.annee}</b> {monde.ereCourte}</p>
    </header>

    <main class={pleinEcran ? 'corps corps--plein' : 'corps'}>
      <slot />
    </main>

    {
      !pleinEcran && (
        <footer class="pied">
          <div class="contenant pied__interne">
            <div>
              {SITE.nom} — {monde.nom}, an {monde.annee} {monde.ereCourte}. Carte générée avec
              Azgaar's Fantasy Map Generator {monde.versionAzgaar}.
            </div>
            <div>Échelle {monde.echelleKmParPixel} km/px.</div>
          </div>
        </footer>
      )
    }
  </body>
</html>
